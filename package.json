{
  "name": "tech-prep",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@types/bun": "^1.3.0",
      "@types/node": "^26.6.5",
      "typescript": "^7.0.2"
    }
  },
  "type": "module",
  "scripts": {
    "prepare": "[ -n \"$CI\" ] || lefthook install",
    "dev": "bun --filter @tech-prep/desktop dev",
    "build": "bun --filter '*' build",
    "typecheck": "bun --filter '*' typecheck",
    "test": "bun --filter '*' test",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix --deny-warnings",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build"
  },
  "devDependencies": {
    "lefthook": "2.2.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "ultracite": "8.0.1"
  },
  "packageManager": "bun@1.4.2",
  "trustedDependencies": [
    "esbuild"
  ]
}
