{
  "title": "Unpack Number Groups",
  "check": {
    "type": "function",
    "function": {
      "python": "unpack_groups",
      "typescript": "unpackGroups"
    },
    "compare": "exact",
    "stubs": {
      "python": "def unpack_groups(data: list[int]) -> list[list[int]]:\n    pass\n",
      "typescript": "export function unpackGroups(data: number[]): number[][] {\n  throw new Error(\"not implemented\");\n}\n"
    },
    "tests": [
      {"args":[[2,7,8,1,5,3,1,1,1]],"expected":[[7,8],[5],[1,1,1]]},
      {"args":[[0,1,4]],"expected":[[],[4]]},
      {"args":[[]],"expected":[]},
      {"args":[[0]],"expected":[[]]},
      {"args":[[0,0]],"expected":[[],[]]},
      {"args":[[1,0]],"expected":[[0]]},
      {"args":[[3,3,3,3]],"expected":[[3,3,3]]},
      {"args":[[1,2,2,1,1]],"expected":[[2],[1,1]]},
      {"args":[[2,0,0,0,1,9,4,1000,0,2,1]],"expected":[[0,0],[],[9],[1000,0,2,1]]}
    ]
  }
}
