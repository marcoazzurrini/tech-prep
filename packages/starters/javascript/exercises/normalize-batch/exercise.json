{
  "title": "Normalize Batch",
  "check": {
    "type": "function",
    "calls": "script",
    "compare": "exact",
    "stubs": {
      "javascript": "export function normalizeBatch(input, fallback) {\n  // your code\n}\n"
    },
    "tests": [
      {"args":["return normalizeBatch({ 0: 'a', 2: 'c', length: 3 }, '-');"],"expected":["a","-","c"]},
      {"args":["return normalizeBatch([0, null, false, undefined, ''], 'x');"],"expected":[0,"x",false,"x",""]},
      {"args":["return (function () { return normalizeBatch(arguments, 0); })(1, undefined, null, 4);"],"expected":[1,0,0,4]},
      {"args":["return normalizeBatch({ a: 1 }, 'x');"],"expected":[]},
      {"args":["return normalizeBatch({ 0: 'a', 1: 'b', 2: 'c', length: 2 }, 'x');"],"expected":["a","b"]},
      {"args":["return Array.isArray(normalizeBatch({ 0: 1, length: 1 }, 0));"],"expected":true}
    ]
  }
}
