{
  "title": "First Over Budget",
  "check": {
    "type": "function",
    "function": {
      "javascript": "firstOverBudget"
    },
    "compare": "exact",
    "stubs": {
      "javascript": "export function firstOverBudget(items, budget) {\n  let spent = 0;\n\n  items.forEach((item, index) => {\n    spent += item.price;\n\n    if (spent > budget) {\n      return { index, name: item.name };\n    }\n  });\n\n  return null;\n}\n"
    },
    "tests": [
      {"args":[[{"name":"tea","price":3},{"name":"rice","price":4},{"name":"oil","price":5}],6],"expected":{"index":1,"name":"rice"}},
      {"args":[[{"name":"tea","price":3},{"name":"rice","price":4},{"name":"oil","price":5}],100],"expected":null},
      {"args":[[],5],"expected":null},
      {"args":[[{"name":"pan","price":20}],10],"expected":{"index":0,"name":"pan"}},
      {"args":[[{"name":"pen","price":5},{"name":"ink","price":5}],10],"expected":null},
      {"args":[[{"name":"pen","price":5},{"name":"ink","price":5},{"name":"clip","price":1},{"name":"desk","price":90}],10],"expected":{"index":2,"name":"clip"}}
    ]
  }
}
