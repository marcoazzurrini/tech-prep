{
  "title": "Load Order",
  "check": {
    "type": "function",
    "function": {
      "javascript": "loadOrder"
    },
    "compare": "exact",
    "stubs": {
      "javascript": "export function loadOrder(imports, entry) {\n  // your code\n}\n"
    },
    "tests": [
      {"args":[{"main.js":["a.js"],"a.js":[]},"main.js"],"expected":["a.js","main.js"]},
      {"args":[{"main.js":["a.js","b.js"],"a.js":["b.js"],"b.js":[]},"main.js"],"expected":["b.js","a.js","main.js"]},
      {"args":[{"main.js":[]},"main.js"],"expected":["main.js"]},
      {"args":[{"main.js":["a.js","b.js","c.js"],"a.js":[],"b.js":[],"c.js":[]},"main.js"],"expected":["a.js","b.js","c.js","main.js"]},
      {"args":[{"main.js":["a.js","b.js"],"a.js":["d.js"],"b.js":["d.js","c.js"],"c.js":[],"d.js":[]},"main.js"],"expected":["d.js","a.js","c.js","b.js","main.js"]},
      {"args":[{"main.js":["a.js"],"a.js":["b.js"],"b.js":["c.js"],"c.js":[],"unused.js":["a.js"]},"main.js"],"expected":["c.js","b.js","a.js","main.js"]},
      {"args":[{"main.js":["b.js","a.js"],"a.js":["c.js"],"b.js":["c.js"],"c.js":[]},"a.js"],"expected":["c.js","a.js"]},
      {"args":[{"main.js":["a.js","a.js","b.js"],"a.js":["b.js"],"b.js":[]},"main.js"],"expected":["b.js","a.js","main.js"]}
    ]
  }
}
