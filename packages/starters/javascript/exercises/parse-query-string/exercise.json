{
  "title": "Parse a Query String",
  "check": {
    "type": "function",
    "function": {
      "javascript": "parseQuery"
    },
    "compare": "exact",
    "stubs": {
      "javascript": "export function parseQuery(query) {\n  // your code\n}\n"
    },
    "tests": [
      {"args":["?page=2&sort=name"],"expected":{"page":"2","sort":"name"}},
      {"args":["page=2"],"expected":{"page":"2"}},
