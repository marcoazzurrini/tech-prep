{
  "title": "Step Range",
  "check": {
    "type": "function",
    "calls": "script",
    "compare": "exact",
    "stubs": {
      "javascript": "export function range(start, end, step = 1) {\n  // your code\n}\n"
    },
    "tests": [
      {"args":["return [...range(0, 5)];"],"expected":[0,1,2,3,4]},
      {"args":["return [...range(0, 10, 3)];"],"expected":[0,3,6,9]},
      {"args":["return [...range(5, 0, -2)];"],"expected":[5,3,1]},
      {"args":["return [[...range(2, 2)], [...range(3, 1)]];"],"expected":[[],[]]},
      {"args":["const r = range(1, 3); return [[...r], [...r]];"],"expected":[[1,2],[1,2]]},
      {"args":["const r = range(1, 3); const out = []; for (const a of r) for (const b of r) out.push(a + b); return out;"],"expected":[2,3,3,4]}
    ]
  }
}
