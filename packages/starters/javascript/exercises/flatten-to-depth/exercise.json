      {"args":["const inner = [2]; const list = [1, inner]; const flat = flatten(list); return [flat, list.length, inner.length];"],"expected":[[1,2],2,1]},
      {"args":["return flatten([{ tasks: [1] }, [[], \"x\"]]);"],"expected":[{"tasks":[1]},[],"x"]},
