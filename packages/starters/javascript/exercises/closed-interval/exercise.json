{
  "title": "Closed Interval",
  "check": {
    "type": "function",
    "calls": "script",
    "compare": "exact",
    "stubs": {
      "javascript": "export class Interval {\n  constructor(from, to) {\n    this.from = from;\n    this.to = to;\n  }\n\n  // your code\n}\n"
    },
    "tests": [
      {"args":["return [...new Interval(2, 5)];"],"expected":[2,3,4,5]},
      {"args":["return [...new Interval(3, 1)];"],"expected":[]},
      {"args":["return `${new Interval(1, 3)}`;"],"expected":"[1, 3]"},
      {"args":["return new Interval(1, 3) * 10;"],"expected":30},
      {"args":["return Object.prototype.toString.call(new Interval(0, 0));"],"expected":"[object Interval]"},
      {"args":["return [{ from: 1, to: 2 } instanceof Interval, { from: 1 } instanceof Interval, 5 instanceof Interval];"],"expected":[true,false,false]},
      {"args":["return new Interval(4, 6) instanceof Interval;"],"expected":true}
    ]
  }
}
