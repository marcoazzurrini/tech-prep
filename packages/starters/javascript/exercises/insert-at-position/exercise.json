{
  "title": "Insert at a Position",
  "check": {
    "type": "function",
    "calls": "script",
    "compare": "exact",
    "stubs": {
      "javascript": "export function insertAt(list, index, items) {\n  // your code\n}\n"
    },
    "tests": [
      {"args":["return insertAt([1, 2, 5], 2, [3, 4]);"],"expected":[1,2,3,4,5]},
      {"args":["return insertAt([\"b\"], 0, [\"a\"]);"],"expected":["a","b"]},
      {"args":["return insertAt([1, 2], 2, []);"],"expected":[1,2]},
      {"args":["return insertAt([], 0, [\"x\", \"y\"]);"],"expected":["x","y"]},
      {"args":["const list = [1, 4]; insertAt(list, 1, [2, 3]); return list;"],"expected":[1,4]},
      {"args":["const list = [1]; return insertAt(list, 1, []) === list;"],"expected":false},
      {"args":["return insertAt([1, 4], 1, [[2, 3]]);"],"expected":[1,[2,3],4]}
    ]
  }
}
