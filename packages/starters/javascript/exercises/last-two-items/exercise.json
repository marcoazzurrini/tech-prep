{
  "title": "Last Two Items",
  "check": {
    "type": "function",
    "function": {
      "javascript": "lastTwo"
    },
    "compare": "exact",
    "stubs": {
      "javascript": "export function lastTwo(stack) {\n  let top = stack.length;\n\n  const first = stack[top--];\n  const second = stack[top--];\n\n  return [first, second];\n}\n"
    },
    "tests": [
      {"args":[["a","b","c"]],"expected":["c","b"]},
      {"args":[[1,2]],"expected":[2,1]},
      {"args":[[5,6,7,8,9]],"expected":[9,8]},
      {"args":[["x","x"]],"expected":["x","x"]},
      {"args":[[true,false,true]],"expected":[true,false]}
    ]
  }
}
