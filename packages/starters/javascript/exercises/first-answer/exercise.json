      {"args":["return firstAnswer([() => null, () => 1]);"],"expected":null},
      {"args":["return firstAnswer([() => undefined, () => 0, () => 5]);"],"expected":0},
      {"args":["let n = 0; const ask = () => { n += 1; }; firstAnswer([ask, () => \"a\", ask, ask]); return n;"],"expected":1},
      {"args":["let n = 0; const ask = () => { n += 1; return n; }; return [firstAnswer([ask, ask]), n];"],"expected":[1,1]}
