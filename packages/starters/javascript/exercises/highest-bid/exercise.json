{
  "title": "Highest Bid",
  "check": {
    "type": "function",
    "function": {
      "javascript": "highestBid"
    },
    "compare": "exact",
    "stubs": {
      "javascript": "export function highestBid(bids) {\n  let best = { name: \"nobody\", amount: 0 };\n\n  for (const bid of bids) {\n    if (bid.amount > best.amount) {\n      let best = bid;\n    }\n  }\n\n  return best.name;\n}\n"
    },
