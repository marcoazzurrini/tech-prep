      {"args":[[{"name":"Di","amount":5}]],"expected":"Di"},
      {"args":[[{"name":"Eve","amount":20},{"name":"Flo","amount":20}]],"expected":"Eve"},
      {"args":[[{"name":"Gus","amount":90},{"name":"Hal","amount":10}]],"expected":"Gus"},
      {"args":[[{"name":"Ida","amount":1},{"name":"Jo","amount":2},{"name":"Kim","amount":3}]],"expected":"Kim"}
    ]
  }
