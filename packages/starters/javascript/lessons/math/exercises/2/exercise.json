{
  "title": "Round Down to Decimals",
  "check": {
    "type": "function",
    "function": {
      "javascript": "floorTo"
    },
    "compare": "exact",
    "stubs": {
      "javascript": "export function floorTo(value, digits) {\n  const factor = 10 ** digits;\n  return Math.floor(value * factor) / factor;\n}\n"
    },
    "tests": [
      {"args":[0.29,2],"expected":0.29},
      {"args":[3.14159,2],"expected":3.14},
      {"args":[4.35,2],"expected":4.35},
      {"args":[0.57,2],"expected":0.57},
      {"args":[-1.234,1],"expected":-1.3},
      {"args":[7,2],"expected":7}
    ]
  }
}
