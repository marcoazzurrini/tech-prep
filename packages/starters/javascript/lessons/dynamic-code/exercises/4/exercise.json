{
  "title": "A Safe Calculator",
  "check": {
    "type": "function",
    "calls": "script",
    "compare": "exact",
    "stubs": {
      "javascript": "export function calculate(a, op, b) {\n  return eval(`${a} ${op} ${b}`);\n}\n"
    },
    "tests": [
      {"args":["return calculate(6, \"*\", 7);"],"expected":42},
      {"args":["return [calculate(10, \"-\", 4), calculate(5, \"+\", 5)];"],"expected":[6,10]},
      {"args":["return calculate(1, \"/\", 4);"],"expected":0.25},
      {"args":["return calculate(2, \"^\", 3);"],"expected":null},
      {"args":["return calculate(2, \"; 99;\", 3);"],"expected":null},
      {"args":["return calculate(2, \"toString\", 3);"],"expected":null}
    ]
  }
}
