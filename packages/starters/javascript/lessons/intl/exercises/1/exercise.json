{
  "title": "Format a Price",
  "check": {
    "type": "function",
    "function": {
      "javascript": "formatPrice"
    },
    "compare": "exact",
    "stubs": {
      "javascript": "export function formatPrice(amount, currency) {\n  // your code\n}\n"
    },
    "tests": [
      {"args":[5,"USD"],"expected":"$5.00"},
      {"args":[1234.5,"EUR"],"expected":"€1,234.50"},
      {"args":[1234.5,"JPY"],"expected":"¥1,235"},
      {"args":[0.5,"GBP"],"expected":"£0.50"},
      {"args":[-20,"USD"],"expected":"-$20.00"},
      {"args":[1000000,"USD"],"expected":"$1,000,000.00"}
    ]
  }
}
