      {"args":["const plan = {}; return hasInChain(plan, plan);"],"expected":false},
      {"args":["return hasInChain(Object.create(null), Object.prototype);"],"expected":false},
      {"args":["return [hasInChain(\"text\", String.prototype), hasInChain(7, Number.prototype)];"],"expected":[false,false]},
      {"args":["return [hasInChain(null, Object.prototype), hasInChain(undefined, Object.prototype)];"],"expected":[false,false]},
