{
  "title": "Remove Without Changing",
  "check": {
    "type": "function",
    "calls": "script",
    "compare": "exact",
    "stubs": {
      "javascript": "export function removeAt(list, index) {\n  list.splice(index, 1);\n  return list;\n}\n"
    },
    "tests": [
      {"args":["const a = [1, 2, 3]; const r = removeAt(a, 1); return [r, a];"],"expected":[[1,3],[1,2,3]]},
      {"args":["const a = [\"x\"]; return [removeAt(a, 0), a];"],"expected":[[],["x"]]},
      {"args":["const a = [1, 2]; return removeAt(a, 0) === a;"],"expected":false},
      {"args":["const a = [4, 5, 6]; return [removeAt(a, -1), a];"],"expected":[[4,5],[4,5,6]]},
      {"args":["const a = [4, 5, 6]; return [removeAt(a, 2), a.length];"],"expected":[[4,5],3]}
    ]
  }
}
