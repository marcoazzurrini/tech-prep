{
  "title": "Sort the Days",
  "check": {
    "type": "function",
    "function": {
      "javascript": "sortDays"
    },
    "compare": "exact",
    "stubs": {
      "javascript": "export function sortDays(days) {\n  const dates = days.map((day) => Temporal.PlainDate.from(day));\n  return dates.toSorted((a, b) => (a < b ? -1 : 1)).map(String);\n}\n"
    },
    "tests": [
      {"args":[["2024-03-01","2023-12-25","2024-01-15"]],"expected":["2023-12-25","2024-01-15","2024-03-01"]},
      {"args":[["2024-05-01"]],"expected":["2024-05-01"]},
      {"args":[[]],"expected":[]},
      {"args":[["2025-01-01","2024-12-31","2025-01-01"]],"expected":["2024-12-31","2025-01-01","2025-01-01"]},
      {"args":[["2024-02-10","2024-02-09"]],"expected":["2024-02-09","2024-02-10"]}
    ]
  }
}
