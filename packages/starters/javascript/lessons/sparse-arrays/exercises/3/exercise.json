{
  "title": "Describe Every Slot",
  "check": {
    "type": "function",
    "calls": "script",
    "compare": "exact",
    "stubs": {
      "javascript": "export function describeSlots(list) {\n  return list.map((item) => (item === undefined ? \"-\" : String(item)));\n}\n"
    },
    "tests": [
      {"args":["return describeSlots([1, , 3]);"],"expected":["1","-","3"]},
      {"args":["return describeSlots([undefined, null]);"],"expected":["undefined","null"]},
      {"args":["return describeSlots(new Array(2));"],"expected":["-","-"]},
      {"args":["return describeSlots([\"a\", , undefined, , \"e\"]);"],"expected":["a","-","undefined","-","e"]},
      {"args":["return describeSlots([]);"],"expected":[]}
    ]
  }
}
