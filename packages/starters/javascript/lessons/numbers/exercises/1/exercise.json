{
  "title": "Same Amount",
  "check": {
    "type": "function",
    "function": {
      "javascript": "sameAmount"
    },
    "compare": "exact",
    "stubs": {
      "javascript": "export function sameAmount(a, b) {\n  return a === b;\n}\n"
    },
    "tests": [
      {"args":[0.30000000000000004,0.3],"expected":true},
      {"args":[0.3,0.31],"expected":false},
      {"args":[0.7999999999999999,0.8],"expected":true},
      {"args":[0.5,0.5],"expected":true},
      {"args":[0.1,0.2],"expected":false},
      {"args":[0.9,0.8999999999999999],"expected":true}
    ]
  }
}
