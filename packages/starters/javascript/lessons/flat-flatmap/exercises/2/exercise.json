      "javascript": "expandTags"
    },
    "compare": "exact",
    "stubs": {
      "javascript": "export function expandTags(posts) {\n  // your code\n}\n"
    },
    "tests": [
      {"args":[[{"title":"news","tags":["js","web"]},{"title":"note","tags":[]}]],"expected":["news:js","news:web"]},
