[
  {
    "title": "Build times in order",
    "statement": "Print the build times from the shortest to the longest.\n\nThe first step takes `durations`. The second step is `.`, which changes nothing. Replace the second step with `sort`.",
    "stub": ".durations | .",
    "reference": ".durations | sort",
    "tests": [
      {
        "input": {
          "job": "test",
          "durations": [
            42,
            17,
            63,
            8
          ]
        },
        "expected": "[\n  8,\n  17,\n  42,\n  63\n]"
      },
      {
        "input": {
          "job": "lint",
          "durations": [
            5,
            3,
            9
          ]
        },
        "expected": "[\n  3,\n  5,\n  9\n]"
      },
      {
        "input": {
          "job": "deploy",
          "durations": [
            120
          ]
        },
        "expected": "[\n  120\n]"
      }
    ]
  },
  {
    "title": "Packages by size",
    "statement": "Print the packages ordered by size, the smallest first.\n\nThe filter below should do that, but jq stops with an error. Read the error, then fix the filter.",
    "stub": "sort_by(size)",
    "reference": "sort_by(.size)",
    "tests": [
      {
        "input": [
          {
            "name": "lodash",
            "size": 71
          },
          {
            "name": "left-pad",
            "size": 4
          },
          {
            "name": "react",
            "size": 32
          }
        ],
        "expected": "[\n  {\n    \"name\": \"left-pad\",\n    \"size\": 4\n  },\n  {\n    \"name\": \"react\",\n    \"size\": 32\n  },\n  {\n    \"name\": \"lodash\",\n    \"size\": 71\n  }\n]"
      },
      {
        "input": [
          {
            "name": "zod",
            "size": 57
          },
          {
            "name": "ms",
            "size": 3
          }
        ],
        "expected": "[\n  {\n    \"name\": \"ms\",\n    \"size\": 3\n  },\n  {\n    \"name\": \"zod\",\n    \"size\": 57\n  }\n]"
      },
      {
        "input": [
          {
            "name": "chalk",
            "size": 12
          },
          {
            "name": "debug",
            "size": 14
          },
          {
            "name": "uuid",
            "size": 9
          },
          {
            "name": "yargs",
            "size": 28
          }
        ],
        "expected": "[\n  {\n    \"name\": \"uuid\",\n    \"size\": 9\n  },\n  {\n    \"name\": \"chalk\",\n    \"size\": 12\n  },\n  {\n    \"name\": \"debug\",\n    \"size\": 14\n  },\n  {\n    \"name\": \"yargs\",\n    \"size\": 28\n  }\n]"
      }
    ]
  },
  {
    "title": "Best players first",
    "statement": "Print the names of the players, the one with the highest score first.\n\nSort the players by `score`, turn the order around with `reverse`, then take each `name` with `map`. Print one array of names.",
    "reference": "sort_by(.score) | reverse | map(.name)",
    "tests": [
      {
        "input": [
          {
            "name": "kim",
            "score": 310
          },
          {
            "name": "lee",
            "score": 480
          },
          {
            "name": "sam",
            "score": 150
          }
        ],
        "expected": "[\n  \"lee\",\n  \"kim\",\n  \"sam\"\n]"
      },
      {
        "input": [
          {
            "name": "ana",
            "score": 20
          },
          {
            "name": "ben",
            "score": 10
          }
        ],
        "expected": "[\n  \"ana\",\n  \"ben\"\n]"
      },
      {
        "input": [
          {
            "name": "joy",
            "score": 7
          },
          {
            "name": "max",
            "score": 99
          },
          {
            "name": "pat",
            "score": 54
          },
          {
            "name": "uma",
            "score": 61
          }
        ],
        "expected": "[\n  \"max\",\n  \"uma\",\n  \"pat\",\n  \"joy\"\n]"
      }
    ]
  }
]
