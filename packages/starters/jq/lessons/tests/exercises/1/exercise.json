{
  "title": "Is it merged?",
  "check": {
    "type": "command",
    "program": "jq",
    "compare": "json",
    "file": "data.json",
    "start": "jq '.state = \"merged\"' data.json",
    "reference": "jq '.state == \"merged\"' data.json",
    "tests": [
      {
        "input": {
          "number": 41,
          "state": "merged"
        },
        "expected": "true"
      },
      {
        "input": {
          "number": 42,
          "state": "open"
        },
        "expected": "false"
      },
      {
        "input": {
          "number": 43,
          "state": "closed"
        },
        "expected": "false"
      }
    ]
  }
}
