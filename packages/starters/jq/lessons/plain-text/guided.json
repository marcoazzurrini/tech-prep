[
  {
    "title": "Host without quotes",
    "statement": "Print the server's host as plain text, with no quotes.\n\nYou type what comes after `jq`. The text below prints the host with quotes. Add the flag `-r` in front of the filter.",
    "mode": "command",
    "stub": "'.host'",
    "reference": "-r '.host'",
    "tests": [
      {
        "input": {
          "host": "web-1.internal",
          "port": 443,
          "region": "eu"
        },
        "expected": "web-1.internal"
      },
      {
        "input": {
          "host": "db-1.internal",
          "port": 5432,
          "region": "eu"
        },
        "expected": "db-1.internal"
      },
      {
        "input": {
          "host": "cache-1.internal",
          "port": 6379,
          "region": "us"
        },
        "expected": "cache-1.internal"
      }
    ]
  },
  {
    "title": "Fix the command",
    "statement": "Print every tag of the image as plain text, one tag per line, with no quotes and no brackets.\n\nThe command below has `-r`, but it still prints an array with quotes. Change the filter so that each tag is its own output.",
    "mode": "command",
    "stub": "-r '.tags'",
    "reference": "-r '.tags | .[]'",
    "tests": [
      {
        "input": {
          "image": "shop-api",
          "tags": [
            "latest",
            "v2.1.0",
            "stable"
          ]
        },
        "expected": "latest\nv2.1.0\nstable"
      },
      {
        "input": {
          "image": "shop-web",
          "tags": [
            "v0.9.3"
          ]
        },
        "expected": "v0.9.3"
      },
      {
        "input": {
          "image": "worker",
          "tags": [
            "nightly",
            "edge"
          ]
        },
        "expected": "nightly\nedge"
      }
    ]
  },
  {
    "title": "Links to the repos",
    "statement": "Print the `url` of every repo as plain text, one per line, with no quotes.\n\nThe input is an array of repos. Keep them in the same order.",
    "mode": "command",
    "stub": "'.'",
    "reference": "-r '.[] | .url'",
    "tests": [
      {
        "input": [
          {
            "name": "atlas",
            "url": "https://example.com/mira/atlas"
          },
          {
            "name": "notes",
            "url": "https://example.com/tomas/notes"
          }
        ],
        "expected": "https://example.com/mira/atlas\nhttps://example.com/tomas/notes"
      },
      {
        "input": [
          {
            "name": "router",
            "url": "https://example.com/core/router"
          }
        ],
        "expected": "https://example.com/core/router"
      },
      {
        "input": [
          {
            "name": "docs",
            "url": "https://example.com/core/docs"
          },
          {
            "name": "cli",
            "url": "https://example.com/core/cli"
          },
          {
            "name": "site",
            "url": "https://example.com/core/site"
          }
        ],
        "expected": "https://example.com/core/docs\nhttps://example.com/core/cli\nhttps://example.com/core/site"
      }
    ]
  }
]
