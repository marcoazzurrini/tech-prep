{
  "title": "Labels of an issue",
  "check": {
    "type": "command",
    "program": "jq",
    "compare": "json",
    "file": "data.json",
    "start": "jq '.labels | split(\",\")' data.json",
    "reference": "jq '.labels | split(\", \")' data.json",
    "tests": [
      {
        "input": {
          "issue": 812,
          "labels": "bug, urgent, api"
        },
        "expected": "[\n  \"bug\",\n  \"urgent\",\n  \"api\"\n]"
      },
      {
        "input": {
          "issue": 813,
          "labels": "ui, a11y"
        },
        "expected": "[\n  \"ui\",\n  \"a11y\"\n]"
      },
      {
        "input": {
          "issue": 820,
          "labels": "docs, good first issue, help wanted, ci"
        },
        "expected": "[\n  \"docs\",\n  \"good first issue\",\n  \"help wanted\",\n  \"ci\"\n]"
      }
    ]
  }
}
