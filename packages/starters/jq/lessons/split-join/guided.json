[
  {
    "title": "Labels of an issue",
    "statement": "Print the labels of the issue as an array of strings.\n\nThe command below almost works, but some labels come out with a space at the front. Look at what stands between two labels in the input. Then fix the separator.",
    "stub": ".labels | split(\",\")",
    "reference": ".labels | split(\", \")",
    "tests": [
      {
        "input": {
          "issue": 812,
          "labels": "bug, urgent, api"
        },
        "expected": "[\n  \"bug\",\n  \"urgent\",\n  \"api\"\n]"
      },
      {
        "input": {
          "issue": 813,
          "labels": "ui, a11y"
        },
        "expected": "[\n  \"ui\",\n  \"a11y\"\n]"
      },
      {
        "input": {
          "issue": 820,
          "labels": "docs, good first issue, help wanted, ci"
        },
        "expected": "[\n  \"docs\",\n  \"good first issue\",\n  \"help wanted\",\n  \"ci\"\n]"
      }
    ]
  },
  {
    "title": "Reviewers in one line",
    "statement": "Print the reviewers of the pull request as one string.\n\nThe names are in `reviewers`. Use `join`. Put a comma and a space between two names, as in `ada, bo`.",
    "reference": ".reviewers | join(\", \")",
    "tests": [
      {
        "input": {
          "pr": 57,
          "reviewers": [
            "ada",
            "bo",
            "cy"
          ]
        },
        "expected": "\"ada, bo, cy\""
      },
      {
        "input": {
          "pr": 58,
          "reviewers": [
            "dee"
          ]
        },
        "expected": "\"dee\""
      },
      {
        "input": {
          "pr": 61,
          "reviewers": [
            "bo",
            "eli"
          ]
        },
        "expected": "\"bo, eli\""
      }
    ]
  },
  {
    "title": "Package as a folder",
    "statement": "Print the name of the package with every dot swapped for a slash.\n\nThe name is in `package`. For `com.example.app`, print `com/example/app`. Split at the dots first. Then join with a slash.",
    "reference": ".package | split(\".\") | join(\"/\")",
    "tests": [
      {
        "input": {
          "package": "com.example.app",
          "version": 3
        },
        "expected": "\"com/example/app\""
      },
      {
        "input": {
          "package": "org.demo.tools.cli",
          "version": 1
        },
        "expected": "\"org/demo/tools/cli\""
      },
      {
        "input": {
          "package": "util",
          "version": 9
        },
        "expected": "\"util\""
      }
    ]
  }
]
