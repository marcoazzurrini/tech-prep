[
  {
    "title": "Path parts",
    "statement": "Give the parts of the file path as an array.\n\nThe path is in `path`. Its parts are separated by `/`. Use `split`.",
    "reference": ".path | split(\"/\")",
    "tests": [
      {
        "input": {
          "path": "src/app/main.ts"
        },
        "expected": "[\n  \"src\",\n  \"app\",\n  \"main.ts\"\n]"
      },
      {
        "input": {
          "path": "README.md"
        },
        "expected": "[\n  \"README.md\"\n]"
      },
      {
        "input": {
          "path": "docs/api"
        },
        "expected": "[\n  \"docs\",\n  \"api\"\n]"
      }
    ]
  },
  {
    "title": "Host name",
    "statement": "Build the host name from its parts.\n\nThe parts are in the `parts` array. Glue them into one string with a `.` between them. Use `join`.",
    "reference": ".parts | join(\".\")",
    "tests": [
      {
        "input": {
          "parts": [
            "api",
            "example",
            "com"
          ]
        },
        "expected": "\"api.example.com\""
      },
      {
        "input": {
          "parts": [
            "localhost"
          ]
        },
        "expected": "\"localhost\""
      },
      {
        "input": {
          "parts": [
            "www",
            "shop",
            "example",
            "org"
          ]
        },
        "expected": "\"www.shop.example.org\""
      }
    ]
  },
  {
    "title": "Date with slashes",
    "statement": "Write the date with `/` in place of `-`.\n\nThe date is in `date`, for example `2024-03-15`. Give one string, for example `2024/03/15`. Use `split`, then `join`.",
    "reference": ".date | split(\"-\") | join(\"/\")",
    "tests": [
      {
        "input": {
          "date": "2024-03-15"
        },
        "expected": "\"2024/03/15\""
      },
      {
        "input": {
          "date": "1999-12-31"
        },
        "expected": "\"1999/12/31\""
      },
      {
        "input": {
          "date": "2025-01-01"
        },
        "expected": "\"2025/01/01\""
      }
    ]
  }
]
