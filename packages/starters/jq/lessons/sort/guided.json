[
  {
    "title": "Slowest requests",
    "statement": "Order the requests from slowest to fastest.\n\nThe input is an array of requests. Each has a `path` and a time in `ms`. Give an array of whole requests back, with the highest `ms` first. Use `sort_by`, then `reverse`.",
    "reference": "sort_by(.ms) | reverse",
    "tests": [
      {
        "input": [
          {
            "path": "/home",
            "ms": 120
          },
          {
            "path": "/search",
            "ms": 480
          },
          {
            "path": "/login",
            "ms": 95
          }
        ],
        "expected": "[\n  {\n    \"path\": \"/search\",\n    \"ms\": 480\n  },\n  {\n    \"path\": \"/home\",\n    \"ms\": 120\n  },\n  {\n    \"path\": \"/login\",\n    \"ms\": 95\n  }\n]"
      },
      {
        "input": [
          {
            "path": "/cart",
            "ms": 300
          },
          {
            "path": "/pay",
            "ms": 900
          }
        ],
        "expected": "[\n  {\n    \"path\": \"/pay\",\n    \"ms\": 900\n  },\n  {\n    \"path\": \"/cart\",\n    \"ms\": 300\n  }\n]"
      },
      {
        "input": [
          {
            "path": "/health",
            "ms": 3
          }
        ],
        "expected": "[\n  {\n    \"path\": \"/health\",\n    \"ms\": 3\n  }\n]"
      },
      {
        "input": [
          {
            "path": "/a",
            "ms": 41
          },
          {
            "path": "/b",
            "ms": 40
          },
          {
            "path": "/c",
            "ms": 77
          },
          {
            "path": "/d",
            "ms": 12
          }
        ],
        "expected": "[\n  {\n    \"path\": \"/c\",\n    \"ms\": 77\n  },\n  {\n    \"path\": \"/a\",\n    \"ms\": 41\n  },\n  {\n    \"path\": \"/b\",\n    \"ms\": 40\n  },\n  {\n    \"path\": \"/d\",\n    \"ms\": 12\n  }\n]"
      }
    ]
  },
  {
    "title": "Tags in order",
    "statement": "Give the tags of the post in order, from a to z.\n\nThe tags are strings in the `tags` array. Give one array back. Use `sort`.",
    "reference": ".tags | sort",
    "tests": [
      {
        "input": {
          "title": "Release notes",
          "tags": [
            "jq",
            "cli",
            "json"
          ]
        },
        "expected": "[\n  \"cli\",\n  \"jq\",\n  \"json\"\n]"
      },
      {
        "input": {
          "title": "Draft",
          "tags": []
        },
        "expected": "[]"
      },
      {
        "input": {
          "title": "Shell tips",
          "tags": [
            "zsh",
            "bash",
            "fish",
            "awk"
          ]
        },
        "expected": "[\n  \"awk\",\n  \"bash\",\n  \"fish\",\n  \"zsh\"\n]"
      }
    ]
  },
  {
    "title": "Names by age",
    "statement": "Give the names of the people, youngest first.\n\nEach person has a `name` and an `age`. Order the people by `age`, then keep only the names. Give one array of strings back.",
    "reference": "sort_by(.age) | map(.name)",
    "tests": [
      {
        "input": [
          {
            "name": "Ida",
            "age": 34
          },
          {
            "name": "Jon",
            "age": 19
          },
          {
            "name": "Kim",
            "age": 52
          }
        ],
        "expected": "[\n  \"Jon\",\n  \"Ida\",\n  \"Kim\"\n]"
      },
      {
        "input": [
          {
            "name": "Lea",
            "age": 40
          }
        ],
        "expected": "[\n  \"Lea\"\n]"
      },
      {
        "input": [
          {
            "name": "Max",
            "age": 61
          },
          {
            "name": "Nia",
            "age": 23
          }
        ],
        "expected": "[\n  \"Nia\",\n  \"Max\"\n]"
      },
      {
        "input": [],
        "expected": "[]"
      }
    ]
  }
]
