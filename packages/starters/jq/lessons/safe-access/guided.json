[
  {
    "title": "Hosts in the inventory",
    "statement": "Print the host of every server, each as its own output.\n\nThe filter below stops with an error, because one entry is a string and not an object. Fix the filter so that jq skips that entry.",
    "stub": ".[] | .host",
    "reference": ".[] | .host?",
    "tests": [
      {
        "input": [
          {
            "host": "web-1",
            "port": 443
          },
          "decommissioned",
          {
            "host": "db-1",
            "port": 5432
          }
        ],
        "expected": "\"web-1\"\n\"db-1\""
      },
      {
        "input": [
          {
            "host": "cache-1",
            "port": 6379
          },
          {
            "host": "cache-2",
            "port": 6379
          }
        ],
        "expected": "\"cache-1\"\n\"cache-2\""
      },
      {
        "input": [
          404,
          {
            "host": "mail-1",
            "port": 25
          },
          [
            "old-1",
            "old-2"
          ]
        ],
        "expected": "\"mail-1\""
      }
    ]
  },
  {
    "title": "What comes out?",
    "statement": "Type what jq prints for this input and this filter.\n\nThere is more than one output. Type each output on its own line.",
    "mode": "predict",
    "show_filter": true,
    "reference": ".[] | .id?",
    "tests": [
      {
        "input": [
          {
            "id": 4
          },
          "n/a",
          {
            "name": "x"
          },
          {
            "id": 9
          }
        ],
        "expected": "4\nnull\n9"
      }
    ]
  },
  {
    "title": "Tags of all articles",
    "statement": "Print every tag of every article, each as its own output.\n\nThe tags are in the key `tags` of each article. In some articles `tags` is `null`. Skip those articles. Put the `?` after the step that fails.",
    "reference": ".[] | .tags[]?",
    "tests": [
      {
        "input": [
          {
            "title": "Intro",
            "tags": [
              "jq",
              "json"
            ]
          },
          {
            "title": "Draft",
            "tags": null
          },
          {
            "title": "Tips",
            "tags": [
              "cli"
            ]
          }
        ],
        "expected": "\"jq\"\n\"json\"\n\"cli\""
      },
      {
        "input": [
          {
            "title": "News",
            "tags": [
              "release"
            ]
          },
          {
            "title": "Notes"
          }
        ],
        "expected": "\"release\""
      },
      {
        "input": [
          {
            "title": "Old",
            "tags": "none"
          },
          {
            "title": "Guide",
            "tags": [
              "howto",
              "shell",
              "pipes"
            ]
          }
        ],
        "expected": "\"howto\"\n\"shell\"\n\"pipes\""
      }
    ]
  }
]
