[
  {
    "title": "Name of the repo",
    "statement": "Print the name of the repo.",
    "reference": ".repo.name",
    "tests": [
      {
        "input": {
          "repo": {
            "name": "api",
            "owner": {
              "login": "ada",
              "id": 7
            }
          },
          "stars": 12
        },
        "expected": "\"api\""
      },
      {
        "input": {
          "repo": {
            "name": "web",
            "owner": {
              "login": "bo",
              "id": 9
            }
          },
          "stars": 3
        },
        "expected": "\"web\""
      },
      {
        "input": {
          "repo": {
            "name": "docs",
            "owner": {
              "login": "cy",
              "id": 2
            }
          },
          "stars": 40
        },
        "expected": "\"docs\""
      }
    ]
  },
  {
    "title": "Author of the deploy",
    "statement": "Print the author of the commit that was deployed.\n\nBuild the path one step at a time, and read the output after each step.",
    "reference": ".deploy.commit.author",
    "tests": [
      {
        "input": {
          "deploy": {
            "env": "prod",
            "commit": {
              "sha": "9f2c1a",
              "author": "cy"
            }
          }
        },
        "expected": "\"cy\""
      },
      {
        "input": {
          "deploy": {
            "env": "staging",
            "commit": {
              "sha": "77b0de",
              "author": "ada"
            }
          }
        },
        "expected": "\"ada\""
      },
      {
        "input": {
          "deploy": {
            "env": "prod",
            "commit": {
              "sha": "c41e09",
              "author": "bo"
            }
          }
        },
        "expected": "\"bo\""
      }
    ]
  },
  {
    "title": "One step too far",
    "statement": "Print the host of the server.\n\nThe filter below should do that, but jq stops with an error. Read the error, then fix the filter.",
    "stub": ".server.host.name",
    "reference": ".server.host",
    "tests": [
      {
        "input": {
          "server": {
            "host": "web-1",
            "port": 443
          }
        },
        "expected": "\"web-1\""
      },
      {
        "input": {
          "server": {
            "host": "db-1",
            "port": 5432
          }
        },
        "expected": "\"db-1\""
      },
      {
        "input": {
          "server": {
            "host": "cache-1",
            "port": 6379
          }
        },
        "expected": "\"cache-1\""
      }
    ]
  }
]
