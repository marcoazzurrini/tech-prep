[
  {
    "title": "Orders line by line",
    "statement": "Print every order on its own line.\n\nThe input is an array of orders. Print each whole order as one line of JSON, with no spaces. Use the `-c` flag.",
    "mode": "command",
    "stub": "'.'",
    "reference": "-c '.[]'",
    "tests": [
      {
        "input": [
          {
            "id": 101,
            "total": 25
          },
          {
            "id": 102,
            "total": 8
          }
        ],
        "expected": "{\"id\":101,\"total\":25}\n{\"id\":102,\"total\":8}"
      },
      {
        "input": [
          {
            "id": 200,
            "total": 99
          }
        ],
        "expected": "{\"id\":200,\"total\":99}"
      },
      {
        "input": [],
        "expected": ""
      },
      {
        "input": [
          {
            "id": 301,
            "total": 4
          },
          {
            "id": 302,
            "total": 12
          },
          {
            "id": 303,
            "total": 40
          }
        ],
        "expected": "{\"id\":301,\"total\":4}\n{\"id\":302,\"total\":12}\n{\"id\":303,\"total\":40}"
      }
    ]
  },
  {
    "title": "Reply on one line",
    "statement": "Print the whole API reply on one line.\n\nThe input is one object with values inside it. Print all of it as one line of JSON, with no spaces. Use `-c`.",
    "mode": "command",
    "stub": "'.'",
    "reference": "-c '.'",
    "tests": [
      {
        "input": {
          "ok": true,
          "user": {
            "id": 7,
            "name": "Ada"
          },
          "roles": [
            "admin",
            "dev"
          ]
        },
        "expected": "{\"ok\":true,\"user\":{\"id\":7,\"name\":\"Ada\"},\"roles\":[\"admin\",\"dev\"]}"
      },
      {
        "input": {
          "ok": false,
          "user": null,
          "roles": []
        },
        "expected": "{\"ok\":false,\"user\":null,\"roles\":[]}"
      },
      {
        "input": {
          "ok": true,
          "user": {
            "id": 9,
            "name": "Bo"
          },
          "roles": [
            "dev"
          ]
        },
        "expected": "{\"ok\":true,\"user\":{\"id\":9,\"name\":\"Bo\"},\"roles\":[\"dev\"]}"
      }
    ]
  },
  {
    "title": "Short log entries",
    "statement": "Print a short form of every log entry, one per line.\n\nThe input is an array of log entries. For each entry, build an object with only `time` and `level`, in that order. Print each object as one line of JSON, with no spaces. Use `-c`.",
    "mode": "command",
    "stub": "'.'",
    "reference": "-c '.[] | {time, level}'",
    "tests": [
      {
        "input": [
          {
            "time": "09:00",
            "level": "info",
            "msg": "started"
          },
          {
            "time": "09:05",
            "level": "error",
            "msg": "disk full"
          }
        ],
        "expected": "{\"time\":\"09:00\",\"level\":\"info\"}\n{\"time\":\"09:05\",\"level\":\"error\"}"
      },
      {
        "input": [
          {
            "time": "12:30",
            "level": "warn",
            "msg": "slow reply"
          }
        ],
        "expected": "{\"time\":\"12:30\",\"level\":\"warn\"}"
      },
      {
        "input": [],
        "expected": ""
      },
      {
        "input": [
          {
            "time": "18:00",
            "level": "info",
            "msg": "backup done"
          },
          {
            "time": "18:01",
            "level": "info",
            "msg": "stopped"
          }
        ],
        "expected": "{\"time\":\"18:00\",\"level\":\"info\"}\n{\"time\":\"18:01\",\"level\":\"info\"}"
      }
    ]
  }
]
