[
  {
    "title": "Todo titles",
    "statement": "Give the title of every todo.\n\nThe input is an array of todos. Print each title as its own output. Use `.[]`, then a `|`, then `.title`.",
    "reference": ".[] | .title",
    "tests": [
      {
        "input": [
          {
            "title": "Buy milk",
            "done": false
          },
          {
            "title": "Call Sam",
            "done": true
          },
          {
            "title": "Fix bike",
            "done": false
          }
        ],
        "expected": "\"Buy milk\"\n\"Call Sam\"\n\"Fix bike\""
      },
      {
        "input": [
          {
            "title": "Pay rent",
            "done": true
          }
        ],
        "expected": "\"Pay rent\""
      },
      {
        "input": [],
        "expected": ""
      }
    ]
  },
  {
    "title": "Server names",
    "statement": "Give every server name as its own output.\n\nThe names are strings in the `hosts` array. `.hosts[]` reads the field and then gives every item.",
    "reference": ".hosts[]",
    "tests": [
      {
        "input": {
          "region": "eu",
          "hosts": [
            "web-1",
            "web-2",
            "db-1"
          ]
        },
        "expected": "\"web-1\"\n\"web-2\"\n\"db-1\""
      },
      {
        "input": {
          "region": "us",
          "hosts": [
            "web-9"
          ]
        },
        "expected": "\"web-9\""
      },
      {
        "input": {
          "region": "ap",
          "hosts": []
        },
        "expected": ""
      }
    ]
  },
  {
    "title": "Script commands",
    "statement": "Give every command in the `scripts` object.\n\nThe input is a package file. `scripts` is an object, not an array. `.[]` also works on an object: it gives every value. Print each command as its own output.",
    "reference": ".scripts[]",
    "tests": [
      {
        "input": {
          "name": "site",
          "scripts": {
            "build": "tsc",
            "test": "vitest run",
            "lint": "eslint ."
          }
        },
        "expected": "\"tsc\"\n\"vitest run\"\n\"eslint .\""
      },
      {
        "input": {
          "name": "cli",
          "scripts": {
            "test": "bun test"
          }
        },
        "expected": "\"bun test\""
      },
      {
        "input": {
          "name": "empty",
          "scripts": {}
        },
        "expected": ""
      }
    ]
  }
]
