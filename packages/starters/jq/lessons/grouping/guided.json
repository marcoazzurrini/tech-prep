[
  {
    "title": "Tickets by status",
    "statement": "Split the tickets into groups, one array for each status.\n\nThe filter below prints the tickets ordered by status, all in one array. Change `sort_by` to `group_by`, so that each status gets its own array of tickets.",
    "stub": "sort_by(.status)",
    "reference": "group_by(.status)",
    "tests": [
      {
        "input": [
          {
            "id": "T-1",
            "status": "open"
          },
          {
            "id": "T-2",
            "status": "done"
          },
          {
            "id": "T-3",
            "status": "open"
          }
        ],
        "expected": "[\n  [\n    {\n      \"id\": \"T-2\",\n      \"status\": \"done\"\n    }\n  ],\n  [\n    {\n      \"id\": \"T-1\",\n      \"status\": \"open\"\n    },\n    {\n      \"id\": \"T-3\",\n      \"status\": \"open\"\n    }\n  ]\n]"
      },
      {
        "input": [
          {
            "id": "T-7",
            "status": "review"
          },
          {
            "id": "T-8",
            "status": "review"
          }
        ],
        "expected": "[\n  [\n    {\n      \"id\": \"T-7\",\n      \"status\": \"review\"\n    },\n    {\n      \"id\": \"T-8\",\n      \"status\": \"review\"\n    }\n  ]\n]"
      },
      {
        "input": [
          {
            "id": "T-4",
            "status": "open"
          },
          {
            "id": "T-5",
            "status": "blocked"
          },
          {
            "id": "T-6",
            "status": "done"
          },
          {
            "id": "T-9",
            "status": "blocked"
          }
        ],
        "expected": "[\n  [\n    {\n      \"id\": \"T-5\",\n      \"status\": \"blocked\"\n    },\n    {\n      \"id\": \"T-9\",\n      \"status\": \"blocked\"\n    }\n  ],\n  [\n    {\n      \"id\": \"T-6\",\n      \"status\": \"done\"\n    }\n  ],\n  [\n    {\n      \"id\": \"T-4\",\n      \"status\": \"open\"\n    }\n  ]\n]"
      }
    ]
  },
  {
    "title": "What comes out?",
    "statement": "Type what jq prints for this input and this filter.\n\nFirst work out the groups. Then count the items of each group.",
    "mode": "predict",
    "show_filter": true,
    "reference": "group_by(.plan) | map(length)",
    "tests": [
      {
        "input": [
          {
            "id": 1,
            "plan": "pro"
          },
          {
            "id": 2,
            "plan": "free"
          },
          {
            "id": 3,
            "plan": "pro"
          },
          {
            "id": 4,
            "plan": "pro"
          }
        ],
        "expected": "[\n  1,\n  3\n]"
      }
    ]
  },
  {
    "title": "Deploys per environment",
    "statement": "Print how many deploys each environment got.\n\nThe input is an array of deploys. Group them by `env`. Then use `map` to build one object for each group, with `env` and `count`. Print one array of these objects.",
    "reference": "group_by(.env) | map({env: .[0].env, count: length})",
    "tests": [
      {
        "input": [
          {
            "service": "api",
            "env": "prod"
          },
          {
            "service": "web",
            "env": "staging"
          },
          {
            "service": "web",
            "env": "prod"
          },
          {
            "service": "jobs",
            "env": "prod"
          }
        ],
        "expected": "[\n  {\n    \"env\": \"prod\",\n    \"count\": 3\n  },\n  {\n    \"env\": \"staging\",\n    \"count\": 1\n  }\n]"
      },
      {
        "input": [
          {
            "service": "api",
            "env": "dev"
          },
          {
            "service": "api",
            "env": "dev"
          }
        ],
        "expected": "[\n  {\n    \"env\": \"dev\",\n    \"count\": 2\n  }\n]"
      },
      {
        "input": [
          {
            "service": "docs",
            "env": "staging"
          },
          {
            "service": "api",
            "env": "dev"
          },
          {
            "service": "web",
            "env": "prod"
          },
          {
            "service": "web",
            "env": "dev"
          },
          {
            "service": "api",
            "env": "staging"
          }
        ],
        "expected": "[\n  {\n    \"env\": \"dev\",\n    \"count\": 2\n  },\n  {\n    \"env\": \"prod\",\n    \"count\": 1\n  },\n  {\n    \"env\": \"staging\",\n    \"count\": 2\n  }\n]"
      }
    ]
  }
]
