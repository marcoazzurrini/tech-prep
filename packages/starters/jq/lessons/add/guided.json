[
  {
    "title": "Total spent",
    "statement": "Give the total of all the expenses.\n\nEach expense has a `label` and an `amount`. Make an array of the amounts, then use `add`. Print one number.",
    "reference": "map(.amount) | add",
    "tests": [
      {
        "input": [
          {
            "label": "rent",
            "amount": 900
          },
          {
            "label": "food",
            "amount": 240
          },
          {
            "label": "bus",
            "amount": 45
          }
        ],
        "expected": "1185"
      },
      {
        "input": [
          {
            "label": "book",
            "amount": 18
          }
        ],
        "expected": "18"
      },
      {
        "input": [
          {
            "label": "tea",
            "amount": 5
          },
          {
            "label": "cake",
            "amount": 5.5
          }
        ],
        "expected": "10.5"
      }
    ]
  },
  {
    "title": "Coldest and warmest",
    "statement": "Give the lowest and the highest temperature of the week.\n\nThe temperatures are numbers in the `temps` array. Give an object with two keys: `low` for the smallest number and `high` for the largest. Use `min` and `max`.",
    "reference": ".temps | {low: min, high: max}",
    "tests": [
      {
        "input": {
          "city": "Oslo",
          "temps": [
            4,
            -2,
            7,
            1
          ]
        },
        "expected": "{\n  \"low\": -2,\n  \"high\": 7\n}"
      },
      {
        "input": {
          "city": "Cairo",
          "temps": [
            31
          ]
        },
        "expected": "{\n  \"low\": 31,\n  \"high\": 31\n}"
      },
      {
        "input": {
          "city": "Lima",
          "temps": [
            18,
            22,
            19
          ]
        },
        "expected": "{\n  \"low\": 18,\n  \"high\": 22\n}"
      }
    ]
  },
  {
    "title": "Largest file",
    "statement": "Give the name of the largest file.\n\nEach file has a `name` and a `size`. Use `max_by` to find the file, then read its `name`. Print one string.",
    "reference": "max_by(.size) | .name",
    "tests": [
      {
        "input": [
          {
            "name": "app.js",
            "size": 5200
          },
          {
            "name": "index.html",
            "size": 800
          },
          {
            "name": "logo.png",
            "size": 14300
          }
        ],
        "expected": "\"logo.png\""
      },
      {
        "input": [
          {
            "name": "notes.txt",
            "size": 1
          }
        ],
        "expected": "\"notes.txt\""
      },
      {
        "input": [
          {
            "name": "old.zip",
            "size": 90
          },
          {
            "name": "new.zip",
            "size": 70
          }
        ],
        "expected": "\"old.zip\""
      }
    ]
  }
]
