[
  {
    "title": "What comes out?",
    "statement": "Type what jq prints for this input and this command.\n\nThe input holds three values, one per line. Type each output on its own line.",
    "mode": "predict",
    "show_filter": true,
    "reference": ".status",
    "tests": [
      {
        "input_text": "{\"path\": \"/\", \"status\": 200}\n{\"path\": \"/admin\", \"status\": 403}\n{\"path\": \"/old\", \"status\": 404}\n",
        "expected": "200\n403\n404"
      }
    ]
  },
  {
    "title": "A smaller request log",
    "statement": "Print the `request` of every line, so that the result is a log again.\n\nEach line of the input is one value. Each `request` is its own output: a whole object on one line, with no spaces. Use `-c`.",
    "mode": "command",
    "stub": "'.'",
    "reference": "-c '.request'",
    "tests": [
      {
        "input_text": "{\"time\": \"10:01\", \"request\": {\"method\": \"GET\", \"path\": \"/\"}}\n{\"time\": \"10:02\", \"request\": {\"method\": \"POST\", \"path\": \"/login\"}}\n{\"time\": \"10:05\", \"request\": {\"method\": \"GET\", \"path\": \"/cart\"}}\n",
        "expected": "{\"method\":\"GET\",\"path\":\"/\"}\n{\"method\":\"POST\",\"path\":\"/login\"}\n{\"method\":\"GET\",\"path\":\"/cart\"}"
      },
      {
        "input_text": "{\"time\": \"23:59\", \"request\": {\"method\": \"DELETE\", \"path\": \"/session\"}}\n",
        "expected": "{\"method\":\"DELETE\",\"path\":\"/session\"}"
      },
      {
        "input_text": "{\"time\": \"07:30\", \"request\": {\"method\": \"PUT\", \"path\": \"/profile\"}}\n{\"time\": \"07:31\", \"request\": {\"method\": \"GET\", \"path\": \"/profile\"}}\n",
        "expected": "{\"method\":\"PUT\",\"path\":\"/profile\"}\n{\"method\":\"GET\",\"path\":\"/profile\"}"
      }
    ]
  },
  {
    "title": "The last deploy",
    "statement": "Print the version of the last deploy in the file.\n\nEach line is one deploy, and there can be any number of lines. Read all of them into one array with `-s`. Then take the last item and its `version`.",
    "mode": "command",
    "stub": "'.'",
    "reference": "-s '.[-1].version'",
    "tests": [
      {
        "input_text": "{\"version\": \"1.4.0\", \"by\": \"ada\"}\n{\"version\": \"1.4.1\", \"by\": \"bo\"}\n{\"version\": \"1.5.0\", \"by\": \"ada\"}\n",
        "expected": "\"1.5.0\""
      },
      {
        "input_text": "{\"version\": \"0.9.2\", \"by\": \"cy\"}\n",
        "expected": "\"0.9.2\""
      },
      {
        "input_text": "{\"version\": \"3.0.0\", \"by\": \"bo\"}\n{\"version\": \"3.0.1\", \"by\": \"bo\"}\n",
        "expected": "\"3.0.1\""
      }
    ]
  }
]
