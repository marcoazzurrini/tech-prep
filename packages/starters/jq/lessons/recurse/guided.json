[
  {
    "title": "Error codes",
    "statement": "Give every error code in the reply, at any depth.\n\nAn error code is the value of a `code` key. Use `..` and `.code?`. Then drop the `null` values with `select`. Print each code as its own output, in the order `..` finds them.",
    "reference": ".. | .code? | select(. != null)",
    "tests": [
      {
        "input": {
          "status": "failed",
          "error": {
            "code": "E_BATCH",
            "causes": [
              {
                "code": "E_TIMEOUT",
                "detail": "db"
              },
              {
                "detail": "retry",
                "inner": {
                  "code": "E_CONN"
                }
              }
            ]
          }
        },
        "expected": "\"E_BATCH\"\n\"E_TIMEOUT\"\n\"E_CONN\""
      },
      {
        "input": {
          "status": "ok"
        },
        "expected": ""
      },
      {
        "input": {
          "code": "E_AUTH",
          "message": "no token"
        },
        "expected": "\"E_AUTH\""
      }
    ]
  },
  {
    "title": "Every number",
    "statement": "Collect every number in the metrics into one array.\n\nThe numbers are at different depths. Use `..` and keep the values whose `type` is `\"number\"`. Give one array, in the order `..` finds them.",
    "reference": "[.. | select(type == \"number\")]",
    "tests": [
      {
        "input": {
          "host": "web-1",
          "cpu": {
            "user": 12,
            "system": 3
          },
          "disks": [
            {
              "name": "sda",
              "used": 70
            },
            {
              "name": "sdb",
              "used": 41
            }
          ]
        },
        "expected": "[\n  12,\n  3,\n  70,\n  41\n]"
      },
      {
        "input": {
          "host": "web-2"
        },
        "expected": "[]"
      },
      {
        "input": [
          1,
          [
            2,
            [
              3
            ]
          ],
          "x"
        ],
        "expected": "[\n  1,\n  2,\n  3\n]"
      }
    ]
  },
  {
    "title": "Count the folders",
    "statement": "Count the folders in the file tree.\n\nEvery entry is an object with a `kind`: `\"dir\"` for a folder and `\"file\"` for a file. A folder holds its entries in `children`. Folders can be inside folders. The top entry counts too. Use `..`, keep the folders with `select(.kind? == \"dir\")`, collect them in an array and take its `length`.",
    "reference": "[.. | select(.kind? == \"dir\")] | length",
    "tests": [
      {
        "input": {
          "name": "app",
          "kind": "dir",
          "children": [
            {
              "name": "main.js",
              "kind": "file"
            },
            {
              "name": "lib",
              "kind": "dir",
              "children": [
                {
                  "name": "util.js",
                  "kind": "file"
                }
              ]
            }
          ]
        },
        "expected": "2"
      },
      {
        "input": {
          "name": "notes.txt",
          "kind": "file"
        },
        "expected": "0"
      },
      {
        "input": {
          "name": "site",
          "kind": "dir",
          "children": [
            {
              "name": "css",
              "kind": "dir",
              "children": []
            },
            {
              "name": "img",
              "kind": "dir",
              "children": [
                {
                  "name": "icons",
                  "kind": "dir",
                  "children": []
                }
              ]
            }
          ]
        },
        "expected": "4"
      }
    ]
  }
]
