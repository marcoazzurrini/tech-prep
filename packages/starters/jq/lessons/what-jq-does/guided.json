[
  {
    "title": "The whole input",
    "statement": "Print the whole input, unchanged.\n\nType only the filter that means \"the whole input\". It is one character. Do not type `jq`, quotes or a file name. Watch **Your output** change as you type.",
    "stub": "",
    "reference": ".",
    "tests": [
      {
        "input": {
          "name": "Ada",
          "city": "Oslo",
          "active": true
        },
        "expected": "{\n  \"name\": \"Ada\",\n  \"city\": \"Oslo\",\n  \"active\": true\n}"
      },
      {
        "input": {
          "name": "Bo",
          "city": "Bergen",
          "active": false
        },
        "expected": "{\n  \"name\": \"Bo\",\n  \"city\": \"Bergen\",\n  \"active\": false\n}"
      },
      {
        "input": {
          "id": 7
        },
        "expected": "{\n  \"id\": 7\n}"
      }
    ]
  },
  {
    "title": "City of the user",
    "statement": "Print the user's city.\n\nThe filter below prints the user's name. Change it so that it prints the city.",
    "stub": ".name",
    "reference": ".city",
    "tests": [
      {
        "input": {
          "name": "Ada",
          "city": "Oslo"
        },
        "expected": "\"Oslo\""
      },
      {
        "input": {
          "name": "Bo",
          "city": "Bergen"
        },
        "expected": "\"Bergen\""
      },
      {
        "input": {
          "name": "Cy",
          "city": "Tromsø"
        },
        "expected": "\"Tromsø\""
      }
    ]
  },
  {
    "title": "What comes out?",
    "statement": "Type what jq prints for this input and this filter.\n\nType it exactly as jq would print it.",
    "mode": "predict",
    "show_filter": true,
    "reference": ".pages",
    "tests": [
      {
        "input": {
          "title": "Dune",
          "pages": 412,
          "author": "Frank Herbert"
