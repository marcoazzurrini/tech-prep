[
  {
    "title": "One product row",
    "statement": "Print one CSV line for the product: its `sku`, its `name` and its `price`, in that order.\n\nThis task runs jq with `-r`. The filter below prints a row with only the `sku`. Add the other two values to the array.",
    "flags": [
      "-r"
    ],
    "stub": "[.sku] | @csv",
    "reference": "[.sku, .name, .price] | @csv",
    "tests": [
      {
        "input": {
          "sku": "MUG-01",
          "name": "Blue mug",
          "price": 12.5,
          "stock": 40
        },
        "expected": "\"MUG-01\",\"Blue mug\",12.5"
      },
      {
        "input": {
          "sku": "PEN-07",
          "name": "Gel pen, black",
          "price": 2,
          "stock": 310
        },
        "expected": "\"PEN-07\",\"Gel pen, black\",2"
      },
      {
        "input": {
          "sku": "BAG-22",
          "name": "Tote bag",
          "price": 18.9,
          "stock": 0
        },
        "expected": "\"BAG-22\",\"Tote bag\",18.9"
      }
    ]
  },
  {
    "title": "Fix the filter",
    "statement": "Print one CSV line for each task: its `id`, its `title` and its `done` value, in that order.\n\nThis task runs jq with `-r`. The filter below stops with an error, because it gives `@csv` an object. Add the step that builds a row from each task.",
    "flags": [
      "-r"
    ],
    "stub": ".[] | @csv",
    "reference": ".[] | [.id, .title, .done] | @csv",
    "tests": [
      {
        "input": [
          {
            "id": 1,
            "title": "Write the docs",
            "done": true
          },
          {
            "id": 2,
            "title": "Ship v2",
            "done": false
          }
        ],
        "expected": "1,\"Write the docs\",true\n2,\"Ship v2\",false"
      },
      {
        "input": [
          {
            "id": 14,
            "title": "Renew the domain",
            "done": false
          }
        ],
        "expected": "14,\"Renew the domain\",false"
      },
      {
        "input": [
          {
            "id": 5,
            "title": "Fix login",
            "done": true
          },
          {
            "id": 6,
            "title": "Add tests",
            "done": true
          },
          {
            "id": 9,
            "title": "Clean up, then tag",
            "done": false
          }
        ],
        "expected": "5,\"Fix login\",true\n6,\"Add tests\",true\n9,\"Clean up, then tag\",false"
      }
    ]
  },
