[
  {
    "title": "One ticket sold",
    "statement": "One ticket was sold. Print the whole event, with `seats_left` one lower.\n\nThe filter below does the sum, but it prints only the number. The rest of the event is lost. Fix it so that the whole event is printed.",
    "stub": ".seats_left | . - 1",
    "reference": ".seats_left |= . - 1",
    "tests": [
      {
        "input": {
          "event": "jq meetup",
          "city": "Oslo",
          "seats_left": 12
        },
        "expected": "{\n  \"event\": \"jq meetup\",\n  \"city\": \"Oslo\",\n  \"seats_left\": 11\n}"
      },
      {
        "input": {
          "event": "Go night",
          "city": "Bergen",
          "seats_left": 1
        },
        "expected": "{\n  \"event\": \"Go night\",\n  \"city\": \"Bergen\",\n  \"seats_left\": 0\n}"
      },
      {
        "input": {
          "event": "Rust day",
          "city": "Oslo",
          "seats_left": 80
        },
        "expected": "{\n  \"event\": \"Rust day\",\n  \"city\": \"Oslo\",\n  \"seats_left\": 79\n}"
      }
    ]
  },
  {
    "title": "The order is shipped",
    "statement": "The order was shipped. Print the whole order, with `status` set to `\"shipped\"`.\n\nUse `=` to set the new value. Everything else in the order stays as it is.",
    "reference": ".status = \"shipped\"",
    "tests": [
      {
        "input": {
          "order": 5001,
          "status": "paid",
          "items": [
            "mug",
            "pen"
          ]
        },
        "expected": "{\n  \"order\": 5001,\n  \"status\": \"shipped\",\n  \"items\": [\n    \"mug\",\n    \"pen\"\n  ]\n}"
      },
      {
        "input": {
          "order": 5002,
          "status": "packed",
          "items": [
            "desk"
          ]
        },
        "expected": "{\n  \"order\": 5002,\n  \"status\": \"shipped\",\n  \"items\": [\n    \"desk\"\n  ]\n}"
      },
      {
        "input": {
          "order": 5003,
          "status": "paid",
          "items": []
        },
        "expected": "{\n  \"order\": 5003,\n  \"status\": \"shipped\",\n  \"items\": []\n}"
      }
    ]
  },
  {
    "title": "Prices in cents",
    "statement": "The prices in the cart are in euros. Print the whole cart, with every price in cents.\n\nOne euro is 100 cents, so multiply every item of `prices` by 100. Use `|=` with `map`, so that `customer` and `coupon` stay in the output.",
    "reference": ".prices |= map(. * 100)",
    "tests": [
      {
        "input": {
          "customer": "bo@example.com",
          "coupon": "SPRING",
          "prices": [
            4,
            15,
            2
          ]
        },
        "expected": "{\n  \"customer\": \"bo@example.com\",\n  \"coupon\": \"SPRING\",\n  \"prices\": [\n    400,\n    1500,\n    200\n  ]\n}"
      },
      {
        "input": {
          "customer": "cy@example.com",
          "coupon": null,
          "prices": [
            30
          ]
        },
        "expected": "{\n  \"customer\": \"cy@example.com\",\n  \"coupon\": null,\n  \"prices\": [\n    3000\n  ]\n}"
      },
      {
        "input": {
          "customer": "dee@example.com",
          "coupon": "VIP",
          "prices": []
        },
        "expected": "{\n  \"customer\": \"dee@example.com\",\n  \"coupon\": \"VIP\",\n  \"prices\": []\n}"
      }
    ]
  }
]
