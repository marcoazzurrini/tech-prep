[
  {
    "title": "Move to production",
    "statement": "Print the host of the service with `staging` replaced by `prod`.\n\nThe first step takes `host`. The second step is `.`, which changes nothing. Replace the second step with `sub`.",
    "stub": ".host | .",
    "reference": ".host | sub(\"staging\"; \"prod\")",
    "tests": [
      {
        "input": {
          "service": "billing",
          "host": "billing.staging.example.com"
        },
        "expected": "\"billing.prod.example.com\""
      },
      {
        "input": {
          "service": "auth",
          "host": "auth.staging.example.com"
        },
        "expected": "\"auth.prod.example.com\""
      },
      {
        "input": {
          "service": "search",
          "host": "staging-search.example.com"
        },
        "expected": "\"prod-search.example.com\""
      }
    ]
  },
  {
    "title": "Name for a file",
    "statement": "Print the name of the document with every space replaced by `_`.\n\nThe filter below replaces only the first space. Change it so that it replaces every space.",
    "stub": ".doc | sub(\" \"; \"_\")",
    "reference": ".doc | gsub(\" \"; \"_\")",
    "tests": [
      {
        "input": {
          "doc": "Q3 sales report",
          "pages": 12
        },
        "expected": "\"Q3_sales_report\""
      },
      {
        "input": {
          "doc": "team offsite plan v2",
          "pages": 4
        },
        "expected": "\"team_offsite_plan_v2\""
      },
      {
        "input": {
          "doc": "notes from Monday",
          "pages": 1
        },
        "expected": "\"notes_from_Monday\""
      }
    ]
  },
  {
    "title": "Setting as a flag",
    "statement": "Print the name of the setting in small letters, with every `_` replaced by `-`.\n\nThe name is in `key`. For `DATABASE_URL`, print `database-url`.",
    "reference": ".key | ascii_downcase | gsub(\"_\"; \"-\")",
    "tests": [
      {
        "input": {
          "key": "DATABASE_URL",
          "value": "postgres://db-1/app"
        },
        "expected": "\"database-url\""
      },
      {
        "input": {
          "key": "MAX_RETRY_COUNT",
          "value": "5"
        },
        "expected": "\"max-retry-count\""
      },
      {
        "input": {
          "key": "DEBUG",
          "value": "false"
        },
        "expected": "\"debug\""
      }
    ]
  }
]
