[
  {
    "title": "Log messages",
    "statement": "Give the message of every log entry that has one.\n\nThe input is an array of log entries. Most entries are objects with a `msg` field. Some are plain strings: skip those. Print each `msg` as its own output. Use `.msg?`.",
    "reference": ".[] | .msg?",
    "tests": [
      {
        "input": [
          {
            "level": "info",
            "msg": "server started"
          },
          "---",
          {
            "level": "error",
            "msg": "disk full"
          }
        ],
        "expected": "\"server started\"\n\"disk full\""
      },
      {
        "input": [
          "---",
          "==="
        ],
        "expected": ""
      },
      {
        "input": [
          {
            "level": "warn",
            "msg": "slow query"
          }
        ],
        "expected": "\"slow query\""
      }
    ]
  },
  {
    "title": "Post tags",
    "statement": "Give every tag of the post as its own output.\n\nThe tags are in the `tags` array. Some posts have no `tags` field at all: print nothing for them. `.tags[]` alone stops with an error then. Use `.tags[]?`.",
    "reference": ".tags[]?",
    "tests": [
      {
        "input": {
          "title": "Hello jq",
          "tags": [
            "json",
            "cli"
          ]
        },
        "expected": "\"json\"\n\"cli\""
      },
      {
        "input": {
          "title": "Untitled"
        },
        "expected": ""
      },
      {
        "input": {
          "title": "Shell tips",
          "tags": [
            "bash"
          ]
        },
        "expected": "\"bash\""
      }
    ]
  },
  {
    "title": "Issue labels",
    "statement": "Give every label of every issue.\n\nThe input is an array of issues. An issue has a `labels` array, but in some issues `labels` is `null`. Skip those issues. Print each label as its own output. First open the outer array, then open `labels` with a `?`.",
    "reference": ".[] | .labels[]?",
    "tests": [
      {
        "input": [
          {
            "id": 1,
            "labels": [
              "bug",
              "ui"
            ]
          },
          {
            "id": 2,
            "labels": null
          },
          {
            "id": 3,
            "labels": [
              "docs"
            ]
          }
        ],
        "expected": "\"bug\"\n\"ui\"\n\"docs\""
      },
      {
        "input": [
          {
            "id": 4,
            "labels": null
          }
        ],
        "expected": ""
      },
      {
        "input": [
          {
            "id": 5,
            "labels": [
              "bug"
            ]
          },
          {
            "id": 6,
            "labels": []
          }
        ],
        "expected": "\"bug\""
      }
    ]
  }
]
