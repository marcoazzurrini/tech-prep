[
  {
    "title": "Service ports",
    "statement": "Give the port of every service. When a service has no port, give `80`.\n\nThe input is an array of services. `port` is a number, or `null`, or it is missing. Print each port as its own output. Use `//`.",
    "reference": ".[] | .port // 80",
    "tests": [
      {
        "input": [
          {
            "name": "api",
            "port": 3000
          },
          {
            "name": "web"
          },
          {
            "name": "admin",
            "port": null
          },
          {
            "name": "db",
            "port": 5432
          }
        ],
        "expected": "3000\n80\n80\n5432"
      },
      {
        "input": [],
        "expected": ""
      },
      {
        "input": [
          {
            "name": "proxy"
          }
        ],
        "expected": "80"
      },
      {
        "input": [
          {
            "name": "cache",
            "port": 6379
          }
        ],
        "expected": "6379"
      }
    ]
  },
  {
    "title": "Display names",
    "statement": "Give the display name of every account, as one array.\n\nThe input is an array of accounts. The display name is the `nickname`. When there is no `nickname`, or it is `null`, the display name is the `login`. The right side of `//` can be another field.",
    "reference": "map(.nickname // .login)",
    "tests": [
      {
        "input": [
          {
            "login": "ada42",
            "nickname": "Ada"
          },
          {
            "login": "bo_dev"
          },
          {
            "login": "cy",
            "nickname": null
          }
        ],
        "expected": "[\n  \"Ada\",\n  \"bo_dev\",\n  \"cy\"\n]"
      },
      {
        "input": [],
        "expected": "[]"
      },
      {
        "input": [
          {
            "login": "dee",
            "nickname": "Dee D."
          }
        ],
        "expected": "[\n  \"Dee D.\"\n]"
      },
      {
        "input": [
          {
            "login": "eli_9"
          }
        ],
        "expected": "[\n  \"eli_9\"\n]"
      }
    ]
  },
  {
    "title": "How to reach customers",
    "statement": "Give one way to reach every customer.\n\nThe input is an array of customers. Give the `email`. When there is no email, give the `phone`. When there is no phone, give `\"none\"`. A missing field can also be `null`. Print each value as its own output. Chain `//` two times.",
    "reference": ".[] | .email // .phone // \"none\"",
    "tests": [
      {
        "input": [
          {
            "id": 1,
            "email": "ada@example.com",
            "phone": "555-0101"
          },
          {
            "id": 2,
            "phone": "555-0102"
          },
          {
            "id": 3
          },
          {
            "id": 4,
            "email": null,
            "phone": null
          }
        ],
        "expected": "\"ada@example.com\"\n\"555-0102\"\n\"none\"\n\"none\""
      },
      {
        "input": [],
        "expected": ""
      },
      {
        "input": [
          {
            "id": 5,
            "email": "bo@example.com"
          }
        ],
        "expected": "\"bo@example.com\""
      },
      {
        "input": [
          {
            "id": 6,
            "email": null,
            "phone": "555-0106"
          }
        ],
        "expected": "\"555-0106\""
      }
    ]
  }
]
