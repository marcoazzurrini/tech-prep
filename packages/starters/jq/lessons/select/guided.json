[
  {
    "title": "Builds that failed",
    "statement": "Print the builds that failed, each as its own output.\n\nThe command below prints the builds with the status `\"passed\"`. Change it so that it prints the builds with the status `\"failed\"`.",
    "stub": ".[] | select(.status == \"passed\")",
    "reference": ".[] | select(.status == \"failed\")",
    "tests": [
      {
        "input": [
          {
            "id": 301,
            "status": "passed"
          },
          {
            "id": 302,
            "status": "failed"
          },
          {
            "id": 303,
            "status": "running"
          },
          {
            "id": 304,
            "status": "failed"
          }
        ],
        "expected": "{\n  \"id\": 302,\n  \"status\": \"failed\"\n}\n{\n  \"id\": 304,\n  \"status\": \"failed\"\n}"
      },
      {
        "input": [
          {
            "id": 11,
            "status": "failed"
          },
          {
            "id": 12,
            "status": "passed"
          }
        ],
        "expected": "{\n  \"id\": 11,\n  \"status\": \"failed\"\n}"
      },
      {
        "input": [
          {
            "id": 70,
            "status": "running"
          },
          {
            "id": 71,
            "status": "passed"
          }
        ],
        "expected": ""
      }
    ]
  },
  {
    "title": "Sold out",
    "statement": "Print the products that are sold out, as one array.\n\nA product is sold out when its `stock` is `0`. The command below should do the job, but jq stops with an error. Read the error, then fix the filter.",
    "stub": "select(.stock == 0)",
    "reference": "map(select(.stock == 0))",
    "tests": [
      {
        "input": [
          {
            "sku": "pen-01",
            "stock": 14
          },
          {
            "sku": "pad-02",
            "stock": 0
          },
          {
            "sku": "ink-03",
            "stock": 0
          }
        ],
        "expected": "[\n  {\n    \"sku\": \"pad-02\",\n    \"stock\": 0\n  },\n  {\n    \"sku\": \"ink-03\",\n    \"stock\": 0\n  }\n]"
      },
      {
        "input": [
          {
            "sku": "mug-10",
            "stock": 3
          },
          {
            "sku": "cap-11",
            "stock": 8
          }
        ],
        "expected": "[]"
      },
      {
        "input": [
          {
            "sku": "bag-20",
            "stock": 0
          },
          {
            "sku": "hat-21",
            "stock": 5
          }
        ],
        "expected": "[\n  {\n    \"sku\": \"bag-20\",\n    \"stock\": 0\n  }\n]"
      }
    ]
  },
  {
    "title": "Hosts that are down",
    "statement": "Print the hosts of the servers that are down, as one array.\n\nA server is down when its `status` is `\"down\"`. The array holds only the host names, in the order of the input.",
    "reference": "[.[] | select(.status == \"down\") | .host]",
    "tests": [
      {
        "input": [
          {
            "host": "web-1",
            "status": "up"
          },
          {
            "host": "web-2",
            "status": "down"
          },
          {
            "host": "db-1",
            "status": "down"
          }
        ],
        "expected": "[\n  \"web-2\",\n  \"db-1\"\n]"
      },
      {
        "input": [
          {
            "host": "cache-1",
            "status": "up"
          }
        ],
        "expected": "[]"
      },
      {
        "input": [
          {
            "host": "mail-1",
            "status": "down"
          },
          {
            "host": "mail-2",
            "status": "up"
          }
        ],
        "expected": "[\n  \"mail-1\"\n]"
      }
    ]
  }
]
