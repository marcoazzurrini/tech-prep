{
  "title": "Builds that failed",
  "check": {
    "type": "command",
    "program": "jq",
    "compare": "json",
    "file": "data.json",
    "start": "jq '.[] | select(.status == \"passed\")' data.json",
    "reference": "jq '.[] | select(.status == \"failed\")' data.json",
    "tests": [
      {
        "input": [
          {
            "id": 301,
            "status": "passed"
          },
          {
            "id": 302,
            "status": "failed"
          },
          {
            "id": 303,
            "status": "running"
          },
          {
            "id": 304,
            "status": "failed"
          }
        ],
        "expected": "{\n  \"id\": 302,\n  \"status\": \"failed\"\n}\n{\n  \"id\": 304,\n  \"status\": \"failed\"\n}"
      },
      {
        "input": [
          {
            "id": 11,
            "status": "failed"
          },
          {
            "id": 12,
            "status": "passed"
          }
        ],
        "expected": "{\n  \"id\": 11,\n  \"status\": \"failed\"\n}"
      },
      {
        "input": [
          {
            "id": 70,
            "status": "running"
          },
          {
            "id": 71,
            "status": "passed"
          }
        ],
        "expected": ""
      }
    ]
  }
}
