[
  {
    "title": "Scripts as pairs",
    "statement": "Print the scripts of the package as an array of pairs.\n\nThe first step takes `scripts`. The second step is `.`, which changes nothing. Replace the second step with `to_entries`.",
    "stub": ".scripts | .",
    "reference": ".scripts | to_entries",
    "tests": [
      {
        "input": {
          "name": "my-app",
          "scripts": {
            "build": "tsc",
            "test": "vitest"
          }
        },
        "expected": "[\n  {\n    \"key\": \"build\",\n    \"value\": \"tsc\"\n  },\n  {\n    \"key\": \"test\",\n    \"value\": \"vitest\"\n  }\n]"
      },
      {
        "input": {
          "name": "site",
          "scripts": {
            "dev": "vite"
          }
        },
        "expected": "[\n  {\n    \"key\": \"dev\",\n    \"value\": \"vite\"\n  }\n]"
      },
      {
        "input": {
          "name": "lib",
          "scripts": {
            "lint": "eslint .",
            "format": "prettier -w .",
            "check": "tsc --noEmit"
          }
        },
        "expected": "[\n  {\n    \"key\": \"lint\",\n    \"value\": \"eslint .\"\n  },\n  {\n    \"key\": \"format\",\n    \"value\": \"prettier -w .\"\n  },\n  {\n    \"key\": \"check\",\n    \"value\": \"tsc --noEmit\"\n  }\n]"
      }
    ]
  },
  {
    "title": "Packages and versions",
    "statement": "Print the dependencies as an array of objects. Each object has `name` and `version`.\n\nThe filter below should do that, but jq stops with an error. Read the error, then fix the filter.",
    "stub": ".dependencies | map({name: .key, version: .value})",
    "reference": ".dependencies | to_entries | map({name: .key, version: .value})",
    "tests": [
      {
        "input": {
          "name": "shop",
          "dependencies": {
            "react": "19.0.0",
            "zod": "3.24.1"
          }
        },
        "expected": "[\n  {\n    \"name\": \"react\",\n    \"version\": \"19.0.0\"\n  },\n  {\n    \"name\": \"zod\",\n    \"version\": \"3.24.1\"\n  }\n]"
      },
      {
        "input": {
          "name": "cli",
          "dependencies": {
            "yargs": "17.7.2"
          }
        },
        "expected": "[\n  {\n    \"name\": \"yargs\",\n    \"version\": \"17.7.2\"\n  }\n]"
      },
      {
        "input": {
          "name": "api",
          "dependencies": {
            "hono": "4.6.3",
            "pg": "8.13.0",
            "pino": "9.5.0"
          }
        },
        "expected": "[\n  {\n    \"name\": \"hono\",\n    \"version\": \"4.6.3\"\n  },\n  {\n    \"name\": \"pg\",\n    \"version\": \"8.13.0\"\n  },\n  {\n    \"name\": \"pino\",\n    \"version\": \"9.5.0\"\n  }\n]"
      }
    ]
  },
  {
    "title": "Role of each user",
    "statement": "Print one object that gives the role of each user. Each `login` is a key, and the user's `role` is its value.\n\nThe input is an array of users. Use `map` to build an entry from each user, with `key` and `value`. Then join the entries with `from_entries`.",
    "reference": "map({key: .login, value: .role}) | from_entries",
    "tests": [
      {
        "input": [
          {
            "login": "kim",
            "role": "admin"
          },
          {
            "login": "lee",
            "role": "viewer"
          },
          {
            "login": "sam",
            "role": "editor"
          }
        ],
        "expected": "{\n  \"kim\": \"admin\",\n  \"lee\": \"viewer\",\n  \"sam\": \"editor\"\n}"
      },
      {
        "input": [
          {
            "login": "ana",
            "role": "owner"
          }
        ],
        "expected": "{\n  \"ana\": \"owner\"\n}"
      },
      {
        "input": [
          {
            "login": "uma",
            "role": "viewer"
          },
          {
            "login": "pat",
            "role": "viewer"
          }
        ],
        "expected": "{\n  \"uma\": \"viewer\",\n  \"pat\": \"viewer\"\n}"
      }
    ]
  }
]
