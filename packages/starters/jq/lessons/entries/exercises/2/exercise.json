{
  "title": "Packages and versions",
  "check": {
    "type": "command",
    "program": "jq",
    "compare": "json",
    "file": "data.json",
    "start": "jq '.dependencies | map({name: .key, version: .value})' data.json",
    "reference": "jq '.dependencies | to_entries | map({name: .key, version: .value})' data.json",
    "tests": [
      {
        "input": {
          "name": "shop",
          "dependencies": {
            "react": "19.0.0",
            "zod": "3.24.1"
          }
        },
        "expected": "[\n  {\n    \"name\": \"react\",\n    \"version\": \"19.0.0\"\n  },\n  {\n    \"name\": \"zod\",\n    \"version\": \"3.24.1\"\n  }\n]"
      },
      {
        "input": {
          "name": "cli",
          "dependencies": {
            "yargs": "17.7.2"
          }
        },
        "expected": "[\n  {\n    \"name\": \"yargs\",\n    \"version\": \"17.7.2\"\n  }\n]"
      },
      {
        "input": {
          "name": "api",
          "dependencies": {
            "hono": "4.6.3",
            "pg": "8.13.0",
            "pino": "9.5.0"
          }
        },
        "expected": "[\n  {\n    \"name\": \"hono\",\n    \"version\": \"4.6.3\"\n  },\n  {\n    \"name\": \"pg\",\n    \"version\": \"8.13.0\"\n  },\n  {\n    \"name\": \"pino\",\n    \"version\": \"9.5.0\"\n  }\n]"
      }
    ]
  }
}
