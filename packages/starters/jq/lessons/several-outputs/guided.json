[
  {
    "title": "Number and title",
    "statement": "Print the issue's number, and then its title, as two outputs.\n\nThe filter below prints only the number. Add a comma and a second filter.",
    "stub": ".number",
    "reference": ".number, .title",
    "tests": [
      {
        "input": {
          "number": 212,
          "title": "Login page is blank",
          "state": "open",
          "comments": 4
        },
        "expected": "212\n\"Login page is blank\""
      },
      {
        "input": {
          "number": 7,
          "title": "Add dark mode",
          "state": "closed",
          "comments": 19
        },
        "expected": "7\n\"Add dark mode\""
      },
      {
        "input": {
          "number": 1530,
          "title": "Typo in the docs",
          "state": "open",
          "comments": 0
        },
        "expected": "1530\n\"Typo in the docs\""
      }
    ]
  },
  {
    "title": "Fix the filter",
    "statement": "Print the login of the repo's owner, and then the repo's number of stars, as two outputs.\n\nThe filter below should do that, but it prints `null` in place of the stars. Look at where `stars` is in the input, and fix the filter.",
    "stub": ".owner | .login, .stars",
    "reference": ".owner.login, .stars",
    "tests": [
      {
        "input": {
          "name": "atlas",
          "stars": 318,
          "owner": {
            "login": "mira",
            "id": 4821
          }
        },
        "expected": "\"mira\"\n318"
      },
      {
        "input": {
          "name": "notes",
          "stars": 0,
          "owner": {
            "login": "tomas",
            "id": 17
          }
        },
        "expected": "\"tomas\"\n0"
      },
      {
        "input": {
          "name": "router",
          "stars": 12950,
          "owner": {
            "login": "core-team",
            "id": 2
          }
        },
        "expected": "\"core-team\"\n12950"
      }
    ]
  },
  {
    "title": "Host and port",
    "statement": "For each server, print its host and then its port.\n\nEach value is its own output. Two servers give four outputs: host, port, host, port.",
    "reference": ".[] | .host, .port",
    "tests": [
      {
        "input": [
          {
            "host": "web-1",
            "port": 443,
            "region": "eu"
          },
          {
            "host": "db-1",
            "port": 5432,
            "region": "eu"
          }
        ],
        "expected": "\"web-1\"\n443\n\"db-1\"\n5432"
      },
      {
        "input": [
          {
            "host": "cache-1",
            "port": 6379,
            "region": "us"
          }
        ],
        "expected": "\"cache-1\"\n6379"
      },
      {
        "input": [
          {
            "host": "mq-1",
            "port": 5672,
            "region": "ap"
          },
          {
            "host": "web-2",
            "port": 8443,
            "region": "us"
          },
          {
            "host": "web-3",
            "port": 8443,
            "region": "us"
          }
        ],
        "expected": "\"mq-1\"\n5672\n\"web-2\"\n8443\n\"web-3\"\n8443"
      }
    ]
  }
]
