[
  {
    "title": "Region of each server",
    "statement": "Print every server as its own output, with its `host` and the `region` of the whole group.\n\nThe command below stores the region in the variable `$region`, but it never uses it. So it prints `null` for the region. Fix the last step.",
    "stub": ".region as $region | .servers[] | {host, region: .region}",
    "reference": ".region as $region | .servers[] | {host, region: $region}",
    "tests": [
      {
        "input": {
          "region": "eu-west",
          "servers": [
            {
              "host": "web-1",
              "cpu": 4
            },
            {
              "host": "web-2",
              "cpu": 8
            }
          ]
        },
        "expected": "{\n  \"host\": \"web-1\",\n  \"region\": \"eu-west\"\n}\n{\n  \"host\": \"web-2\",\n  \"region\": \"eu-west\"\n}"
      },
      {
        "input": {
          "region": "us-east",
          "servers": [
            {
              "host": "db-1",
              "cpu": 16
            }
          ]
        },
        "expected": "{\n  \"host\": \"db-1\",\n  \"region\": \"us-east\"\n}"
      },
      {
        "input": {
          "region": "ap-south",
          "servers": [
            {
              "host": "cache-1",
              "cpu": 2
            },
            {
              "host": "cache-2",
              "cpu": 2
            },
            {
              "host": "cache-3",
              "cpu": 2
            }
          ]
        },
        "expected": "{\n  \"host\": \"cache-1\",\n  \"region\": \"ap-south\"\n}\n{\n  \"host\": \"cache-2\",\n  \"region\": \"ap-south\"\n}\n{\n  \"host\": \"cache-3\",\n  \"region\": \"ap-south\"\n}"
      }
    ]
  },
  {
    "title": "Tracks with their owner",
    "statement": "Print one array of the tracks. Each track becomes an object with its `title` and the `owner` of the playlist.\n\nFirst store `owner` in a variable with `as`. Then use `map` on `tracks`.",
    "reference": ".owner as $owner | .tracks | map({title, owner: $owner})",
    "tests": [
      {
        "input": {
          "owner": "ada",
          "tracks": [
            {
              "title": "Blue Hour",
              "seconds": 201
            },
            {
              "title": "Slow Train",
              "seconds": 185
            }
          ]
        },
        "expected": "[\n  {\n    \"title\": \"Blue Hour\",\n    \"owner\": \"ada\"\n  },\n  {\n    \"title\": \"Slow Train\",\n    \"owner\": \"ada\"\n  }\n]"
      },
      {
        "input": {
          "owner": "bo",
          "tracks": [
            {
              "title": "Night Bus",
              "seconds": 240
            }
          ]
        },
        "expected": "[\n  {\n    \"title\": \"Night Bus\",\n    \"owner\": \"bo\"\n  }\n]"
      },
      {
        "input": {
          "owner": "cy",
          "tracks": []
        },
        "expected": "[]"
      }
    ]
  },
  {
    "title": "Branches of every repo",
    "statement": "Print one object for each branch, each as its own output. The object has the keys `repo` and `branch`.\n\nThe input is an array of repos. Each one has a name under `repo` and a list of `branches`. Keep the name of the repo in a variable before you go into its branches.",
    "reference": ".[] | .repo as $repo | .branches[] | {repo: $repo, branch: .}",
    "tests": [
      {
        "input": [
          {
            "repo": "api",
            "branches": [
              "main",
              "dev"
            ]
          },
          {
            "repo": "web",
            "branches": [
              "main"
            ]
          }
        ],
        "expected": "{\n  \"repo\": \"api\",\n  \"branch\": \"main\"\n}\n{\n  \"repo\": \"api\",\n  \"branch\": \"dev\"\n}\n{\n  \"repo\": \"web\",\n  \"branch\": \"main\"\n}"
      },
      {
        "input": [
          {
            "repo": "docs",
            "branches": [
              "main",
              "v2",
              "draft"
            ]
          }
        ],
        "expected": "{\n  \"repo\": \"docs\",\n  \"branch\": \"main\"\n}\n{\n  \"repo\": \"docs\",\n  \"branch\": \"v2\"\n}\n{\n  \"repo\": \"docs\",\n  \"branch\": \"draft\"\n}"
      },
      {
        "input": [
          {
            "repo": "cli",
            "branches": []
          },
          {
            "repo": "jobs",
            "branches": [
              "main",
              "fix-retry"
            ]
          }
        ],
        "expected": "{\n  \"repo\": \"jobs\",\n  \"branch\": \"main\"\n}\n{\n  \"repo\": \"jobs\",\n  \"branch\": \"fix-retry\"\n}"
      }
    ]
  }
]
