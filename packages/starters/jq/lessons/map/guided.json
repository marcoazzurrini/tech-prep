[
  {
    "title": "Package names",
    "statement": "Give the name of every package, as one array.\n\nThe input is an array of packages. Each package has a `name` and a `version`. Use `map`. Keep the order.",
    "reference": "map(.name)",
    "tests": [
      {
        "input": [
          {
            "name": "react",
            "version": "18.2.0"
          },
          {
            "name": "zod",
            "version": "3.22.4"
          },
          {
            "name": "vite",
            "version": "5.0.0"
          }
        ],
        "expected": "[\n  \"react\",\n  \"zod\",\n  \"vite\"\n]"
      },
      {
        "input": [],
        "expected": "[]"
      },
      {
        "input": [
          {
            "name": "lodash",
            "version": "4.17.21"
          }
        ],
        "expected": "[\n  \"lodash\"\n]"
      },
      {
        "input": [
          {
            "name": "zod",
            "version": "3.0.0"
          },
          {
            "name": "zod",
            "version": "3.22.4"
          }
        ],
        "expected": "[\n  \"zod\",\n  \"zod\"\n]"
      }
    ]
  },
  {
    "title": "Server addresses",
    "statement": "Give the address of every server, as one array of strings.\n\nThe input is an array of servers. Each server has a `host` and a `port`. An address is the host, then `:`, then the port, for example `\"db.example.com:5432\"`. Build each string with `\\( )` inside `map`.",
    "reference": "map(\"\\(.host):\\(.port)\")",
    "tests": [
      {
        "input": [
          {
            "host": "db.example.com",
            "port": 5432
          },
          {
            "host": "web.example.com",
            "port": 443
          }
        ],
        "expected": "[\n  \"db.example.com:5432\",\n  \"web.example.com:443\"\n]"
      },
      {
        "input": [],
        "expected": "[]"
      },
      {
        "input": [
          {
            "host": "cache.example.com",
            "port": 6379
          }
        ],
        "expected": "[\n  \"cache.example.com:6379\"\n]"
      },
      {
        "input": [
          {
            "host": "a.example.com",
            "port": 80
          },
          {
            "host": "a.example.com",
            "port": 8080
          }
        ],
        "expected": "[\n  \"a.example.com:80\",\n  \"a.example.com:8080\"\n]"
      }
    ]
  },
  {
    "title": "Short commits",
    "statement": "Give a short form of every commit, as one array.\n\nThe commits are in the `commits` array. Go to that array first, then use `map`. Each short commit is an object with two keys: `sha`, and `author` with the author's name. The name is in `author.name`.",
    "reference": ".commits | map({sha, author: .author.name})",
    "tests": [
      {
        "input": {
          "repo": "shop-api",
          "commits": [
            {
              "sha": "a1f3",
              "message": "Fix login",
              "author": {
                "name": "Ada",
                "email": "ada@example.com"
              }
            },
            {
              "sha": "c94e",
              "message": "Add tests",
              "author": {
                "name": "Bo",
                "email": "bo@example.com"
              }
            }
          ]
        },
        "expected": "[\n  {\n    \"sha\": \"a1f3\",\n    \"author\": \"Ada\"\n  },\n  {\n    \"sha\": \"c94e\",\n    \"author\": \"Bo\"\n  }\n]"
      },
      {
        "input": {
          "repo": "docs",
          "commits": []
        },
        "expected": "[]"
      },
      {
        "input": {
          "repo": "cli",
          "commits": [
            {
              "sha": "77b0",
              "message": "First commit",
              "author": {
                "name": "Cy",
                "email": "cy@example.com"
              }
            }
          ]
        },
        "expected": "[\n  {\n    \"sha\": \"77b0\",\n    \"author\": \"Cy\"\n  }\n]"
      }
    ]
  }
]
