[
  {
    "title": "Versions of the releases",
    "statement": "Print the version of every release, as one array.\n\nThe command below runs `.` on every item, so it changes nothing. Replace the `.` inside the round brackets so that the array holds only the versions.",
    "stub": "map(.)",
    "reference": "map(.version)",
    "tests": [
      {
        "input": [
          {
            "version": "1.4.0",
            "date": "2025-01-10"
          },
          {
            "version": "1.4.1",
            "date": "2025-02-02"
          },
          {
            "version": "2.0.0",
            "date": "2025-03-18"
          }
        ],
        "expected": "[\n  \"1.4.0\",\n  \"1.4.1\",\n  \"2.0.0\"\n]"
      },
      {
        "input": [
          {
            "version": "0.1.0",
            "date": "2024-11-05"
          }
        ],
        "expected": "[\n  \"0.1.0\"\n]"
      },
      {
        "input": [
          {
            "version": "3.2.0",
            "date": "2025-04-01"
          },
          {
            "version": "3.2.1",
            "date": "2025-04-09"
          }
        ],
        "expected": "[\n  \"3.2.0\",\n  \"3.2.1\"\n]"
      }
    ]
  },
  {
    "title": "Size of each team",
    "statement": "Print how many members each team has, as one array.\n\nUse `map`. Inside the round brackets, take the `members` of one team and hand them to `length`.",
    "reference": "map(.members | length)",
    "tests": [
      {
        "input": [
          {
            "team": "core",
            "members": [
              "ada",
              "bo",
              "cy"
            ]
          },
          {
            "team": "ops",
            "members": [
              "dee"
            ]
          }
        ],
        "expected": "[\n  3,\n  1\n]"
      },
      {
        "input": [
          {
            "team": "data",
            "members": []
          },
          {
            "team": "web",
            "members": [
              "eli",
              "fay"
            ]
          },
          {
            "team": "qa",
            "members": [
              "gus"
            ]
          }
        ],
        "expected": "[\n  0,\n  2,\n  1\n]"
      },
      {
        "input": [
          {
            "team": "all",
            "members": [
              "ada",
              "bo",
              "cy",
              "dee",
              "eli"
            ]
          }
        ],
        "expected": "[\n  5\n]"
      }
    ]
  },
  {
    "title": "Titles of the tracks",
    "statement": "Print the title of every track in the playlist, as one array.\n\nThe tracks are under `tracks`. Keep the order of the input.",
    "reference": ".tracks | map(.title)",
    "tests": [
      {
        "input": {
          "playlist": "Focus",
          "tracks": [
            {
              "title": "Low Tide",
              "seconds": 214
            },
            {
              "title": "Paper Boats",
              "seconds": 187
            }
          ]
        },
        "expected": "[\n  \"Low Tide\",\n  \"Paper Boats\"\n]"
      },
      {
        "input": {
          "playlist": "Run",
          "tracks": [
            {
              "title": "Start Line",
              "seconds": 201
            },
            {
              "title": "Hill",
              "seconds": 240
            },
            {
              "title": "Last Lap",
              "seconds": 176
            }
          ]
        },
        "expected": "[\n  \"Start Line\",\n  \"Hill\",\n  \"Last Lap\"\n]"
      },
      {
        "input": {
          "playlist": "New",
          "tracks": []
        },
        "expected": "[]"
      }
    ]
  }
]
