[
  {
    "title": "Next job",
    "statement": "Give the first job in the queue.\n\nThe input is an array of job names. The next job is the first item. Use `.[0]`.",
    "reference": ".[0]",
    "tests": [
      {
        "input": [
          "resize-images",
          "send-mail",
          "backup"
        ],
        "expected": "\"resize-images\""
      },
      {
        "input": [
          "backup"
        ],
        "expected": "\"backup\""
      },
      {
        "input": [
          "send-mail",
          "resize-images"
        ],
        "expected": "\"send-mail\""
      },
      {
        "input": [],
        "expected": "null"
      }
    ]
  },
  {
    "title": "Top three scores",
    "statement": "Give the first three scores.\n\nThe input is an array of scores, highest first. Give an array back. Use a slice. When there are fewer than three scores, the slice gives all of them.",
    "reference": ".[:3]",
    "tests": [
      {
        "input": [
          98,
          91,
          87,
          70,
          64
        ],
        "expected": "[\n  98,\n  91,\n  87\n]"
      },
      {
        "input": [
          55,
          40
        ],
        "expected": "[\n  55,\n  40\n]"
      },
      {
        "input": [
          80,
          79,
          78,
          77
        ],
        "expected": "[\n  80,\n  79,\n  78\n]"
      },
      {
        "input": [],
        "expected": "[]"
      }
    ]
  },
  {
    "title": "First product name",
    "statement": "Give the name of the first product in the cart.\n\nThe products are in the `items` array. Pick the first item, then read its `name`: `.items[0].name`.",
    "reference": ".items[0].name",
    "tests": [
      {
        "input": {
          "cart": 9,
          "items": [
            {
              "name": "pen",
              "qty": 2
            },
            {
              "name": "pad",
              "qty": 1
            }
          ]
        },
        "expected": "\"pen\""
      },
      {
        "input": {
          "cart": 10,
          "items": [
            {
              "name": "mug",
              "qty": 1
            }
          ]
        },
        "expected": "\"mug\""
      },
      {
        "input": {
          "cart": 11,
          "items": [
            {
              "name": "ink",
              "qty": 4
            },
            {
              "name": "pen",
              "qty": 1
            },
            {
              "name": "cap",
              "qty": 1
            }
          ]
        },
        "expected": "\"ink\""
      }
    ]
  }
]
