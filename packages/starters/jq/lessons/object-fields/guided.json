[
  {
    "title": "Port of a server",
    "statement": "Print the port of the server.",
    "reference": ".port",
    "tests": [
      {
        "input": {
          "host": "web-1",
          "port": 443,
          "secure": true
        },
        "expected": "443"
      },
      {
        "input": {
          "host": "db-1",
          "port": 5432,
          "secure": false
        },
        "expected": "5432"
      },
      {
        "input": {
          "host": "cache-1",
          "port": 6379,
          "secure": false
        },
        "expected": "6379"
      }
    ]
  },
  {
    "title": "Fix the filter",
    "statement": "Print the user's email.\n\nThe filter below should do that, but it prints `null`. Find the mistake and fix it.",
    "stub": ".Email",
    "reference": ".email",
    "tests": [
      {
        "input": {
          "name": "Bo",
          "email": "bo@example.com"
        },
        "expected": "\"bo@example.com\""
      },
      {
        "input": {
          "name": "Cy",
          "email": "cy@example.com"
        },
        "expected": "\"cy@example.com\""
      },
      {
        "input": {
          "name": "Dee",
          "email": "dee@example.com"
        },
        "expected": "\"dee@example.com\""
      }
    ]
  },
  {
    "title": "A key with a dash",
    "statement": "Print the user's id.\n\nLook at the key in the input. It has a dash in it.",
    "reference": ".[\"user-id\"]",
    "tests": [
      {
        "input": {
          "user-id": 42,
          "plan": "pro"
        },
        "expected": "42"
      },
      {
        "input": {
          "user-id": 7,
          "plan": "free"
        },
        "expected": "7"
      },
      {
        "input": {
          "user-id": 1203,
          "plan": "team"
        },
        "expected": "1203"
      }
    ]
  }
]
