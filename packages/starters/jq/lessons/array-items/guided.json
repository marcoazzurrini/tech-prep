[
  {
    "title": "Second step",
    "statement": "Print the second step of the pipeline.",
    "reference": ".[1]",
    "tests": [
      {
        "input": [
          "build",
          "test",
          "deploy"
        ],
        "expected": "\"test\""
      },
      {
        "input": [
          "lint",
          "unit",
          "e2e",
          "release"
        ],
        "expected": "\"unit\""
      },
      {
        "input": [
          "fetch",
          "compile"
        ],
        "expected": "\"compile\""
      }
    ]
  },
  {
    "title": "Last number",
    "statement": "Print the last number of the list.\n\nThe list can have any length.",
    "reference": ".[-1]",
    "tests": [
      {
        "input": [
          3,
          8,
          5,
          13
        ],
        "expected": "13"
      },
      {
        "input": [
          21,
          34
        ],
        "expected": "34"
      },
      {
        "input": [
          1,
          1,
          2,
          3,
          5,
          8
        ],
        "expected": "8"
      }
    ]
  },
  {
    "title": "Author of the first commit",
    "statement": "Print the author of the first commit.",
    "reference": ".commits[0].author",
    "tests": [
      {
        "input": {
          "repo": "api",
          "commits": [
            {
              "sha": "9f2c1a",
              "author": "cy"
            },
            {
              "sha": "77b0de",
              "author": "ada"
            }
          ]
        },
        "expected": "\"cy\""
      },
      {
        "input": {
          "repo": "web",
          "commits": [
            {
              "sha": "c41e09",
              "author": "bo"
            }
          ]
        },
        "expected": "\"bo\""
      },
      {
        "input": {
          "repo": "docs",
          "commits": [
            {
              "sha": "0aa1f3",
              "author": "dee"
            },
            {
              "sha": "5be2c7",
              "author": "cy"
            },
            {
              "sha": "e09d41",
              "author": "ada"
            }
          ]
        },
        "expected": "\"dee\""
      }
    ]
  },
  {
    "title": "Top three scores",
    "statement": "Print the first three scores, as an array.",
    "reference": ".[:3]",
    "tests": [
      {
        "input": [
          98,
          91,
          87,
          70,
          64
        ],
        "expected": "[\n  98,\n  91,\n  87\n]"
      },
      {
        "input": [
          55,
          40,
          39,
          12
        ],
        "expected": "[\n  55,\n  40,\n  39\n]"
      },
      {
        "input": [
          100,
          99,
          98,
          97,
          96,
          95
        ],
        "expected": "[\n  100,\n  99,\n  98\n]"
      }
    ]
  }
]
