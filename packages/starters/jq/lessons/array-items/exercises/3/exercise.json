{
  "title": "Author of the first commit",
  "check": {
    "type": "command",
    "program": "jq",
    "compare": "json",
    "file": "data.json",
    "reference": "jq '.commits[0].author' data.json",
    "tests": [
      {
        "input": {
          "repo": "api",
          "commits": [
            {
              "sha": "9f2c1a",
              "author": "cy"
            },
            {
              "sha": "77b0de",
              "author": "ada"
            }
          ]
        },
        "expected": "\"cy\""
      },
      {
        "input": {
          "repo": "web",
          "commits": [
            {
              "sha": "c41e09",
              "author": "bo"
            }
          ]
        },
        "expected": "\"bo\""
      },
      {
        "input": {
          "repo": "docs",
          "commits": [
            {
              "sha": "0aa1f3",
              "author": "dee"
            },
            {
              "sha": "5be2c7",
              "author": "cy"
            },
            {
              "sha": "e09d41",
              "author": "ada"
            }
          ]
        },
        "expected": "\"dee\""
      }
    ]
  }
}
