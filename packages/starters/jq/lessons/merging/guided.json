[
  {
    "title": "Total of the invoice",
    "statement": "Print the total of the invoice: the subtotal plus the shipping.\n\nThe command below prints only the subtotal. Change it so that it adds `shipping` to it. The output is one number.",
    "stub": ".subtotal",
    "reference": ".subtotal + .shipping",
    "tests": [
      {
        "input": {
          "invoice": "INV-104",
          "subtotal": 80,
          "shipping": 5
        },
        "expected": "85"
      },
      {
        "input": {
          "invoice": "INV-105",
          "subtotal": 240,
          "shipping": 0
        },
        "expected": "240"
      },
      {
        "input": {
          "invoice": "INV-106",
          "subtotal": 19,
          "shipping": 12
        },
        "expected": "31"
      }
    ]
  },
  {
    "title": "One more label",
    "statement": "Print the labels of the ticket, with `\"urgent\"` added at the end.\n\nThe command below should do that, but jq stops with an error. Read the error, then fix the filter. The output is one array.",
    "stub": ".labels + \"urgent\"",
    "reference": ".labels + [\"urgent\"]",
    "tests": [
      {
        "input": {
          "ticket": 311,
          "labels": [
            "bug",
            "login"
          ]
        },
        "expected": "[\n  \"bug\",\n  \"login\",\n  \"urgent\"\n]"
      },
      {
        "input": {
          "ticket": 312,
          "labels": []
        },
        "expected": "[\n  \"urgent\"\n]"
      },
      {
        "input": {
          "ticket": 313,
          "labels": [
            "docs"
          ]
        },
        "expected": "[\n  \"docs\",\n  \"urgent\"\n]"
      }
    ]
  },
  {
    "title": "Settings of the editor",
    "statement": "Print the settings the editor will use: the defaults, with the user's own settings laid over them.\n\nMerge `defaults` and `user` with `+`. When both have the same key, the value from `user` must win. The output is one object.",
    "reference": ".defaults + .user",
    "tests": [
      {
        "input": {
          "defaults": {
            "theme": "light",
            "font_size": 12,
            "wrap": true
          },
          "user": {
            "theme": "dark"
          }
        },
        "expected": "{\n  \"theme\": \"dark\",\n  \"font_size\": 12,\n  \"wrap\": true\n}"
      },
      {
        "input": {
          "defaults": {
            "theme": "light",
            "font_size": 12
          },
          "user": {}
        },
        "expected": "{\n  \"theme\": \"light\",\n  \"font_size\": 12\n}"
      },
      {
        "input": {
          "defaults": {
            "theme": "light"
          },
          "user": {
            "font_size": 18,
            "theme": "sepia"
          }
        },
        "expected": "{\n  \"theme\": \"sepia\",\n  \"font_size\": 18\n}"
      }
    ]
  }
]
