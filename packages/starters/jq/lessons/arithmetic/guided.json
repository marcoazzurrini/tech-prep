[
  {
    "title": "A trip by car",
    "statement": "Give the route of a trip and its distance.\n\nThe input is one trip. Give one object with two keys. `route` is the `from` town, then ` to `, then the `to` town, for example `\"Pisa to Rome\"`. `km` is `end_km` minus `start_km`. Join the strings with `+`.",
    "reference": "{route: (.from + \" to \" + .to), km: (.end_km - .start_km)}",
    "tests": [
      {
        "input": {
          "from": "Pisa",
          "to": "Rome",
          "start_km": 12040,
          "end_km": 12395
        },
        "expected": "{\n  \"route\": \"Pisa to Rome\",\n  \"km\": 355\n}"
      },
      {
        "input": {
          "from": "Lyon",
          "to": "Nice",
          "start_km": 500,
          "end_km": 970
        },
        "expected": "{\n  \"route\": \"Lyon to Nice\",\n  \"km\": 470\n}"
      },
      {
        "input": {
          "from": "Bonn",
          "to": "Bonn",
          "start_km": 88,
          "end_km": 88
        },
        "expected": "{\n  \"route\": \"Bonn to Bonn\",\n  \"km\": 0\n}"
      }
    ]
  },
  {
    "title": "All the reviewers",
    "statement": "Give every reviewer of a pull request, as one array.\n\nThe input has two arrays of names: `required` and `optional`. Put the required reviewers first, then the optional ones. `+` joins two arrays.",
    "reference": ".required + .optional",
    "tests": [
      {
        "input": {
          "pr": 214,
          "required": [
            "ada",
            "bo"
          ],
          "optional": [
            "cy"
          ]
        },
        "expected": "[\n  \"ada\",\n  \"bo\",\n  \"cy\"\n]"
      },
      {
        "input": {
          "pr": 215,
          "required": [],
          "optional": []
        },
        "expected": "[]"
      },
      {
        "input": {
          "pr": 216,
          "required": [
            "dee"
          ],
          "optional": []
        },
        "expected": "[\n  \"dee\"\n]"
      },
      {
        "input": {
          "pr": 217,
          "required": [],
          "optional": [
            "eli",
            "ada"
          ]
        },
        "expected": "[\n  \"eli\",\n  \"ada\"\n]"
      }
    ]
  },
  {
    "title": "Cost of each line",
    "statement": "Give the cost of every line of an invoice, as one array of numbers.\n\nThe lines are in the `lines` array. The cost of a line is its `price` times its `qty`. Use `*` inside `map`.",
    "reference": ".lines | map(.price * .qty)",
    "tests": [
      {
        "input": {
          "invoice": "INV-7",
          "lines": [
            {
              "item": "pen",
              "price": 2,
              "qty": 10
            },
            {
              "item": "desk",
              "price": 150,
              "qty": 1
            },
            {
              "item": "lamp",
              "price": 30,
              "qty": 0
            }
          ]
        },
        "expected": "[\n  20,\n  150,\n  0\n]"
      },
      {
        "input": {
          "invoice": "INV-8",
          "lines": []
        },
        "expected": "[]"
      },
      {
        "input": {
          "invoice": "INV-9",
          "lines": [
            {
              "item": "chair",
              "price": 45,
              "qty": 4
            }
          ]
        },
        "expected": "[\n  180\n]"
      }
    ]
  }
]
