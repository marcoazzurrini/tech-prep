[
  {
    "title": "Hide the API key",
    "statement": "Print the whole service, without its `api_key`.\n\nThe command below removes `region`. Change it so that it removes `api_key`, and `region` stays.",
    "stub": "del(.region)",
    "reference": "del(.api_key)",
    "tests": [
      {
        "input": {
          "service": "mailer",
          "region": "eu-north",
          "api_key": "k-55f0"
        },
        "expected": "{\n  \"service\": \"mailer\",\n  \"region\": \"eu-north\"\n}"
      },
      {
        "input": {
          "service": "search",
          "region": "us-east",
          "api_key": "k-a91c"
        },
        "expected": "{\n  \"service\": \"search\",\n  \"region\": \"us-east\"\n}"
      },
      {
        "input": {
          "service": "cache",
          "region": "eu-west"
        },
        "expected": "{\n  \"service\": \"cache\",\n  \"region\": \"eu-west\"\n}"
      }
    ]
  },
  {
    "title": "What comes out?",
    "statement": "Type what jq prints for this input and this command.\n\nYou may type it on one line. Spaces and line breaks do not matter.",
    "mode": "predict",
    "show_filter": true,
    "reference": "del(.queue[0])",
    "tests": [
      {
        "input": {
          "queue": [
            "a",
            "b",
            "c"
          ],
          "open": true
        },
        "expected": "{\n  \"queue\": [\n    \"b\",\n    \"c\"\n  ],\n  \"open\": true\n}"
      }
    ]
  },
  {
    "title": "A list without emails",
    "statement": "Print the list of customers, without the `email` of any customer.\n\nThe input is an array of objects. Remove `email` from every item with `map` and `del`. The output is one array.",
    "reference": "map(del(.email))",
    "tests": [
      {
        "input": [
          {
            "id": 1,
            "name": "Ada",
            "email": "ada@example.com"
          },
          {
            "id": 2,
            "name": "Bo",
            "email": "bo@example.com"
          }
        ],
        "expected": "[\n  {\n    \"id\": 1,\n    \"name\": \"Ada\"\n  },\n  {\n    \"id\": 2,\n    \"name\": \"Bo\"\n  }\n]"
      },
      {
        "input": [
          {
            "id": 7,
            "name": "Cy"
          }
        ],
        "expected": "[\n  {\n    \"id\": 7,\n    \"name\": \"Cy\"\n  }\n]"
      },
      {
        "input": [],
        "expected": "[]"
      }
    ]
  }
]
