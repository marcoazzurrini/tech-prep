{
  "title": "Fix the order search",
  "check": {
    "type": "command",
    "program": "jq",
    "compare": "text",
    "file": "data.json",
    "start": "jq --arg limit 50 '.[] | select(.total > $limit)' data.json",
    "reference": "jq --argjson limit 50 '.[] | select(.total > $limit)' data.json",
    "tests": [
      {
        "input": [
          {
            "id": 301,
            "total": 80
          },
          {
            "id": 302,
            "total": 20
          },
          {
            "id": 303,
            "total": 51
          }
        ],
        "expected": "{\n  \"id\": 301,\n  \"total\": 80\n}\n{\n  \"id\": 303,\n  \"total\": 51\n}"
      },
      {
        "input": [
          {
            "id": 11,
            "total": 50
          },
          {
            "id": 12,
            "total": 500
          }
        ],
        "expected": "{\n  \"id\": 12,\n  \"total\": 500\n}"
      },
      {
        "input": [
          {
            "id": 40,
            "total": 5
          },
          {
            "id": 41,
            "total": 49
          }
        ],
        "expected": ""
      }
    ]
  }
}
