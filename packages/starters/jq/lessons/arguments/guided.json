  {
    "title": "Servers of one env",
    "statement": "Print every server whose `env` equals the value passed to the command.\n\nThe command below passes `prod` under the name `env`. But the filter does not use it: it compares with the fixed text `\"dev\"`. Replace `\"dev\"` with the variable `$env`.",
    "mode": "command",
    "stub": "--arg env prod '.[] | select(.env == \"dev\")'",
    "reference": "--arg env prod '.[] | select(.env == $env)'",
    "tests": [
      {
        "input": [
          {
            "host": "web-1",
            "env": "prod"
          },
          {
            "host": "web-2",
            "env": "dev"
          },
          {
            "host": "db-1",
            "env": "prod"
          }
        ],
        "expected": "{\n  \"host\": \"web-1\",\n  \"env\": \"prod\"\n}\n{\n  \"host\": \"db-1\",\n  \"env\": \"prod\"\n}"
      },
      {
        "input": [
          {
            "host": "cache-1",
            "env": "dev"
          },
          {
            "host": "mq-1",
            "env": "prod"
          }
        ],
        "expected": "{\n  \"host\": \"mq-1\",\n  \"env\": \"prod\"\n}"
      },
      {
        "input": [
          {
            "host": "test-1",
            "env": "dev"
          },
          {
            "host": "test-2",
            "env": "staging"
          }
        ],
        "expected": ""
      }
    ]
  },
