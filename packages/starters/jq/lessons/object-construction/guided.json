[
  {
    "title": "Account summary",
    "statement": "Build an object with the keys `name` and `mail`.\n\nThe input is a user account. `name` is the user's `login`. `mail` is the user's `email`. Leave every other field out. Write `{name: ..., mail: ...}`.",
    "reference": "{name: .login, mail: .email}",
    "tests": [
      {
        "input": {
          "id": 7,
          "login": "ada",
          "email": "ada@example.com",
          "created": "2024-03-01"
        },
        "expected": "{\n  \"name\": \"ada\",\n  \"mail\": \"ada@example.com\"\n}"
      },
      {
        "input": {
          "id": 8,
          "login": "bo",
          "email": "bo@example.com",
          "created": "2025-01-15"
        },
        "expected": "{\n  \"name\": \"bo\",\n  \"mail\": \"bo@example.com\"\n}"
      },
      {
        "input": {
          "id": 9,
          "login": "cy",
          "email": null,
          "created": "2025-06-30"
        },
        "expected": "{\n  \"name\": \"cy\",\n  \"mail\": null\n}"
      }
    ]
  },
  {
    "title": "Package basics",
    "statement": "Keep only the `name` and the `version` of the package.\n\nThe input is a package file. Give an object with these two keys and nothing else. Use the short form: `{name}` is short for `{name: .name}`.",
    "reference": "{name, version}",
    "tests": [
      {
        "input": {
          "name": "left-pad",
          "version": "1.3.0",
          "license": "MIT",
          "scripts": {
            "test": "bun test"
          }
        },
        "expected": "{\n  \"name\": \"left-pad\",\n  \"version\": \"1.3.0\"\n}"
      },
      {
        "input": {
          "name": "api",
          "version": "0.1.0",
          "private": true
        },
        "expected": "{\n  \"name\": \"api\",\n  \"version\": \"0.1.0\"\n}"
      },
      {
        "input": {
          "name": "ui",
          "version": "2.0.0"
        },
        "expected": "{\n  \"name\": \"ui\",\n  \"version\": \"2.0.0\"\n}"
      }
    ]
  },
  {
    "title": "Delivery cities",
    "statement": "Give one array with a small object for every order.\n\nThe input is an array of orders. Each small object has two keys. `id` is the order's `id`. `city` is the value of `address.city`. Keep the order. Put `[ ]` around `.[] | { ... }`.",
    "reference": "[.[] | {id, city: .address.city}]",
    "tests": [
      {
        "input": [
          {
            "id": 501,
            "total": 20,
            "address": {
              "city": "Oslo",
              "zip": "0150"
            }
          },
          {
            "id": 502,
            "total": 8,
            "address": {
              "city": "Bergen",
              "zip": "5003"
            }
          }
        ],
        "expected": "[\n  {\n    \"id\": 501,\n    \"city\": \"Oslo\"\n  },\n  {\n    \"id\": 502,\n    \"city\": \"Bergen\"\n  }\n]"
      },
      {
        "input": [],
        "expected": "[]"
      },
      {
        "input": [
          {
            "id": 610,
            "total": 99,
            "address": {
              "city": "Turin",
              "zip": "10121"
            }
          }
        ],
        "expected": "[\n  {\n    \"id\": 610,\n    \"city\": \"Turin\"\n  }\n]"
      }
    ]
  }
]
