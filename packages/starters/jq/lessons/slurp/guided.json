[
  {
    "title": "Order ids",
    "statement": "Give one array with the `id` of every order.\n\nThe input holds many orders, one JSON object per line. Read them all into one array with `-s`, then use `map`. Use no other flag.",
    "mode": "command",
    "stub": "'.'",
    "reference": "-s 'map(.id)'",
    "tests": [
      {
        "input_text": "{\"id\":101,\"total\":25}\n{\"id\":102,\"total\":8}\n{\"id\":103,\"total\":40}\n",
        "expected": "[\n  101,\n  102,\n  103\n]"
      },
      {
        "input_text": "{\"id\":200,\"total\":99}\n",
        "expected": "[\n  200\n]"
      },
      {
        "input_text": "{\"id\":301,\"total\":4}\n{\"id\":302,\"total\":12}\n",
        "expected": "[\n  301,\n  302\n]"
      }
    ]
  },
  {
    "title": "Count log lines",
    "statement": "Give the number of log entries.\n\nThe input holds many entries, one JSON object per line. Without `-s`, `length` runs once per entry. With `-s` it runs once, on the array of all entries.",
    "mode": "command",
    "stub": "'.'",
    "reference": "-s 'length'",
    "tests": [
      {
        "input_text": "{\"level\":\"info\",\"msg\":\"started\"}\n{\"level\":\"warn\",\"msg\":\"slow reply\"}\n{\"level\":\"info\",\"msg\":\"stopped\"}\n",
        "expected": "3"
      },
      {
        "input_text": "{\"level\":\"error\",\"msg\":\"disk full\"}\n",
        "expected": "1"
      },
      {
        "input_text": "",
        "expected": "0"
      },
      {
        "input_text": "{\"level\":\"info\",\"msg\":\"a\"}\n{\"level\":\"info\",\"msg\":\"b\"}\n{\"level\":\"info\",\"msg\":\"c\"}\n{\"level\":\"info\",\"msg\":\"d\"}\n{\"level\":\"info\",\"msg\":\"e\"}\n",
        "expected": "5"
      }
    ]
  },
  {
    "title": "Failed builds",
    "statement": "Give the number of builds that failed.\n\nThe input holds many builds, one JSON object per line. A build failed when its `status` is `\"failed\"`. Use `-s`, keep the failed builds with `map(select(...))`, then count them.",
    "mode": "command",
    "stub": "'.'",
    "reference": "-s 'map(select(.status == \"failed\")) | length'",
    "tests": [
      {
        "input_text": "{\"build\":41,\"status\":\"passed\"}\n{\"build\":42,\"status\":\"failed\"}\n{\"build\":43,\"status\":\"failed\"}\n",
        "expected": "2"
      },
      {
        "input_text": "{\"build\":50,\"status\":\"passed\"}\n",
        "expected": "0"
      },
      {
        "input_text": "{\"build\":60,\"status\":\"failed\"}\n{\"build\":61,\"status\":\"passed\"}\n{\"build\":62,\"status\":\"passed\"}\n{\"build\":63,\"status\":\"passed\"}\n",
        "expected": "1"
      },
      {
        "input_text": "{\"build\":70,\"status\":\"failed\"}\n{\"build\":71,\"status\":\"failed\"}\n{\"build\":72,\"status\":\"failed\"}\n",
        "expected": "3"
      }
    ]
  }
]
