[
  {
    "title": "Hide the key",
    "statement": "Remove the API key from the config.\n\nThe input is one object. Remove its `api_key` with `del`. Give the rest of the object back.",
    "reference": "del(.api_key)",
    "tests": [
      {
        "input": {
          "host": "api.example.com",
          "port": 443,
          "api_key": "k-91f2"
        },
        "expected": "{\n  \"host\": \"api.example.com\",\n  \"port\": 443\n}"
      },
      {
        "input": {
          "host": "localhost",
          "api_key": "k-test",
          "debug": true
        },
        "expected": "{\n  \"host\": \"localhost\",\n  \"debug\": true\n}"
      },
      {
        "input": {
          "api_key": "k-0"
        },
        "expected": "{}"
      }
    ]
  },
  {
    "title": "Rows without header",
    "statement": "Remove the header row from the table.\n\nThe input is an array of rows. The first row is the header. Remove it with `del` and an index. Give the other rows back, in the same order.",
    "reference": "del(.[0])",
    "tests": [
      {
        "input": [
          [
            "name",
            "age"
          ],
          [
            "Ada",
            36
          ],
          [
            "Bo",
            41
          ]
        ],
        "expected": "[\n  [\n    \"Ada\",\n    36\n  ],\n  [\n    \"Bo\",\n    41\n  ]\n]"
      },
      {
        "input": [
          [
            "sku",
            "qty"
          ]
        ],
        "expected": "[]"
      },
      {
        "input": [
          [
            "id"
          ],
          [
            1
          ],
          [
            2
          ],
          [
            3
          ]
        ],
        "expected": "[\n  [\n    1\n  ],\n  [\n    2\n  ],\n  [\n    3\n  ]\n]"
      }
    ]
  },
  {
    "title": "Events without debug",
    "statement": "Remove the `debug` field from every event.\n\nThe input is an array of events. Some events have no `debug` field. Leave those as they are. Give an array of events back. You can put `del` inside `map`, or give `del` the path `.[].debug`.",
    "reference": "map(del(.debug))",
    "tests": [
      {
        "input": [
          {
            "type": "click",
            "at": 1,
            "debug": {
              "x": 4
            }
          },
          {
            "type": "scroll",
            "at": 2
          }
        ],
        "expected": "[\n  {\n    \"type\": \"click\",\n    \"at\": 1\n  },\n  {\n    \"type\": \"scroll\",\n    \"at\": 2\n  }\n]"
      },
      {
        "input": [],
        "expected": "[]"
      },
      {
        "input": [
          {
            "type": "load",
            "at": 9,
            "debug": null
          }
        ],
        "expected": "[\n  {\n    \"type\": \"load\",\n    \"at\": 9\n  }\n]"
      }
    ]
  }
]
