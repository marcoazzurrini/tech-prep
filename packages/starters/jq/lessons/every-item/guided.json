[
  {
    "title": "Every region",
    "statement": "Print every region of the service, each as its own output.\n\nThe command below prints only the first region. Change it so that it prints all of them.",
    "stub": ".[0]",
    "reference": ".[]",
    "tests": [
      {
        "input": [
          "eu-west",
          "us-east",
          "ap-south"
        ],
        "expected": "\"eu-west\"\n\"us-east\"\n\"ap-south\""
      },
      {
        "input": [
          "eu-north"
        ],
        "expected": "\"eu-north\""
      },
      {
        "input": [
          "us-west",
          "us-east",
          "sa-east",
          "eu-west"
        ],
        "expected": "\"us-west\"\n\"us-east\"\n\"sa-east\"\n\"eu-west\""
      }
    ]
  },
  {
    "title": "What comes out?",
    "statement": "Type what jq prints for this input and this command.\n\nThe input is a list of test groups. Each group is a list of test files. The filter gives more than one output. Type each output on its own line.",
    "mode": "predict",
    "show_filter": true,
    "reference": ".[] | length",
    "tests": [
      {
        "input": [
          [
            "login.test",
            "logout.test"
          ],
          [
            "cart.test"
          ],
          [
            "pay.test",
            "refund.test",
            "tax.test"
          ]
        ],
        "expected": "2\n1\n3"
      }
    ]
  },
  {
    "title": "Hosts of the servers",
    "statement": "Print the host of every server.\n\nThe servers are under `servers`. Print each host as its own output, in the order of the input.",
    "reference": ".servers[] | .host",
    "tests": [
      {
        "input": {
          "env": "prod",
          "servers": [
            {
              "host": "web-1",
              "port": 443
            },
            {
              "host": "db-1",
              "port": 5432
            }
          ]
        },
        "expected": "\"web-1\"\n\"db-1\""
      },
      {
        "input": {
          "env": "dev",
          "servers": [
            {
              "host": "local-1",
              "port": 8080
            }
          ]
        },
        "expected": "\"local-1\""
      },
      {
        "input": {
          "env": "staging",
          "servers": [
            {
              "host": "web-9",
              "port": 443
            },
            {
              "host": "cache-2",
              "port": 6379
            },
            {
              "host": "db-4",
              "port": 5432
            }
          ]
        },
        "expected": "\"web-9\"\n\"cache-2\"\n\"db-4\""
      }
    ]
  }
]
