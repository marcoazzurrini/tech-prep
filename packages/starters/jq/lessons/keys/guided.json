[
  {
    "title": "Dependency names",
    "statement": "List the names of the packages this project depends on.\n\nThe packages are the keys of the `dependencies` object. Give one array of names, in sorted order.",
    "reference": ".dependencies | keys",
    "tests": [
      {
        "input": {
          "name": "shop-api",
          "dependencies": {
            "zod": "3.22.0",
            "express": "4.18.2",
            "pg": "8.11.0"
          }
        },
        "expected": "[\n  \"express\",\n  \"pg\",\n  \"zod\"\n]"
      },
      {
        "input": {
          "name": "cli",
          "dependencies": {}
        },
        "expected": "[]"
      },
      {
        "input": {
          "name": "site",
          "dependencies": {
            "react": "18.2.0"
          }
        },
        "expected": "[\n  \"react\"\n]"
      }
    ]
  },
  {
    "title": "Users with a phone",
    "statement": "Keep the users that have a `phone` field.\n\nThe input is an array of users. Keep a user when the `phone` key is there, even when its value is `null`. Give an array of whole users back. Use `has(\"phone\")` as the test.",
    "reference": "map(select(has(\"phone\")))",
    "tests": [
      {
        "input": [
          {
            "name": "Ada",
            "phone": "555-0101"
          },
          {
            "name": "Bo"
          },
          {
            "name": "Cy",
            "phone": null
          }
        ],
        "expected": "[\n  {\n    \"name\": \"Ada\",\n    \"phone\": \"555-0101\"\n  },\n  {\n    \"name\": \"Cy\",\n    \"phone\": null\n  }\n]"
      },
      {
        "input": [
          {
            "name": "Dee"
          }
        ],
        "expected": "[]"
      },
      {
        "input": [
          {
            "name": "Eli",
            "phone": null
          }
        ],
        "expected": "[\n  {\n    \"name\": \"Eli\",\n    \"phone\": null\n  }\n]"
      },
      {
        "input": [],
        "expected": "[]"
      }
    ]
  },
  {
    "title": "No license",
    "statement": "Give the name of every package that has no `license` field.\n\nThe input is an array of packages. A package counts as having a license when the `license` key is there, even with the value `null`. Print each name as its own output. Turn the test around with `not`: `has(\"license\") | not`.",
    "reference": ".[] | select(has(\"license\") | not) | .name",
    "tests": [
      {
        "input": [
          {
            "name": "left-pad",
            "license": "MIT"
          },
          {
            "name": "old-utils"
          },
          {
            "name": "tiny",
            "license": null
          },
          {
            "name": "glue"
          }
        ],
        "expected": "\"old-utils\"\n\"glue\""
      },
      {
        "input": [
          {
            "name": "core",
            "license": "ISC"
          }
        ],
        "expected": ""
      },
      {
        "input": [
          {
            "name": "draft"
          }
        ],
        "expected": "\"draft\""
      },
      {
        "input": [],
        "expected": ""
      }
    ]
  }
]
