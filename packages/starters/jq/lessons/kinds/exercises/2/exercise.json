{
  "title": "Is the port a number?",
  "check": {
    "type": "command",
    "program": "jq",
    "compare": "json",
    "file": "data.json",
    "start": "jq '.port | type == number' data.json",
    "reference": "jq '.port | type == \"number\"' data.json",
    "tests": [
      {
        "input": {
          "host": "web-1",
          "port": 8080
        },
        "expected": "true"
      },
      {
        "input": {
          "host": "db-1",
          "port": "5432"
        },
        "expected": "false"
      },
      {
        "input": {
          "host": "cache-1"
        },
        "expected": "false"
      },
      {
        "input": {
          "host": "mail-1",
          "port": 25
        },
        "expected": "true"
      }
    ]
  }
}
