[
  {
    "title": "Package names",
    "statement": "Give one array with the name of every package.\n\nThe input is an array of packages. Each package has a `name` and a `version`. Keep the order. Put `[ ]` around the whole filter.",
    "reference": "[.[] | .name]",
    "tests": [
      {
        "input": [
          {
            "name": "react",
            "version": "18.2.0"
          },
          {
            "name": "zod",
            "version": "3.22.4"
          },
          {
            "name": "vite",
            "version": "5.0.0"
          }
        ],
        "expected": "[\n  \"react\",\n  \"zod\",\n  \"vite\"\n]"
      },
      {
        "input": [],
        "expected": "[]"
      },
      {
        "input": [
          {
            "name": "lodash",
            "version": "4.17.21"
          }
        ],
        "expected": "[\n  \"lodash\"\n]"
      }
    ]
  },
  {
    "title": "Order ids",
    "statement": "Give one array with the `id` of every order.\n\nThe orders are in the `orders` array of the input. Keep the order. Start the filter inside `[ ]` with `.orders[]`.",
    "reference": "[.orders[] | .id]",
    "tests": [
      {
        "input": {
          "customer": "Ada",
          "orders": [
            {
              "id": 501,
              "total": 20
            },
            {
              "id": 502,
              "total": 8
            },
            {
              "id": 507,
              "total": 35
            }
          ]
        },
        "expected": "[\n  501,\n  502,\n  507\n]"
      },
      {
        "input": {
          "customer": "Bo",
          "orders": []
        },
        "expected": "[]"
      },
      {
        "input": {
          "customer": "Cy",
          "orders": [
            {
              "id": 610,
              "total": 99
            }
          ]
        },
        "expected": "[\n  610\n]"
      }
    ]
  },
  {
    "title": "All tags",
    "statement": "Give one flat array with every tag of every post.\n\nThe input is an array of posts. Each post has a `tags` array. The result is one array of strings. It is not an array of arrays. Keep the order, and keep tags that repeat. You need `.[]` two times inside `[ ]`.",
    "reference": "[.[] | .tags[]]",
    "tests": [
      {
        "input": [
          {
            "slug": "intro",
            "tags": [
              "jq",
              "json"
            ]
          },
          {
            "slug": "tips",
            "tags": [
              "shell"
            ]
          },
          {
            "slug": "faq",
            "tags": [
              "jq"
            ]
          }
        ],
        "expected": "[\n  \"jq\",\n  \"json\",\n  \"shell\",\n  \"jq\"\n]"
      },
      {
        "input": [
          {
            "slug": "draft",
            "tags": []
          }
        ],
        "expected": "[]"
      },
      {
        "input": [
          {
            "slug": "news",
            "tags": [
              "release",
              "docs"
            ]
          }
        ],
        "expected": "[\n  \"release\",\n  \"docs\"\n]"
      }
    ]
  }
]
