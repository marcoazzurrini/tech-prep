[
  {
    "title": "Labels of the issue",
    "statement": "Print the labels of the issue, each label once.\n\nThe command below prints the labels in order, but some appear twice. Change `sort` to `unique`.",
    "stub": ".labels | sort",
    "reference": ".labels | unique",
    "tests": [
      {
        "input": {
          "issue": 214,
          "labels": [
            "bug",
            "ui",
            "bug",
            "urgent",
            "ui"
          ]
        },
        "expected": "[\n  \"bug\",\n  \"ui\",\n  \"urgent\"\n]"
      },
      {
        "input": {
          "issue": 215,
          "labels": [
            "docs",
            "docs"
          ]
        },
        "expected": "[\n  \"docs\"\n]"
      },
      {
        "input": {
          "issue": 216,
          "labels": [
            "perf",
            "api",
            "perf",
            "api",
            "perf"
          ]
        },
        "expected": "[\n  \"api\",\n  \"perf\"\n]"
      }
    ]
  },
  {
    "title": "Status codes seen",
    "statement": "Print the different status codes of the requests.\n\nTake `requests`. Take the `status` of each request with `map`. Then remove the repeats with `unique`. Print one array of numbers.",
    "reference": ".requests | map(.status) | unique",
    "tests": [
      {
        "input": {
          "requests": [
            {
              "path": "/",
              "status": 200
            },
            {
              "path": "/old",
              "status": 404
            },
            {
              "path": "/about",
              "status": 200
            },
            {
              "path": "/api",
              "status": 500
            }
          ]
        },
        "expected": "[\n  200,\n  404,\n  500\n]"
      },
      {
        "input": {
          "requests": [
            {
              "path": "/",
              "status": 200
            },
            {
              "path": "/a",
              "status": 200
            }
          ]
        },
        "expected": "[\n  200\n]"
      },
      {
        "input": {
          "requests": [
            {
              "path": "/x",
              "status": 301
            },
            {
              "path": "/y",
              "status": 404
            },
            {
              "path": "/z",
              "status": 301
            }
          ]
        },
        "expected": "[\n  301,\n  404\n]"
      }
    ]
  },
  {
    "title": "First event per user",
    "statement": "Print one event for each user: the first event of that user in the list.\n\nThe input is an array of events. Use `unique_by` with the field `user`. Print one array of whole event objects.",
    "reference": "unique_by(.user)",
    "tests": [
      {
        "input": [
          {
            "user": "kim",
            "action": "login"
          },
          {
            "user": "lee",
            "action": "login"
          },
          {
            "user": "kim",
            "action": "upload"
          },
          {
            "user": "lee",
            "action": "logout"
          }
        ],
        "expected": "[\n  {\n    \"user\": \"kim\",\n    \"action\": \"login\"\n  },\n  {\n    \"user\": \"lee\",\n    \"action\": \"login\"\n  }\n]"
      },
      {
        "input": [
          {
            "user": "sam",
            "action": "signup"
          },
          {
            "user": "sam",
            "action": "login"
          },
          {
            "user": "sam",
            "action": "delete"
          }
        ],
        "expected": "[\n  {\n    \"user\": \"sam\",\n    \"action\": \"signup\"\n  }\n]"
      },
      {
        "input": [
          {
            "user": "uma",
            "action": "login"
          },
          {
            "user": "pat",
            "action": "search"
          },
          {
            "user": "ana",
            "action": "login"
          },
          {
            "user": "pat",
            "action": "logout"
          }
        ],
        "expected": "[\n  {\n    \"user\": \"ana\",\n    \"action\": \"login\"\n  },\n  {\n    \"user\": \"pat\",\n    \"action\": \"search\"\n  },\n  {\n    \"user\": \"uma\",\n    \"action\": \"login\"\n  }\n]"
      }
    ]
  }
]
