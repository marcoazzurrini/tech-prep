[
  {
    "title": "Status codes seen",
    "statement": "Give every status code in the log, each one once.\n\nThe input is an array of log entries. Each has a `path` and a `status`. Give one array of numbers, lowest first. Use `map`, then `unique`.",
    "reference": "map(.status) | unique",
    "tests": [
      {
        "input": [
          {
            "path": "/",
            "status": 200
          },
          {
            "path": "/old",
            "status": 404
          },
          {
            "path": "/api",
            "status": 200
          },
          {
            "path": "/pay",
            "status": 500
          },
          {
            "path": "/gone",
            "status": 404
          }
        ],
        "expected": "[\n  200,\n  404,\n  500\n]"
      },
      {
        "input": [
          {
            "path": "/",
            "status": 200
          },
          {
            "path": "/about",
            "status": 200
          }
        ],
        "expected": "[\n  200\n]"
      },
      {
        "input": [],
        "expected": "[]"
      },
      {
        "input": [
          {
            "path": "/go",
            "status": 301
          },
          {
            "path": "/save",
            "status": 204
          }
        ],
        "expected": "[\n  204,\n  301\n]"
      }
    ]
  },
  {
    "title": "One account per email",
    "statement": "Keep one account for each email.\n\nEach account has an `id` and an `email`. Some emails appear more than once. Use `unique_by`. It keeps the first account of each email and sorts the result by email. Give an array of whole accounts.",
    "reference": "unique_by(.email)",
    "tests": [
      {
        "input": [
          {
            "id": 1,
            "email": "zoe@example.com"
          },
          {
            "id": 2,
            "email": "amy@example.com"
          },
          {
            "id": 3,
            "email": "zoe@example.com"
          }
        ],
        "expected": "[\n  {\n    \"id\": 2,\n    \"email\": \"amy@example.com\"\n  },\n  {\n    \"id\": 1,\n    \"email\": \"zoe@example.com\"\n  }\n]"
      },
      {
        "input": [
          {
            "id": 4,
            "email": "raj@example.com"
          }
        ],
        "expected": "[\n  {\n    \"id\": 4,\n    \"email\": \"raj@example.com\"\n  }\n]"
      },
      {
        "input": [
          {
            "id": 5,
            "email": "bea@example.com"
          },
          {
            "id": 6,
            "email": "bea@example.com"
          },
          {
            "id": 7,
            "email": "al@example.com"
          },
          {
            "id": 8,
            "email": "al@example.com"
          }
        ],
        "expected": "[\n  {\n    \"id\": 7,\n    \"email\": \"al@example.com\"\n  },\n  {\n    \"id\": 5,\n    \"email\": \"bea@example.com\"\n  }\n]"
      }
    ]
  },
  {
    "title": "Number of authors",
    "statement": "Count how many different authors wrote the commits.\n\nEach commit has a `sha` and an `author`. An author can have many commits. Take the authors, remove the repeats, then count. Print one number.",
    "reference": "map(.author) | unique | length",
    "tests": [
      {
        "input": [
          {
            "sha": "a1f",
            "author": "mia"
          },
          {
            "sha": "b2e",
            "author": "tom"
          },
          {
            "sha": "c3d",
            "author": "mia"
          },
          {
            "sha": "d4c",
            "author": "mia"
          }
        ],
        "expected": "2"
      },
      {
        "input": [],
        "expected": "0"
      },
      {
        "input": [
          {
            "sha": "e5b",
            "author": "sam"
          }
        ],
        "expected": "1"
      },
      {
        "input": [
          {
            "sha": "f6a",
            "author": "ann"
          },
          {
            "sha": "g7b",
            "author": "bob"
          },
          {
            "sha": "h8c",
            "author": "cat"
          }
        ],
        "expected": "3"
      }
    ]
  }
]
