[
  {
    "title": "Fix the filter",
    "statement": "Print the package's name, then `@`, then its version, as one string. For the first input that is `\"left-trim@2.0.1\"`.\n\nThe filter below should do that, but it prints the filter text itself. Find what is missing and fix it.",
    "stub": "\"(.name)@(.version)\"",
    "reference": "\"\\(.name)@\\(.version)\"",
    "tests": [
      {
        "input": {
          "name": "left-trim",
          "version": "2.0.1",
          "license": "MIT"
        },
        "expected": "\"left-trim@2.0.1\""
      },
      {
        "input": {
          "name": "tiny-log",
          "version": "0.4.0",
          "license": "ISC"
        },
        "expected": "\"tiny-log@0.4.0\""
      },
      {
        "input": {
          "name": "dates",
          "version": "11.2.3",
          "license": "MIT"
        },
        "expected": "\"dates@11.2.3\""
      }
    ]
  },
  {
    "title": "Open issues of a repo",
    "statement": "Print a sentence that says how many open issues the repo has. For the first input that is `\"atlas has 3 open issues\"`.\n\nThe filter below puts the whole list of issues into the text. Change the second gap so that it holds the number of issues.",
    "stub": "\"\\(.repo) has \\(.issues) open issues\"",
    "reference": "\"\\(.repo) has \\(.issues | length) open issues\"",
    "tests": [
      {
        "input": {
          "repo": "atlas",
          "issues": [
            212,
            215,
            230
          ]
        },
        "expected": "\"atlas has 3 open issues\""
      },
      {
        "input": {
          "repo": "notes",
          "issues": []
        },
        "expected": "\"notes has 0 open issues\""
      },
      {
        "input": {
          "repo": "router",
          "issues": [
            7,
            9,
            14,
            15,
            21,
            30,
            31
          ]
        },
        "expected": "\"router has 7 open issues\""
      }
    ]
  },
  {
    "title": "Names with addresses",
    "statement": "For each person, print one string with the name, a space, and the email between `<` and `>`. For the first person that is `\"Lena <lena@example.com>\"`.\n\nEach string is its own output.",
    "reference": ".[] | \"\\(.name) <\\(.email)>\"",
    "tests": [
      {
        "input": [
          {
            "name": "Lena",
            "email": "lena@example.com",
            "team": "web"
          },
          {
            "name": "Omar",
            "email": "omar@example.com",
            "team": "data"
          }
        ],
        "expected": "\"Lena <lena@example.com>\"\n\"Omar <omar@example.com>\""
      },
      {
        "input": [
          {
            "name": "Ines",
            "email": "ines@example.com",
            "team": "ops"
          }
        ],
        "expected": "\"Ines <ines@example.com>\""
      },
      {
        "input": [
          {
            "name": "Kofi",
            "email": "kofi@example.com",
            "team": "web"
          },
          {
            "name": "Yuki",
            "email": "yuki@example.com",
            "team": "web"
          },
          {
            "name": "Sam",
            "email": "sam@example.com",
            "team": "ops"
          }
        ],
        "expected": "\"Kofi <kofi@example.com>\"\n\"Yuki <yuki@example.com>\"\n\"Sam <sam@example.com>\""
      }
    ]
  }
]
