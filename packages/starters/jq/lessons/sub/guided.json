[
  {
    "title": "Phone digits",
    "statement": "Remove every `-` from the phone number.\n\nThe number is in `phone`. Give one string. Use `gsub` and replace each `-` with the empty string `\"\"`.",
    "reference": ".phone | gsub(\"-\"; \"\")",
    "tests": [
      {
        "input": {
          "phone": "555-010-2030"
        },
        "expected": "\"5550102030\""
      },
      {
        "input": {
          "phone": "020-7946-0018"
        },
        "expected": "\"02079460018\""
      },
      {
        "input": {
          "phone": "5550199"
        },
        "expected": "\"5550199\""
      }
    ]
  },
  {
    "title": "Secure link",
    "statement": "Replace the first `http:` in the link with `https:`.\n\nThe link is in `url`. Change only the first `http:`. Leave any later one as it is. Give one string. Use `sub`.",
    "reference": ".url | sub(\"http:\"; \"https:\")",
    "tests": [
      {
        "input": {
          "url": "http://example.com/go?to=http://example.org"
        },
        "expected": "\"https://example.com/go?to=http://example.org\""
      },
      {
        "input": {
          "url": "http://example.com/docs"
        },
        "expected": "\"https://example.com/docs\""
      },
      {
        "input": {
          "url": "https://example.com"
        },
        "expected": "\"https://example.com\""
      }
    ]
  },
  {
    "title": "Emails in lower case",
    "statement": "Give each user with the email in lower case.\n\nThe input is an array of users. For each user, build an object with `name` as it is and `email` in lower case. Print each object as its own output. Use `ascii_downcase`.",
    "reference": ".[] | {name, email: (.email | ascii_downcase)}",
    "tests": [
      {
        "input": [
          {
            "name": "Ada",
            "email": "Ada@Example.com"
          },
          {
            "name": "Bo",
            "email": "BO@EXAMPLE.COM"
          }
        ],
        "expected": "{\n  \"name\": \"Ada\",\n  \"email\": \"ada@example.com\"\n}\n{\n  \"name\": \"Bo\",\n  \"email\": \"bo@example.com\"\n}"
      },
      {
        "input": [
          {
            "name": "Cy",
            "email": "cy@example.com"
          }
        ],
        "expected": "{\n  \"name\": \"Cy\",\n  \"email\": \"cy@example.com\"\n}"
      },
      {
        "input": [],
        "expected": ""
      }
    ]
  }
]
