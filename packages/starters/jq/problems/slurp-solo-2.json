{
  "title": "Long jobs",
  "statement": "Give one array with the name of every job that ran for more than 60 seconds.\n\nThe input holds many jobs, one JSON object per line. Each has a `name` and a time `seconds`. Print the whole array as one line of JSON, with no spaces. For example `[\"build\",\"deploy\"]`. Keep the order of the input.",
  "mode": "command",
  "stub": "'.'",
  "reference": "-c -s 'map(select(.seconds > 60) | .name)'",
  "tests": [
    {
      "input_text": "{\"name\":\"build\",\"seconds\":95}\n{\"name\":\"lint\",\"seconds\":12}\n{\"name\":\"deploy\",\"seconds\":240}\n",
      "expected": "[\"build\",\"deploy\"]"
    },
    {
      "input_text": "{\"name\":\"format\",\"seconds\":60}\n",
      "expected": "[]"
    },
    {
      "input_text": "{\"name\":\"test\",\"seconds\":61}\n{\"name\":\"docs\",\"seconds\":30}\n",
      "expected": "[\"test\"]"
    },
    {
      "input_text": "{\"name\":\"pack\",\"seconds\":70}\n{\"name\":\"scan\",\"seconds\":400}\n{\"name\":\"sign\",\"seconds\":88}\n",
      "expected": "[\"pack\",\"scan\",\"sign\"]"
    }
  ]
}
