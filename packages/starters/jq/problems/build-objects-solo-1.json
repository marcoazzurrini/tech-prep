{
  "title": "Repo card",
  "statement": "Print an object with two keys: `name` and `stars`.\n\nThe `name` is the repo's `full_name`. The `stars` value is its `stargazers_count`.",
  "reference": "{name: .full_name, stars: .stargazers_count}",
  "tests": [
    {
      "input": {
        "id": 5512,
        "full_name": "mira/atlas",
        "stargazers_count": 318,
        "forks_count": 21,
        "archived": false
      },
      "expected": "{\n  \"name\": \"mira/atlas\",\n  \"stars\": 318\n}"
    },
    {
      "input": {
        "id": 77,
        "full_name": "tomas/notes",
        "stargazers_count": 0,
        "forks_count": 0,
        "archived": true
      },
      "expected": "{\n  \"name\": \"tomas/notes\",\n  \"stars\": 0\n}"
    },
    {
      "input": {
        "id": 9040,
        "full_name": "core/router",
        "stargazers_count": 12950,
        "forks_count": 804,
        "archived": false
      },
      "expected": "{\n  \"name\": \"core/router\",\n  \"stars\": 12950\n}"
    }
  ]
}
