{
  "title": "Archived article",
  "statement": "Add the tag `\"archived\"` to the end of the article's tags.\n\nThe input is one article. Its tags are in the `tags` array. Give the whole article back, with the other fields as they are.",
  "reference": ".tags += [\"archived\"]",
  "tests": [
    {
      "input": {
        "title": "Release notes",
        "author": "ada",
        "tags": [
          "news",
          "v2"
        ]
      },
      "expected": "{\n  \"title\": \"Release notes\",\n  \"author\": \"ada\",\n  \"tags\": [\n    \"news\",\n    \"v2\",\n    \"archived\"\n  ]\n}"
    },
    {
      "input": {
        "title": "Draft",
        "author": "bo",
        "tags": []
      },
      "expected": "{\n  \"title\": \"Draft\",\n  \"author\": \"bo\",\n  \"tags\": [\n    \"archived\"\n  ]\n}"
    },
    {
      "input": {
        "title": "Old post",
        "author": "cy",
        "tags": [
          "2019"
        ]
      },
      "expected": "{\n  \"title\": \"Old post\",\n  \"author\": \"cy\",\n  \"tags\": [\n    \"2019\",\n    \"archived\"\n  ]\n}"
    }
  ]
}
