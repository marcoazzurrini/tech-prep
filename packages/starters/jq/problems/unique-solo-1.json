{
  "title": "Open ports",
  "statement": "Give every open port once, lowest first.\n\nThe ports are numbers in the `ports` array. A port can appear more than once. Give one array back.",
  "reference": ".ports | unique",
  "tests": [
    {
      "input": {
        "host": "web-1",
        "ports": [
          443,
          22,
          80,
          443,
          22
        ]
      },
      "expected": "[\n  22,\n  80,\n  443\n]"
    },
    {
      "input": {
        "host": "db-1",
        "ports": [
          5432
        ]
      },
      "expected": "[\n  5432\n]"
    },
    {
      "input": {
        "host": "idle-1",
        "ports": []
      },
      "expected": "[]"
    },
    {
      "input": {
        "host": "cache-1",
        "ports": [
          6380,
          6379,
          6379
        ]
      },
      "expected": "[\n  6379,\n  6380\n]"
    }
  ]
}
