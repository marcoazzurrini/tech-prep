{
  "title": "Ports per server",
  "statement": "Print the open ports of every server, one server per line.\n\nThe input is an array of servers. Each has a `ports` array. Print each `ports` array as one line of JSON, with no spaces. For example `[80,443]`.",
  "mode": "command",
  "stub": "'.'",
  "reference": "-c '.[] | .ports'",
  "tests": [
    {
      "input": [
        {
          "host": "web-1",
          "ports": [
            80,
            443
          ]
        },
        {
          "host": "db-1",
          "ports": [
            5432
          ]
        }
      ],
      "expected": "[80,443]\n[5432]"
    },
    {
      "input": [
        {
          "host": "cache-1",
          "ports": []
        }
      ],
      "expected": "[]"
    },
    {
      "input": [
        {
          "host": "mail-1",
          "ports": [
            25,
            465,
            587
          ]
        },
        {
          "host": "dns-1",
          "ports": [
            53
          ]
        },
        {
          "host": "ssh-1",
          "ports": [
            22
          ]
        }
      ],
      "expected": "[25,465,587]\n[53]\n[22]"
    },
    {
      "input": [],
      "expected": ""
    }
  ]
}
