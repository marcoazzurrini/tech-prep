{
  "title": "Valid port",
  "statement": "Say whether the port number is valid.\n\nThe number is in `port`. It is valid when it is from 1 to 65535, with both ends included. Give `true` or `false`.",
  "reference": ".port >= 1 and .port <= 65535",
  "tests": [
    {
      "input": {
        "host": "localhost",
        "port": 8080
      },
      "expected": "true"
    },
    {
      "input": {
        "host": "db.internal",
        "port": 0
      },
      "expected": "false"
    },
    {
      "input": {
        "host": "cache",
        "port": 65535
      },
      "expected": "true"
    },
    {
      "input": {
        "host": "api",
        "port": 70000
      },
      "expected": "false"
    }
  ]
}
