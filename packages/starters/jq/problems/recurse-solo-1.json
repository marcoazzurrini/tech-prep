{
  "title": "Failed tests",
  "statement": "Give the name of every test that failed, at any depth.\n\nThe input is a test report. A suite has a `tests` array and a `suites` array of more suites. A test is an object with a `name` and a `status`. Only tests have a `status`. A test failed when its `status` is `\"failed\"`. Print each name as its own output, in the order of the input.",
  "reference": ".. | select(.status? == \"failed\") | .name",
  "tests": [
    {
      "input": {
        "name": "all",
        "tests": [
          {
            "name": "boots",
            "status": "passed"
          },
          {
            "name": "logs in",
            "status": "failed"
          }
        ],
        "suites": [
          {
            "name": "api",
            "tests": [
              {
                "name": "lists users",
                "status": "failed"
              }
            ],
            "suites": []
          }
        ]
      },
      "expected": "\"logs in\"\n\"lists users\""
    },
    {
      "input": {
        "name": "all",
        "tests": [
          {
            "name": "boots",
            "status": "passed"
          }
        ],
        "suites": []
      },
      "expected": ""
    },
    {
      "input": {
        "name": "all",
        "tests": [],
        "suites": [
          {
            "name": "ui",
            "tests": [],
            "suites": [
              {
                "name": "forms",
                "tests": [
                  {
                    "name": "saves",
                    "status": "failed"
                  },
                  {
                    "name": "clears",
                    "status": "skipped"
                  }
                ],
                "suites": []
              }
            ]
          }
        ]
      },
      "expected": "\"saves\""
    }
  ]
}
