{
  "title": "Stock after the sales",
  "statement": "Print how many pieces are left in stock after all the sales, as one number.\n\nThe shop begins with the number in `stock`. Every sale takes its `qty` away from that.",
  "reference": "reduce .sales[] as $s (.stock; . - $s.qty)",
  "tests": [
    {
      "input": {
        "sku": "pen",
        "stock": 50,
        "sales": [
          {
            "day": "mon",
            "qty": 12
          },
          {
            "day": "tue",
            "qty": 8
          }
        ]
      },
      "expected": "30"
    },
    {
      "input": {
        "sku": "ink",
        "stock": 9,
        "sales": []
      },
      "expected": "9"
    },
    {
      "input": {
        "sku": "lamp",
        "stock": 20,
        "sales": [
          {
            "day": "mon",
            "qty": 5
          },
          {
            "day": "wed",
            "qty": 5
          },
          {
            "day": "fri",
            "qty": 10
          }
        ]
      },
      "expected": "0"
    }
  ]
}
