{
  "title": "Stock after deliveries",
  "statement": "Give the stock of the shop after all the moves.\n\nThe `stock` object maps an item to a count. Each item of `moves` has an `item` and a `change`. Add each `change` to the count of its item, one move after another. A change can be negative. An item that is not in `stock` yet starts at 0. Give the new stock object.",
  "reference": "reduce .moves[] as $m (.stock; .[$m.item] += $m.change)",
  "tests": [
    {
      "input": {
        "stock": {
          "pen": 5,
          "pad": 2
        },
        "moves": [
          {
            "item": "pen",
            "change": -2
          },
          {
            "item": "ink",
            "change": 4
          },
          {
            "item": "pen",
            "change": 10
          }
        ]
      },
      "expected": "{\n  \"pen\": 13,\n  \"pad\": 2,\n  \"ink\": 4\n}"
    },
    {
      "input": {
        "stock": {
          "cap": 1
        },
        "moves": []
      },
      "expected": "{\n  \"cap\": 1\n}"
    },
    {
      "input": {
        "stock": {},
        "moves": [
          {
            "item": "mug",
            "change": 6
          },
          {
            "item": "mug",
            "change": -1
          }
        ]
      },
      "expected": "{\n  \"mug\": 5\n}"
    },
    {
      "input": {
        "stock": {
          "jar": 3,
          "lid": 3
        },
        "moves": [
          {
            "item": "lid",
            "change": -3
          }
        ]
      },
      "expected": "{\n  \"jar\": 3,\n  \"lid\": 0\n}"
    }
  ]
}
