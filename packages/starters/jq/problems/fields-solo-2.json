{
  "title": "Shipping city",
  "statement": "Give the city the order ships to.\n\nThe order has a `shipping` object. Inside it is an `address` object. The city is its `city` field.",
  "reference": ".shipping.address.city",
  "tests": [
    {
      "input": {
        "id": 501,
        "shipping": {
          "method": "post",
          "address": {
            "city": "Porto",
            "zip": "4000"
          }
        }
      },
      "expected": "\"Porto\""
    },
    {
      "input": {
        "id": 502,
        "shipping": {
          "method": "bike",
          "address": {
            "city": "Gent",
            "zip": "9000"
          }
        }
      },
      "expected": "\"Gent\""
    },
    {
      "input": {
        "id": 503,
        "shipping": {
          "method": "post",
          "address": {
            "city": "Turku",
            "zip": "20100"
          }
        }
      },
      "expected": "\"Turku\""
    }
  ]
}
