{
  "title": "Price as digits",
  "statement": "Clean the price so only the digits are left.\n\nThe price is in `price`, for example `$1,299`. Remove every `$` and every `,`. Give one string.",
  "reference": ".price | gsub(\"[$,]\"; \"\")",
  "tests": [
    {
      "input": {
        "price": "$1,299,000"
      },
      "expected": "\"1299000\""
    },
    {
      "input": {
        "price": "$45"
      },
      "expected": "\"45\""
    },
    {
      "input": {
        "price": "$3,500"
      },
      "expected": "\"3500\""
    },
    {
      "input": {
        "price": "980"
      },
      "expected": "\"980\""
    }
  ]
}
