{
  "title": "Release years",
  "statement": "Give every year that had a release, latest year first.\n\nThe input is an array of releases. Each has a `name` and a `year`. Several releases can share a year. Give one array of numbers, with each year once.",
  "reference": "map(.year) | unique | reverse",
  "tests": [
    {
      "input": [
        {
          "name": "Atlas",
          "year": 2021
        },
        {
          "name": "Birch",
          "year": 2023
        },
        {
          "name": "Cedar",
          "year": 2021
        },
        {
          "name": "Dune",
          "year": 2024
        },
        {
          "name": "Elm",
          "year": 2023
        }
      ],
      "expected": "[\n  2024,\n  2023,\n  2021\n]"
    },
    {
      "input": [
        {
          "name": "Fern",
          "year": 2019
        }
      ],
      "expected": "[\n  2019\n]"
    },
    {
      "input": [
        {
          "name": "Gale",
          "year": 2020
        },
        {
          "name": "Hawk",
          "year": 2020
        }
      ],
      "expected": "[\n  2020\n]"
    },
    {
      "input": [
        {
          "name": "Iris",
          "year": 2018
        },
        {
          "name": "Jade",
          "year": 2022
        }
      ],
      "expected": "[\n  2022,\n  2018\n]"
    }
  ]
}
