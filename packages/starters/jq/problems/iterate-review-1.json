{
  "title": "First cell of rows",
  "statement": "Give the first cell of every row.\n\nThe input is a table: an array of rows. Each row is an array of cells. Print the first cell of each row as its own output, in the same order.",
  "reference": ".[] | .[0]",
  "tests": [
    {
      "input": [
        [
          "Ada",
          36,
          "Lyon"
        ],
        [
          "Bo",
          41,
          "Bern"
        ],
        [
          "Cy",
          29,
          "Graz"
        ]
      ],
      "expected": "\"Ada\"\n\"Bo\"\n\"Cy\""
    },
    {
      "input": [
        [
          "pen",
          2
        ]
      ],
      "expected": "\"pen\""
    },
    {
      "input": [],
      "expected": ""
    },
    {
      "input": [
        [
          7,
          8
        ],
        [
          9,
          10
        ]
      ],
      "expected": "7\n9"
    }
  ]
}
