{
  "title": "Team rosters",
  "statement": "List the members of each team.\n\nEach person has a `name` and a `team`. Give one object for each team, with the `team` and a `members` array of names. Order the objects by `team`, from a to z. Inside `members`, keep the names in their input order.",
  "reference": "group_by(.team) | map({team: .[0].team, members: map(.name)})",
  "tests": [
    {
      "input": [
        {
          "name": "Sol",
          "team": "web"
        },
        {
          "name": "Tia",
          "team": "data"
        },
        {
          "name": "Udo",
          "team": "web"
        },
        {
          "name": "Val",
          "team": "infra"
        },
        {
          "name": "Wim",
          "team": "data"
        }
      ],
      "expected": "[\n  {\n    \"team\": \"data\",\n    \"members\": [\n      \"Tia\",\n      \"Wim\"\n    ]\n  },\n  {\n    \"team\": \"infra\",\n    \"members\": [\n      \"Val\"\n    ]\n  },\n  {\n    \"team\": \"web\",\n    \"members\": [\n      \"Sol\",\n      \"Udo\"\n    ]\n  }\n]"
    },
    {
      "input": [
        {
          "name": "Xan",
          "team": "qa"
        }
      ],
      "expected": "[\n  {\n    \"team\": \"qa\",\n    \"members\": [\n      \"Xan\"\n    ]\n  }\n]"
    },
    {
      "input": [],
      "expected": "[]"
    },
    {
      "input": [
        {
          "name": "Yui",
          "team": "b"
        },
        {
          "name": "Zak",
          "team": "a"
        },
        {
          "name": "Abe",
          "team": "b"
        }
      ],
      "expected": "[\n  {\n    \"team\": \"a\",\n    \"members\": [\n      \"Zak\"\n    ]\n  },\n  {\n    \"team\": \"b\",\n    \"members\": [\n      \"Yui\",\n      \"Abe\"\n    ]\n  }\n]"
    }
  ]
}
