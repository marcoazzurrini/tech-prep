{
  "title": "Largest file per folder",
  "statement": "Give the largest file of each folder.\n\nEach file has a `dir`, a `name` and a `size`. Give an array with one whole file object for each `dir`: the file with the highest `size`. Order the array by `dir`, from a to z. No two files in a folder have the same size.",
  "reference": "group_by(.dir) | map(max_by(.size))",
  "tests": [
    {
      "input": [
        {
          "dir": "src",
          "name": "app.ts",
          "size": 900
        },
        {
          "dir": "docs",
          "name": "faq.md",
          "size": 300
        },
        {
          "dir": "src",
          "name": "db.ts",
          "size": 2400
        },
        {
          "dir": "docs",
          "name": "api.md",
          "size": 1200
        }
      ],
      "expected": "[\n  {\n    \"dir\": \"docs\",\n    \"name\": \"api.md\",\n    \"size\": 1200\n  },\n  {\n    \"dir\": \"src\",\n    \"name\": \"db.ts\",\n    \"size\": 2400\n  }\n]"
    },
    {
      "input": [
        {
          "dir": "bin",
          "name": "run.sh",
          "size": 40
        }
      ],
      "expected": "[\n  {\n    \"dir\": \"bin\",\n    \"name\": \"run.sh\",\n    \"size\": 40\n  }\n]"
    },
    {
      "input": [
        {
          "dir": "img",
          "name": "a.png",
          "size": 10
        },
        {
          "dir": "img",
          "name": "b.png",
          "size": 30
        },
        {
          "dir": "img",
          "name": "c.png",
          "size": 20
        }
      ],
      "expected": "[\n  {\n    \"dir\": \"img\",\n    \"name\": \"b.png\",\n    \"size\": 30\n  }\n]"
    },
    {
      "input": [],
      "expected": "[]"
    }
  ]
}
