{
  "title": "Rows without header",
  "statement": "Give every row except the header row.\n\nThe input is a table: an array of rows. The first row is the header. Give an array with all the other rows, in the same order.",
  "reference": ".[1:]",
  "tests": [
    {
      "input": [
        [
          "name",
          "age"
        ],
        [
          "Ada",
          36
        ],
        [
          "Bo",
          41
        ]
      ],
      "expected": "[\n  [\n    \"Ada\",\n    36\n  ],\n  [\n    \"Bo\",\n    41\n  ]\n]"
    },
    {
      "input": [
        [
          "sku",
          "price"
        ]
      ],
      "expected": "[]"
    },
    {
      "input": [
        [
          "id"
        ],
        [
          1
        ],
        [
          2
        ],
        [
          3
        ]
      ],
      "expected": "[\n  [\n    1\n  ],\n  [\n    2\n  ],\n  [\n    3\n  ]\n]"
    },
    {
      "input": [
        [
          "city",
          "temp"
        ],
        [
          "Oslo",
          4
        ]
      ],
      "expected": "[\n  [\n    \"Oslo\",\n    4\n  ]\n]"
    }
  ]
}
