{
  "title": "Languages of each team",
  "statement": "For each team, print one flat list of the languages used in its repos.\n\nThe input is an array of teams. Each team has `repos`, and each repo has a list `langs`. Print one array that holds one inner array for each team, in the order of the input. A language may appear more than once.",
  "reference": "map([.repos[] | .langs[]])",
  "tests": [
    {
      "input": [
        {
          "team": "core",
          "repos": [
            {
              "name": "api",
              "langs": [
                "go",
                "sql"
              ]
            },
            {
              "name": "cli",
              "langs": [
                "go"
              ]
            }
          ]
        },
        {
          "team": "web",
          "repos": [
            {
              "name": "site",
              "langs": [
                "ts",
                "css"
              ]
            }
          ]
        }
      ],
      "expected": "[\n  [\n    \"go\",\n    \"sql\",\n    \"go\"\n  ],\n  [\n    \"ts\",\n    \"css\"\n  ]\n]"
    },
    {
      "input": [
        {
          "team": "data",
          "repos": [
            {
              "name": "etl",
              "langs": [
                "python"
              ]
            },
            {
              "name": "dash",
              "langs": [
                "ts",
                "sql"
              ]
            }
          ]
        }
      ],
      "expected": "[\n  [\n    \"python\",\n    \"ts\",\n    \"sql\"\n  ]\n]"
    },
    {
      "input": [
        {
          "team": "new",
          "repos": []
        },
        {
          "team": "ops",
          "repos": [
            {
              "name": "infra",
              "langs": [
                "hcl",
                "bash"
              ]
            },
            {
              "name": "docs",
              "langs": []
            }
          ]
        }
      ],
      "expected": "[\n  [],\n  [\n    \"hcl\",\n    \"bash\"\n  ]\n]"
    }
  ]
}
