{
  "title": "Score table rows",
  "statement": "Turn every game result into a row, and give all the rows as one array.\n\nThe results are in the `results` array. A row is an array with two items: first the player's name, then the score. The name is in `player.name` and the score is in `score`. Keep the order.",
  "reference": ".results | map([.player.name, .score])",
  "tests": [
    {
      "input": {
        "game": "chess",
        "results": [
          {
            "player": {
              "id": 4,
              "name": "Ada"
            },
            "score": 12
          },
          {
            "player": {
              "id": 9,
              "name": "Bo"
            },
            "score": 7
          }
        ]
      },
      "expected": "[\n  [\n    \"Ada\",\n    12\n  ],\n  [\n    \"Bo\",\n    7\n  ]\n]"
    },
    {
      "input": {
        "game": "go",
        "results": []
      },
      "expected": "[]"
    },
    {
      "input": {
        "game": "darts",
        "results": [
          {
            "player": {
              "id": 2,
              "name": "Cy"
            },
            "score": 0
          }
        ]
      },
      "expected": "[\n  [\n    \"Cy\",\n    0\n  ]\n]"
    }
  ]
}
