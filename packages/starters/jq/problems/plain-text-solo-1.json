{
  "title": "Version to paste",
  "statement": "Print the version of the app as plain text, with no quotes.\n\nThe version is inside `app`. The output is one line, such as `3.4.1`.",
  "mode": "command",
  "stub": "'.'",
  "reference": "-r '.app.version'",
  "tests": [
    {
      "input": {
        "app": {
          "name": "shop-api",
          "version": "3.4.1"
        },
        "env": "prod"
      },
      "expected": "3.4.1"
    },
    {
      "input": {
        "app": {
          "name": "shop-web",
          "version": "0.12.0"
        },
        "env": "staging"
      },
      "expected": "0.12.0"
    },
    {
      "input": {
        "app": {
          "name": "worker",
          "version": "1.0.0-rc.2"
        },
        "env": "dev"
      },
      "expected": "1.0.0-rc.2"
    }
  ]
}
