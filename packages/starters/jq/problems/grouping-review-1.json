{
  "title": "Busiest reviewer",
  "statement": "Print how many pull requests the busiest reviewer has.\n\nThe input is an array of pull requests. Each has one `reviewer`. Print one number: the count of the reviewer who has the most pull requests.",
  "reference": "group_by(.reviewer) | map(length) | sort | .[-1]",
  "tests": [
    {
      "input": [
        {
          "id": 71,
          "reviewer": "kim"
        },
        {
          "id": 72,
          "reviewer": "lee"
        },
        {
          "id": 73,
          "reviewer": "kim"
        },
        {
          "id": 74,
          "reviewer": "sam"
        },
        {
          "id": 75,
          "reviewer": "kim"
        }
      ],
      "expected": "3"
    },
    {
      "input": [
        {
          "id": 80,
          "reviewer": "ana"
        },
        {
          "id": 81,
          "reviewer": "ben"
        }
      ],
      "expected": "1"
    },
    {
      "input": [
        {
          "id": 90,
          "reviewer": "uma"
        },
        {
          "id": 91,
          "reviewer": "pat"
        },
        {
          "id": 92,
          "reviewer": "pat"
        },
        {
          "id": 93,
          "reviewer": "uma"
        },
        {
          "id": 94,
          "reviewer": "joy"
        },
        {
          "id": 95,
          "reviewer": "pat"
        },
        {
          "id": 96,
          "reviewer": "pat"
        }
      ],
      "expected": "4"
    }
  ]
}
