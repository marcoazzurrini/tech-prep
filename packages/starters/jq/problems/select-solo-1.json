{
  "title": "Products in stock",
  "statement": "Give the name of every product that is in stock.\n\nThe products are in the `items` array. A product is in stock when its `stock` is more than 0. Print each name as its own output.",
  "reference": ".items[] | select(.stock > 0) | .name",
  "tests": [
    {
      "input": {
        "shop": "North",
        "items": [
          {
            "name": "pen",
            "stock": 3
          },
          {
            "name": "ink",
            "stock": 0
          },
          {
            "name": "pad",
            "stock": 8
          }
        ]
      },
      "expected": "\"pen\"\n\"pad\""
    },
    {
      "input": {
        "shop": "East",
        "items": [
          {
            "name": "cap",
            "stock": 0
          }
        ]
      },
      "expected": ""
    },
    {
      "input": {
        "shop": "West",
        "items": [
          {
            "name": "mug",
            "stock": 1
          },
          {
            "name": "jar",
            "stock": 2
          }
        ]
      },
      "expected": "\"mug\"\n\"jar\""
    }
  ]
}
