{
  "title": "Disks that are too full",
  "statement": "Give the mount point of every disk that is over the limit.\n\nThe input has a `limit` and a `disks` array. Each disk has a `mount` and a `used` number. A disk is over the limit when its `used` is more than `limit`. Print each `mount` as its own output.",
  "reference": ".limit as $max | .disks[] | select(.used > $max) | .mount",
  "tests": [
    {
      "input": {
        "limit": 80,
        "disks": [
          {
            "mount": "/",
            "used": 91
          },
          {
            "mount": "/home",
            "used": 40
          },
          {
            "mount": "/var",
            "used": 85
          }
        ]
      },
      "expected": "\"/\"\n\"/var\""
    },
    {
      "input": {
        "limit": 90,
        "disks": [
          {
            "mount": "/",
            "used": 90
          }
        ]
      },
      "expected": ""
    },
    {
      "input": {
        "limit": 50,
        "disks": [
          {
            "mount": "/data",
            "used": 51
          },
          {
            "mount": "/tmp",
            "used": 3
          }
        ]
      },
      "expected": "\"/data\""
    },
    {
      "input": {
        "limit": 10,
        "disks": [
          {
            "mount": "/a",
            "used": 20
          },
          {
            "mount": "/b",
            "used": 30
          }
        ]
      },
      "expected": "\"/a\"\n\"/b\""
    }
  ]
}
