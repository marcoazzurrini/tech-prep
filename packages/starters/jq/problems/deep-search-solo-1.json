{
  "title": "Objects in the document",
  "statement": "Print how many objects the document holds, at any depth.\n\nCount the document itself too, when it is an object. The output is one number.",
  "reference": "[.. | select(type == \"object\")] | length",
  "tests": [
    {
      "input": {
        "team": "core",
        "lead": {
          "name": "Ada"
        },
        "members": [
          {
            "name": "Bo"
          },
          {
            "name": "Cy"
          }
        ]
      },
      "expected": "4"
    },
    {
      "input": {
        "team": "solo"
      },
      "expected": "1"
    },
    {
      "input": [
        {
          "a": {
            "b": {
              "c": {}
            }
          }
        },
        5,
        "x"
      ],
      "expected": "4"
    },
    {
      "input": [
        1,
        2,
        3
      ],
      "expected": "0"
    }
  ]
}
