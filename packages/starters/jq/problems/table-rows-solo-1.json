{
  "title": "Orders for a CSV file",
  "statement": "Print one CSV line for each order: its `id`, its `customer` and its `total`, in that order.\n\nThis task runs jq with `-r`. The orders are in `orders`. In a CSV line, commas separate the values and strings have double quotes.",
  "flags": [
    "-r"
  ],
  "reference": ".orders | .[] | [.id, .customer, .total] | @csv",
  "tests": [
    {
      "input": {
        "day": "2024-03-04",
        "orders": [
          {
            "id": 1041,
            "customer": "Lena Brandt",
            "total": 59.9,
            "paid": true
          },
          {
            "id": 1042,
            "customer": "Omar Haddad",
            "total": 12,
            "paid": false
          }
        ]
      },
      "expected": "1041,\"Lena Brandt\",59.9\n1042,\"Omar Haddad\",12"
    },
    {
      "input": {
        "day": "2024-03-05",
        "orders": [
          {
            "id": 1050,
            "customer": "Mori, Yuki",
            "total": 240.5,
            "paid": true
          }
        ]
      },
      "expected": "1050,\"Mori, Yuki\",240.5"
    },
    {
      "input": {
        "day": "2024-03-06",
        "orders": [
          {
            "id": 1051,
            "customer": "Kofi Mensah",
            "total": 8,
            "paid": true
          },
          {
            "id": 1052,
            "customer": "Sam Reed",
            "total": 31.25,
            "paid": true
          },
          {
            "id": 1053,
            "customer": "Ines Costa",
            "total": 99,
            "paid": false
          }
        ]
      },
      "expected": "1051,\"Kofi Mensah\",8\n1052,\"Sam Reed\",31.25\n1053,\"Ines Costa\",99"
    }
  ]
}
