{
  "title": "Trail of a page",
  "statement": "Print the trail of the page as one string.\n\nThe parts are in `trail`. Put a space, a slash and a space between two parts, as in `Home / Settings`.",
  "reference": ".trail | join(\" / \")",
  "tests": [
    {
      "input": {
        "page": "Billing",
        "trail": [
          "Home",
          "Settings",
          "Billing"
        ]
      },
      "expected": "\"Home / Settings / Billing\""
    },
    {
      "input": {
        "page": "Home",
        "trail": [
          "Home"
        ]
      },
      "expected": "\"Home\""
    },
    {
      "input": {
        "page": "Keys",
        "trail": [
          "Home",
          "Team",
          "Security",
          "Keys"
        ]
      },
      "expected": "\"Home / Team / Security / Keys\""
    }
  ]
}
