{
  "title": "Route ends",
  "statement": "Build an object with the keys `from` and `to`.\n\nThe input is a route with a `stops` array of names. `from` is the first stop. `to` is the last stop.",
  "reference": "{from: .stops[0], to: .stops[-1]}",
  "tests": [
    {
      "input": {
        "line": "R4",
        "stops": [
          "Harbor",
          "Museum",
          "Park",
          "Airport"
        ]
      },
      "expected": "{\n  \"from\": \"Harbor\",\n  \"to\": \"Airport\"\n}"
    },
    {
      "input": {
        "line": "R9",
        "stops": [
          "Depot"
        ]
      },
      "expected": "{\n  \"from\": \"Depot\",\n  \"to\": \"Depot\"\n}"
    },
    {
      "input": {
        "line": "R2",
        "stops": [
          "North",
          "South"
        ]
      },
      "expected": "{\n  \"from\": \"North\",\n  \"to\": \"South\"\n}"
    }
  ]
}
