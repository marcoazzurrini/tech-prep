{
  "title": "A valid timeout",
  "statement": "Print `true` when the timeout is a number above 0. Print `false` in every other case.\n\nThe timeout is in `timeout`. It can be a string such as `\"30\"`, or missing. Those are not valid.",
  "reference": ".timeout | type == \"number\" and . > 0",
  "tests": [
    {
      "input": {
        "service": "api",
        "timeout": "30"
      },
      "expected": "false"
    },
    {
      "input": {
        "service": "web",
        "timeout": 30
      },
      "expected": "true"
    },
    {
      "input": {
        "service": "jobs",
        "timeout": 0
      },
      "expected": "false"
    },
    {
      "input": {
        "service": "mail"
      },
      "expected": "false"
    },
    {
      "input": {
        "service": "auth",
        "timeout": 2.5
      },
      "expected": "true"
    }
  ]
}
