{
  "title": "Log lines per level",
  "statement": "Print how many log lines each level has.\n\nThe input is an array of log lines. Each has a `level`. Print one array of numbers, one number for each level, with the levels in alphabetical order.",
  "reference": "group_by(.level) | map(length)",
  "tests": [
    {
      "input": [
        {
          "level": "info",
          "msg": "started"
        },
        {
          "level": "error",
          "msg": "disk full"
        },
        {
          "level": "info",
          "msg": "request"
        },
        {
          "level": "warn",
          "msg": "slow"
        },
        {
          "level": "info",
          "msg": "stopped"
        }
      ],
      "expected": "[\n  1,\n  3,\n  1\n]"
    },
    {
      "input": [
        {
          "level": "warn",
          "msg": "retry"
        },
        {
          "level": "warn",
          "msg": "retry"
        },
        {
          "level": "error",
          "msg": "gave up"
        }
      ],
      "expected": "[\n  1,\n  2\n]"
    },
    {
      "input": [
        {
          "level": "debug",
          "msg": "tick"
        },
        {
          "level": "debug",
          "msg": "tick"
        },
        {
          "level": "debug",
          "msg": "tick"
        },
        {
          "level": "debug",
          "msg": "tick"
        }
      ],
      "expected": "[\n  4\n]"
    }
  ]
}
