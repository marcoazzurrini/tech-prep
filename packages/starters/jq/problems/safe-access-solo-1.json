{
  "title": "Messages in the log",
  "statement": "Print the `msg` of every log entry, each as its own output.\n\nMost entries are objects. Some entries are plain strings. Skip those.",
  "reference": ".[] | .msg?",
  "tests": [
    {
      "input": [
        {
          "level": "info",
          "msg": "server started"
        },
        "--- restart ---",
        {
          "level": "error",
          "msg": "disk full"
        }
      ],
      "expected": "\"server started\"\n\"disk full\""
    },
    {
      "input": [
        {
          "level": "warn",
          "msg": "slow query"
        }
      ],
      "expected": "\"slow query\""
    },
    {
      "input": [
        "--- begin ---",
        {
          "level": "info",
          "msg": "job queued"
        },
        {
          "level": "info",
          "msg": "job done"
        },
        0
      ],
      "expected": "\"job queued\"\n\"job done\""
    }
  ]
}
