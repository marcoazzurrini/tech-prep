{
  "title": "Branch names",
  "statement": "Print the name of every branch of the repository.\n\nThe branches are in the `branches` array. Print plain text: one name per line, with no quotes.",
  "mode": "command",
  "stub": "'.'",
  "reference": "-r '.branches[] | .name'",
  "tests": [
    {
      "input": {
        "repo": "api",
        "branches": [
          {
            "name": "main",
            "ahead": 0
          },
          {
            "name": "fix-login",
            "ahead": 3
          }
        ]
      },
      "expected": "main\nfix-login"
    },
    {
      "input": {
        "repo": "docs",
        "branches": [
          {
            "name": "main",
            "ahead": 0
          }
        ]
      },
      "expected": "main"
    },
    {
      "input": {
        "repo": "empty",
        "branches": []
      },
      "expected": ""
    },
    {
      "input": {
        "repo": "web",
        "branches": [
          {
            "name": "main",
            "ahead": 0
          },
          {
            "name": "dark-mode",
            "ahead": 7
          },
          {
            "name": "release-2",
            "ahead": 1
          }
        ]
      },
      "expected": "main\ndark-mode\nrelease-2"
    }
  ]
}
