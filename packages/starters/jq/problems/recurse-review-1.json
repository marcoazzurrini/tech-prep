{
  "title": "Order total",
  "statement": "Give the total price of the order.\n\nThe input is one order. An item has a `price`, or it is a bundle with an `items` array of more items. Bundles can be inside bundles. A bundle has no `price` of its own. There is always at least one `price`. Add up every `price` and give one number.",
  "reference": "[.. | .price? | select(. != null)] | add",
  "tests": [
    {
      "input": {
        "id": 501,
        "items": [
          {
            "name": "desk",
            "price": 120
          },
          {
            "name": "office set",
            "items": [
              {
                "name": "lamp",
                "price": 30
              },
              {
                "name": "cable kit",
                "items": [
                  {
                    "name": "hdmi",
                    "price": 8
                  },
                  {
                    "name": "usb",
                    "price": 5
                  }
                ]
              }
            ]
          }
        ]
      },
      "expected": "163"
    },
    {
      "input": {
        "id": 502,
        "items": [
          {
            "name": "pen",
            "price": 2
          }
        ]
      },
      "expected": "2"
    },
    {
      "input": {
        "id": 503,
        "items": [
          {
            "name": "kit",
            "items": [
              {
                "name": "a",
                "price": 10
              },
              {
                "name": "b",
                "price": 15
              }
            ]
          },
          {
            "name": "c",
            "price": 1
          }
        ]
      },
      "expected": "26"
    }
  ]
}
