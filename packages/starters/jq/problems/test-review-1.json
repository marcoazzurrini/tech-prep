{
  "title": "Source files",
  "statement": "Give the path of every TypeScript file in the `src` folder.\n\nThe input is an array of files. A file counts when its `path` starts with `src/` and ends with `.ts`. Print each path as its own output.",
  "reference": ".[] | select(.path | startswith(\"src/\") and endswith(\".ts\")) | .path",
  "tests": [
    {
      "input": [
        {
          "path": "src/main.ts",
          "size": 120
        },
        {
          "path": "src/app.css",
          "size": 40
        },
        {
          "path": "docs/api.ts",
          "size": 9
        },
        {
          "path": "src/lib/util.ts",
          "size": 77
        }
      ],
      "expected": "\"src/main.ts\"\n\"src/lib/util.ts\""
    },
    {
      "input": [
        {
          "path": "src/a.tsx",
          "size": 5
        },
        {
          "path": "lib/src/a.ts",
          "size": 6
        },
        {
          "path": "src/b.ts",
          "size": 7
        }
      ],
      "expected": "\"src/b.ts\""
    },
    {
      "input": [
        {
          "path": "srcs/c.ts",
          "size": 1
        },
        {
          "path": "src/ts",
          "size": 2
        }
      ],
      "expected": ""
    }
  ]
}
