{
  "title": "Slow requests",
  "statement": "Print how many requests were slow.\n\nThe input is an array of requests. A request was slow when it took more than 500 milliseconds. The time is under `ms`. Print one number.",
  "reference": "map(select(.ms > 500)) | length",
  "tests": [
    {
      "input": [
        {
          "path": "/",
          "ms": 120
        },
        {
          "path": "/search",
          "ms": 910
        },
        {
          "path": "/cart",
          "ms": 500
        },
        {
          "path": "/pay",
          "ms": 1340
        }
      ],
      "expected": "2"
    },
    {
      "input": [
        {
          "path": "/health",
          "ms": 4
        },
        {
          "path": "/login",
          "ms": 230
        }
      ],
      "expected": "0"
    },
    {
      "input": [
        {
          "path": "/export",
          "ms": 7200
        }
      ],
      "expected": "1"
    }
  ]
}
