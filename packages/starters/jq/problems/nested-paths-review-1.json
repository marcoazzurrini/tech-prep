{
  "title": "Runner's system",
  "statement": "Print the operating system of the job's runner.",
  "reference": ".job.runner.os",
  "tests": [
    {
      "input": {
        "job": {
          "id": 31,
          "runner": {
            "os": "linux",
            "arch": "arm64"
          }
        }
      },
      "expected": "\"linux\""
    },
    {
      "input": {
        "job": {
          "id": 32,
          "runner": {
            "os": "macos",
            "arch": "arm64"
          }
        }
      },
      "expected": "\"macos\""
    },
    {
      "input": {
        "job": {
          "id": 33,
          "runner": {
            "os": "windows",
            "arch": "x64"
          }
        }
      },
      "expected": "\"windows\""
    }
  ]
}
