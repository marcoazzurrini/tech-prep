{
  "title": "Second result's user",
  "statement": "Print the login of the user in the second result.",
  "reference": ".data.results[1].user.login",
  "tests": [
    {
      "input": {
        "data": {
          "results": [
            {
              "user": {
                "login": "ada"
              }
            },
            {
              "user": {
                "login": "bo"
              }
            }
          ]
        }
      },
      "expected": "\"bo\""
    },
    {
      "input": {
        "data": {
          "results": [
            {
              "user": {
                "login": "cy"
              }
            },
            {
              "user": {
                "login": "dee"
              }
            },
            {
              "user": {
                "login": "eli"
              }
            }
          ]
        }
      },
      "expected": "\"dee\""
    },
    {
      "input": {
        "data": {
          "results": [
            {
              "user": {
                "login": "fay"
              }
            },
            {
              "user": {
                "login": "gus"
              }
            }
          ]
        }
      },
      "expected": "\"gus\""
    }
  ]
}
