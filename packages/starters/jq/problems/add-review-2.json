{
  "title": "Order totals",
  "statement": "Give the total price of each order.\n\nThe input is an array of orders. Each has an `id` and a `prices` array with the price of every item in it. Every order has at least one price. Give an array with one object for each order, in the same order as the input. Each object has the `id` and a `total`: the sum of the prices.",
  "reference": "map({id, total: (.prices | add)})",
  "tests": [
    {
      "input": [
        {
          "id": "o-1",
          "prices": [
            12,
            30,
            8
          ]
        },
        {
          "id": "o-2",
          "prices": [
            99
          ]
        }
      ],
      "expected": "[\n  {\n    \"id\": \"o-1\",\n    \"total\": 50\n  },\n  {\n    \"id\": \"o-2\",\n    \"total\": 99\n  }\n]"
    },
    {
      "input": [
        {
          "id": "o-3",
          "prices": [
            1.5,
            2.5
          ]
        }
      ],
      "expected": "[\n  {\n    \"id\": \"o-3\",\n    \"total\": 4\n  }\n]"
    },
    {
      "input": [],
      "expected": "[]"
    },
    {
      "input": [
        {
          "id": "o-4",
          "prices": [
            5,
            5,
            5,
            5
          ]
        },
        {
          "id": "o-5",
          "prices": [
            20,
            1
          ]
        },
        {
          "id": "o-6",
          "prices": [
            7
          ]
        }
      ],
      "expected": "[\n  {\n    \"id\": \"o-4\",\n    \"total\": 20\n  },\n  {\n    \"id\": \"o-5\",\n    \"total\": 21\n  },\n  {\n    \"id\": \"o-6\",\n    \"total\": 7\n  }\n]"
    }
  ]
}
