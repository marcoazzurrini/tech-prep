{
  "title": "File extensions",
  "statement": "Give every file extension in the list, each one once.\n\nThe input is an array of file names. Each name has exactly one `.`. The extension is the part after it. Give one array of extensions, from a to z.",
  "reference": "map(split(\".\") | .[1]) | unique",
  "tests": [
    {
      "input": [
        "app.js",
        "index.html",
        "util.js",
        "logo.png",
        "site.html"
      ],
      "expected": "[\n  \"html\",\n  \"js\",\n  \"png\"\n]"
    },
    {
      "input": [
        "notes.md"
      ],
      "expected": "[\n  \"md\"\n]"
    },
    {
      "input": [],
      "expected": "[]"
    },
    {
      "input": [
        "x.go",
        "y.go",
        "z.go"
      ],
      "expected": "[\n  \"go\"\n]"
    }
  ]
}
