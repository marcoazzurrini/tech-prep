{
  "title": "Timeout messages",
  "statement": "Give the message of every log entry about a timeout.\n\nThe input is an array of log entries. An entry is about a timeout when its `msg` has the text `timeout` somewhere in it. Print each `msg` as its own output.",
  "reference": ".[] | select(.msg | contains(\"timeout\")) | .msg",
  "tests": [
    {
      "input": [
        {
          "level": "error",
          "msg": "db timeout after 30s"
        },
        {
          "level": "info",
          "msg": "server started"
        },
        {
          "level": "warn",
          "msg": "timeout on retry 2"
        }
      ],
      "expected": "\"db timeout after 30s\"\n\"timeout on retry 2\""
    },
    {
      "input": [
        {
          "level": "timeout",
          "msg": "all good"
        }
      ],
      "expected": ""
    },
    {
      "input": [
        {
          "level": "error",
          "msg": "read timeouts: 3"
        },
        {
          "level": "info",
          "msg": "time out of range"
        }
      ],
      "expected": "\"read timeouts: 3\""
    }
  ]
}
