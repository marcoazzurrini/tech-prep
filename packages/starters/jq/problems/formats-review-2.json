{
  "title": "Failed builds report",
  "statement": "Print one CSV line for each build that failed.\n\nThe input is an array of builds. A build failed when its `result` is `failed`. Each line has the `id`, then the `branch`. This task runs jq with `-r`. In CSV, a string is in double quotes and a number is not. The values have a comma between them and no spaces.",
  "reference": ".[] | select(.result == \"failed\") | [.id, .branch] | @csv",
  "flags": [
    "-r"
  ],
  "tests": [
    {
      "input": [
        {
          "id": 101,
          "branch": "main",
          "result": "failed"
        },
        {
          "id": 102,
          "branch": "dev",
          "result": "passed"
        },
        {
          "id": 103,
          "branch": "fix/login",
          "result": "failed"
        }
      ],
      "expected": "101,\"main\"\n103,\"fix/login\""
    },
    {
      "input": [
        {
          "id": 201,
          "branch": "main",
          "result": "passed"
        }
      ],
      "expected": ""
    },
    {
      "input": [
        {
          "id": 301,
          "branch": "release",
          "result": "failed"
        },
        {
          "id": 302,
          "branch": "dev",
          "result": "skipped"
        }
      ],
      "expected": "301,\"release\""
    }
  ]
}
