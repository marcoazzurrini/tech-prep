{
  "title": "The last job is cancelled",
  "statement": "The last job of the pipeline was cancelled. Print the whole pipeline, without its last job.\n\nA pipeline can have any number of jobs. `id` and `branch` stay as they are, and `jobs` is still an array.",
  "reference": "del(.jobs[-1])",
  "tests": [
    {
      "input": {
        "id": 88,
        "branch": "main",
        "jobs": [
          "lint",
          "test",
          "deploy"
        ]
      },
      "expected": "{\n  \"id\": 88,\n  \"branch\": \"main\",\n  \"jobs\": [\n    \"lint\",\n    \"test\"\n  ]\n}"
    },
    {
      "input": {
        "id": 89,
        "branch": "fix-login",
        "jobs": [
          "lint"
        ]
      },
      "expected": "{\n  \"id\": 89,\n  \"branch\": \"fix-login\",\n  \"jobs\": []\n}"
    },
    {
      "input": {
        "id": 90,
        "branch": "main",
        "jobs": [
          "lint",
          "test",
          "build",
          "scan",
          "deploy"
        ]
      },
      "expected": "{\n  \"id\": 90,\n  \"branch\": \"main\",\n  \"jobs\": [\n    \"lint\",\n    \"test\",\n    \"build\",\n    \"scan\"\n  ]\n}"
    }
  ]
}
