{
  "title": "Theme of the app",
  "statement": "Print the theme from the user's settings. When no theme is set, print `\"light\"`.\n\nThe theme is under `settings`, in the key `theme`. It can be missing or `null`.",
  "reference": ".settings.theme // \"light\"",
  "tests": [
    {
      "input": {
        "user": "ada",
        "settings": {
          "lang": "en",
          "theme": null
        }
      },
      "expected": "\"light\""
    },
    {
      "input": {
        "user": "bo",
        "settings": {
          "lang": "no",
          "theme": "dark"
        }
      },
      "expected": "\"dark\""
    },
    {
      "input": {
        "user": "cy",
        "settings": {
          "lang": "en"
        }
      },
      "expected": "\"light\""
    },
    {
      "input": {
        "user": "dee",
        "settings": {
          "lang": "de",
          "theme": "contrast"
        }
      },
      "expected": "\"contrast\""
    }
  ]
}
