{
  "title": "Names of the pods",
  "statement": "Print the name of every pod as plain text, one per line, with no quotes.\n\nThe pods are in `items`. The name of a pod is inside its `metadata`. Keep the pods in the same order.",
  "mode": "command",
  "stub": "'.'",
  "reference": "-r '.items | .[] | .metadata.name'",
  "tests": [
    {
      "input": {
        "kind": "PodList",
        "items": [
          {
            "metadata": {
              "name": "api-7f9c",
              "namespace": "prod"
            },
            "ready": true
          },
          {
            "metadata": {
              "name": "worker-2b1d",
              "namespace": "prod"
            },
            "ready": false
          }
        ]
      },
      "expected": "api-7f9c\nworker-2b1d"
    },
    {
      "input": {
        "kind": "PodList",
        "items": [
          {
            "metadata": {
              "name": "cron-55aa",
              "namespace": "jobs"
            },
            "ready": true
          }
        ]
      },
      "expected": "cron-55aa"
    },
    {
      "input": {
        "kind": "PodList",
        "items": [
          {
            "metadata": {
              "name": "web-1a2b",
              "namespace": "prod"
            },
            "ready": true
          },
          {
            "metadata": {
              "name": "web-3c4d",
              "namespace": "prod"
            },
            "ready": true
          },
          {
            "metadata": {
              "name": "db-0",
              "namespace": "data"
            },
            "ready": true
          }
        ]
      },
      "expected": "web-1a2b\nweb-3c4d\ndb-0"
    }
  ]
}
