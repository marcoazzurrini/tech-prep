{
  "title": "Pinned dependencies",
  "statement": "Print every dependency as a line of the form `name@version`.\n\nThe dependencies are in the `dependencies` array. Each has a `name` and a `version`. Print plain text: one line per dependency, with no quotes. For example `chalk@5.3.0`.",
  "mode": "command",
  "stub": "'.'",
  "reference": "-r '.dependencies[] | \"\\(.name)@\\(.version)\"'",
  "tests": [
    {
      "input": {
        "dependencies": [
          {
            "name": "chalk",
            "version": "5.3.0"
          },
          {
            "name": "yargs",
            "version": "17.7.2"
          }
        ]
      },
      "expected": "chalk@5.3.0\nyargs@17.7.2"
    },
    {
      "input": {
        "dependencies": [
          {
            "name": "zod",
            "version": "3.22.4"
          }
        ]
      },
      "expected": "zod@3.22.4"
    },
    {
      "input": {
        "dependencies": []
      },
      "expected": ""
    },
    {
      "input": {
        "dependencies": [
          {
            "name": "ms",
            "version": "2.1.3"
          },
          {
            "name": "debug",
            "version": "4.3.4"
          },
          {
            "name": "semver",
            "version": "7.6.0"
          }
        ]
      },
      "expected": "ms@2.1.3\ndebug@4.3.4\nsemver@7.6.0"
    }
  ]
}
