{
  "title": "Scripts of a package",
  "statement": "Print the scripts of the package on one line.\n\nThe scripts are the object under `scripts`. Print the whole object on one line, with no spaces.",
  "mode": "command",
  "stub": "'.'",
  "reference": "-c '.scripts'",
  "tests": [
    {
      "input": {
        "name": "shop",
        "version": "2.1.0",
        "scripts": {
          "build": "tsc",
          "test": "vitest",
          "lint": "eslint"
        }
      },
      "expected": "{\"build\":\"tsc\",\"test\":\"vitest\",\"lint\":\"eslint\"}"
    },
    {
      "input": {
        "name": "cli",
        "version": "0.4.2",
        "scripts": {
          "start": "node"
        }
      },
      "expected": "{\"start\":\"node\"}"
    },
    {
      "input": {
        "name": "notes",
        "version": "1.0.0",
        "scripts": {}
      },
      "expected": "{}"
    }
  ]
}
