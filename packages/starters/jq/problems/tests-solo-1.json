{
  "title": "Did the command fail?",
  "statement": "Print `true` when the command failed, and `false` when it did not.\n\nA command failed when its `exit_code` is anything other than `0`.",
  "reference": ".exit_code != 0",
  "tests": [
    {
      "input": {
        "cmd": "npm test",
        "exit_code": 1,
        "seconds": 12
      },
      "expected": "true"
    },
    {
      "input": {
        "cmd": "npm run build",
        "exit_code": 0,
        "seconds": 48
      },
      "expected": "false"
    },
    {
      "input": {
        "cmd": "make deploy",
        "exit_code": 127,
        "seconds": 1
      },
      "expected": "true"
    }
  ]
}
