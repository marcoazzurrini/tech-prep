{
  "title": "Records without dates",
  "statement": "Give the reply without the dates of its records.\n\nThe input is one API reply. Its records are in the `data` array. Each record has a `created_at` and an `updated_at`. Take both out of every record. Give the whole reply back, with every other field as it is.",
  "reference": "del(.data[] | .created_at, .updated_at)",
  "tests": [
    {
      "input": {
        "page": 1,
        "data": [
          {
            "id": 1,
            "name": "Ada",
            "created_at": "2024-01-05",
            "updated_at": "2024-02-01"
          },
          {
            "id": 2,
            "name": "Bo",
            "created_at": "2024-03-10",
            "updated_at": "2024-03-11"
          }
        ]
      },
      "expected": "{\n  \"page\": 1,\n  \"data\": [\n    {\n      \"id\": 1,\n      \"name\": \"Ada\"\n    },\n    {\n      \"id\": 2,\n      \"name\": \"Bo\"\n    }\n  ]\n}"
    },
    {
      "input": {
        "page": 3,
        "data": []
      },
      "expected": "{\n  \"page\": 3,\n  \"data\": []\n}"
    },
    {
      "input": {
        "page": 2,
        "total": 1,
        "data": [
          {
            "id": 9,
            "name": "Cy",
            "created_at": "2023-12-01",
            "updated_at": "2023-12-01"
          }
        ]
      },
      "expected": "{\n  \"page\": 2,\n  \"total\": 1,\n  \"data\": [\n    {\n      \"id\": 9,\n      \"name\": \"Cy\"\n    }\n  ]\n}"
    }
  ]
}
