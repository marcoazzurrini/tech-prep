{
  "title": "Late tasks",
  "statement": "For every project, list the tasks that take too long.\n\nThe input is an array of projects. Each project has a `project` name, a `max_days` number and a `tasks` array. Each task has a `title` and `days`. A task takes too long when its `days` is more than the `max_days` of its own project. Give an array with one object for each project. Each object has `project`, the name, and `late`, an array of the titles of its tasks that take too long.",
  "reference": "map(.max_days as $max | {project, late: (.tasks | map(select(.days > $max) | .title))})",
  "tests": [
    {
      "input": [
        {
          "project": "site",
          "max_days": 3,
          "tasks": [
            {
              "title": "design",
              "days": 2
            },
            {
              "title": "build",
              "days": 5
            }
          ]
        },
        {
          "project": "app",
          "max_days": 6,
          "tasks": [
            {
              "title": "login",
              "days": 5
            },
            {
              "title": "sync",
              "days": 9
            }
          ]
        }
      ],
      "expected": "[\n  {\n    \"project\": \"site\",\n    \"late\": [\n      \"build\"\n    ]\n  },\n  {\n    \"project\": \"app\",\n    \"late\": [\n      \"sync\"\n    ]\n  }\n]"
    },
    {
      "input": [
        {
          "project": "docs",
          "max_days": 2,
          "tasks": [
            {
              "title": "intro",
              "days": 2
            }
          ]
        }
      ],
      "expected": "[\n  {\n    \"project\": \"docs\",\n    \"late\": []\n  }\n]"
    },
    {
      "input": [],
      "expected": "[]"
    },
    {
      "input": [
        {
          "project": "api",
          "max_days": 1,
          "tasks": [
            {
              "title": "auth",
              "days": 4
            },
            {
              "title": "rate",
              "days": 2
            }
          ]
        },
        {
          "project": "cli",
          "max_days": 4,
          "tasks": []
        }
      ],
      "expected": "[\n  {\n    \"project\": \"api\",\n    \"late\": [\n      \"auth\",\n      \"rate\"\n    ]\n  },\n  {\n    \"project\": \"cli\",\n    \"late\": []\n  }\n]"
    }
  ]
}
