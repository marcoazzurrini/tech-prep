{
  "title": "Commit authors",
  "statement": "For every commit, give an object with the keys `sha` and `author`.\n\nThe input is an array of commits. `sha` is the commit's `sha`. `author` is the `name` inside the commit's `author` object. Print each object as its own output.",
  "reference": ".[] | {sha, author: .author.name}",
  "tests": [
    {
      "input": [
        {
          "sha": "a1f3",
          "message": "Fix login",
          "author": {
            "name": "Ada",
            "email": "ada@example.com"
          }
        },
        {
          "sha": "9c2e",
          "message": "Add tests",
          "author": {
            "name": "Bo",
            "email": "bo@example.com"
          }
        }
      ],
      "expected": "{\n  \"sha\": \"a1f3\",\n  \"author\": \"Ada\"\n}\n{\n  \"sha\": \"9c2e\",\n  \"author\": \"Bo\"\n}"
    },
    {
      "input": [],
      "expected": ""
    },
    {
      "input": [
        {
          "sha": "77b0",
          "message": "Bump version",
          "author": {
            "name": "Cy",
            "email": "cy@example.com"
          }
        }
      ],
      "expected": "{\n  \"sha\": \"77b0\",\n  \"author\": \"Cy\"\n}"
    }
  ]
}
