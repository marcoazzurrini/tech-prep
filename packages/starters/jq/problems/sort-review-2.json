{
  "title": "Most downloaded packages",
  "statement": "Give the names of the three packages with the most downloads.\n\nThe input is an array of packages. Each has a `name` and a number of `downloads`. No two packages have the same number. Give one array of names back, with the most downloaded package first. When there are fewer than three packages, give all the names.",
  "reference": "sort_by(.downloads) | reverse | .[0:3] | map(.name)",
  "tests": [
    {
      "input": [
        {
          "name": "left-pad",
          "downloads": 310
        },
        {
          "name": "chalk",
          "downloads": 9800
        },
        {
          "name": "ms",
          "downloads": 4200
        },
        {
          "name": "glob",
          "downloads": 7600
        },
        {
          "name": "tiny",
          "downloads": 15
        }
      ],
      "expected": "[\n  \"chalk\",\n  \"glob\",\n  \"ms\"\n]"
    },
    {
      "input": [
        {
          "name": "yaml",
          "downloads": 50
        },
        {
          "name": "toml",
          "downloads": 80
        }
      ],
      "expected": "[\n  \"toml\",\n  \"yaml\"\n]"
    },
    {
      "input": [
        {
          "name": "solo",
          "downloads": 1
        }
      ],
      "expected": "[\n  \"solo\"\n]"
    },
    {
      "input": [
        {
          "name": "a",
          "downloads": 4
        },
        {
          "name": "b",
          "downloads": 3
        },
        {
          "name": "c",
          "downloads": 2
        },
        {
          "name": "d",
          "downloads": 1
        }
      ],
      "expected": "[\n  \"a\",\n  \"b\",\n  \"c\"\n]"
    }
  ]
}
