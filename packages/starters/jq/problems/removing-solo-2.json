{
  "title": "A profile to share",
  "statement": "Print the user's profile, without the two secret keys: `password` and `reset_token`.\n\nThe output is one object. Everything else stays as it is.",
  "reference": "del(.password, .reset_token)",
  "tests": [
    {
      "input": {
        "name": "Ada",
        "city": "Oslo",
        "password": "h$2a",
        "reset_token": "r-501"
      },
      "expected": "{\n  \"name\": \"Ada\",\n  \"city\": \"Oslo\"\n}"
    },
    {
      "input": {
        "name": "Bo",
        "city": "Bergen",
        "password": "p!88"
      },
      "expected": "{\n  \"name\": \"Bo\",\n  \"city\": \"Bergen\"\n}"
    },
    {
      "input": {
        "name": "Cy",
        "city": "Tromsø",
        "reset_token": "r-930",
        "password": "zz1Q"
      },
      "expected": "{\n  \"name\": \"Cy\",\n  \"city\": \"Tromsø\"\n}"
    }
  ]
}
