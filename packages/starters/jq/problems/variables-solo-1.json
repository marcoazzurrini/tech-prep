{
  "title": "Files of a release",
  "statement": "Label every file with the version of its release.\n\nThe input has a `version` and a `files` array of file names. Give an array with one object for each file. Each object has `file`, the file name, and `version`, the version of the release.",
  "reference": ".version as $v | .files | map({file: ., version: $v})",
  "tests": [
    {
      "input": {
        "version": "2.1.0",
        "files": [
          "app.js",
          "app.css"
        ]
      },
      "expected": "[\n  {\n    \"file\": \"app.js\",\n    \"version\": \"2.1.0\"\n  },\n  {\n    \"file\": \"app.css\",\n    \"version\": \"2.1.0\"\n  }\n]"
    },
    {
      "input": {
        "version": "0.9.3",
        "files": [
          "cli.tar.gz"
        ]
      },
      "expected": "[\n  {\n    \"file\": \"cli.tar.gz\",\n    \"version\": \"0.9.3\"\n  }\n]"
    },
    {
      "input": {
        "version": "1.0.0",
        "files": []
      },
      "expected": "[]"
    },
    {
      "input": {
        "version": "3.0.0-beta",
        "files": [
          "a.zip",
          "b.zip",
          "c.zip"
        ]
      },
      "expected": "[\n  {\n    \"file\": \"a.zip\",\n    \"version\": \"3.0.0-beta\"\n  },\n  {\n    \"file\": \"b.zip\",\n    \"version\": \"3.0.0-beta\"\n  },\n  {\n    \"file\": \"c.zip\",\n    \"version\": \"3.0.0-beta\"\n  }\n]"
    }
  ]
}
