{
  "title": "Beta choice made",
  "statement": "Give the name of every user who has made a choice about the beta.\n\nThe input is an array of users. Each user has a `flags` object. A user has made a choice when `flags` holds the key `beta`, whatever its value: `true`, `false` or `null`. Give one array of names, in the same order.",
  "reference": "map(select(.flags | has(\"beta\")) | .name)",
  "tests": [
    {
      "input": [
        {
          "name": "Ada",
          "flags": {
            "beta": true
          }
        },
        {
          "name": "Bo",
          "flags": {
            "dark": true
          }
        },
        {
          "name": "Cy",
          "flags": {
            "beta": false
          }
        },
        {
          "name": "Dee",
          "flags": {
            "beta": null,
            "dark": false
          }
        }
      ],
      "expected": "[\n  \"Ada\",\n  \"Cy\",\n  \"Dee\"\n]"
    },
    {
      "input": [
        {
          "name": "Eli",
          "flags": {}
        }
      ],
      "expected": "[]"
    },
    {
      "input": [
        {
          "name": "Fay",
          "flags": {
            "beta": null
          }
        }
      ],
      "expected": "[\n  \"Fay\"\n]"
    },
    {
      "input": [],
      "expected": "[]"
    }
  ]
}
