{
  "title": "Result of a build",
  "statement": "Print the status of the build, and then how long it took in milliseconds.\n\nThe time is `duration_ms`, inside `timing`. Each value is its own output.",
  "reference": ".status, .timing.duration_ms",
  "tests": [
    {
      "input": {
        "id": 88,
        "status": "passed",
        "timing": {
          "queued_ms": 310,
          "duration_ms": 48200
        }
      },
      "expected": "\"passed\"\n48200"
    },
    {
      "input": {
        "id": 89,
        "status": "failed",
        "timing": {
          "queued_ms": 95,
          "duration_ms": 6120
        }
      },
      "expected": "\"failed\"\n6120"
    },
    {
      "input": {
        "id": 90,
        "status": "cancelled",
        "timing": {
          "queued_ms": 1200,
          "duration_ms": 0
        }
      },
      "expected": "\"cancelled\"\n0"
    }
  ]
}
