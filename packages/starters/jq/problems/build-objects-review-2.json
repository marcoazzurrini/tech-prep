{
  "title": "Pods and their phase",
  "statement": "Print one array with a small object for each pod in `items`.\n\nEach small object has two keys: `name`, from the pod's `metadata`, and `phase`, from the pod's `status`. Keep the pods in the same order.",
  "reference": "[.items | .[] | {name: .metadata.name, phase: .status.phase}]",
  "tests": [
    {
      "input": {
        "kind": "PodList",
        "items": [
          {
            "metadata": {
              "name": "api-7f9c",
              "namespace": "prod"
            },
            "status": {
              "phase": "Running",
              "restarts": 0
            }
          },
          {
            "metadata": {
              "name": "worker-2b1d",
              "namespace": "prod"
            },
            "status": {
              "phase": "Pending",
              "restarts": 3
            }
          }
        ]
      },
      "expected": "[\n  {\n    \"name\": \"api-7f9c\",\n    \"phase\": \"Running\"\n  },\n  {\n    \"name\": \"worker-2b1d\",\n    \"phase\": \"Pending\"\n  }\n]"
    },
    {
      "input": {
        "kind": "PodList",
        "items": [
          {
            "metadata": {
              "name": "cron-55aa",
              "namespace": "jobs"
            },
            "status": {
              "phase": "Succeeded",
              "restarts": 0
            }
          }
        ]
      },
      "expected": "[\n  {\n    \"name\": \"cron-55aa\",\n    \"phase\": \"Succeeded\"\n  }\n]"
    },
    {
      "input": {
        "kind": "PodList",
        "items": []
      },
      "expected": "[]"
    }
  ]
}
