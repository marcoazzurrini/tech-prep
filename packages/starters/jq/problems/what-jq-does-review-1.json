{
  "title": "Read the reply",
  "statement": "Print the whole reply, unchanged, so that it is easy to read.",
  "stub": "",
  "reference": ".",
  "tests": [
    {
      "input": {
        "service": "mail",
        "healthy": true,
        "queue": 4
      },
      "expected": "{\n  \"service\": \"mail\",\n  \"healthy\": true,\n  \"queue\": 4\n}"
    },
    {
      "input": {
        "service": "auth",
        "healthy": false,
        "queue": 0
      },
      "expected": "{\n  \"service\": \"auth\",\n  \"healthy\": false,\n  \"queue\": 0\n}"
    },
    {
      "input": {
        "service": "cdn"
      },
      "expected": "{\n  \"service\": \"cdn\"\n}"
    }
  ]
}
