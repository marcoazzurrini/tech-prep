{
  "title": "Email addresses",
  "statement": "Build an email address for every user.\n\nThe input is an array of users with a `login`. An address is the login, then `@`, then the domain. Pass the domain `example.com` to jq as the variable `$domain`. Print each address as its own output, as JSON with quotes. For example `\"ada@example.com\"`.",
  "mode": "command",
  "stub": "'.'",
  "reference": "--arg domain example.com '.[] | \"\\(.login)@\\($domain)\"'",
  "tests": [
    {
      "input": [
        {
          "login": "ada"
        },
        {
          "login": "bo"
        }
      ],
      "expected": "\"ada@example.com\"\n\"bo@example.com\""
    },
    {
      "input": [
        {
          "login": "cy"
        }
      ],
      "expected": "\"cy@example.com\""
    },
    {
      "input": [
        {
          "login": "dee"
        },
        {
          "login": "eli"
        },
        {
          "login": "fay"
        }
      ],
      "expected": "\"dee@example.com\"\n\"eli@example.com\"\n\"fay@example.com\""
    },
    {
      "input": [],
      "expected": ""
    }
  ]
}
