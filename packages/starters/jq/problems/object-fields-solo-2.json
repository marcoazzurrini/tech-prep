{
  "title": "Request id",
  "statement": "Print the request id of the reply.",
  "reference": ".[\"x-request-id\"]",
  "tests": [
    {
      "input": {
        "x-request-id": "req-71",
        "status": 200
      },
      "expected": "\"req-71\""
    },
    {
      "input": {
        "x-request-id": "req-72",
        "status": 404
      },
      "expected": "\"req-72\""
    },
    {
      "input": {
        "x-request-id": "req-90",
        "status": 500
      },
      "expected": "\"req-90\""
    }
  ]
}
