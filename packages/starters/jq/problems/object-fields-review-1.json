{
  "title": "Package version",
  "statement": "Print the version of the package.",
  "reference": ".version",
  "tests": [
    {
      "input": {
        "name": "left-pad",
        "version": "1.3.0",
        "license": "MIT"
      },
      "expected": "\"1.3.0\""
    },
    {
      "input": {
        "name": "chalk",
        "version": "5.3.0",
        "license": "MIT"
      },
      "expected": "\"5.3.0\""
    },
    {
      "input": {
        "name": "zod",
        "version": "4.6.5",
        "license": "MIT"
      },
      "expected": "\"4.6.5\""
    }
  ]
}
