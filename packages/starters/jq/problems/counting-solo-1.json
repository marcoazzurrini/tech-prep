{
  "title": "Open tickets",
  "statement": "Print how many tickets of the project are open.\n\nThe tickets are under `tickets`. Each ticket has `open`, which holds `true` or `false`. Print one number.",
  "reference": ".tickets | map(select(.open)) | length",
  "tests": [
    {
      "input": {
        "project": "api",
        "tickets": [
          {
            "id": 1,
            "open": true
          },
          {
            "id": 2,
            "open": false
          },
          {
            "id": 3,
            "open": true
          },
          {
            "id": 4,
            "open": true
          }
        ]
      },
      "expected": "3"
    },
    {
      "input": {
        "project": "web",
        "tickets": [
          {
            "id": 9,
            "open": false
          }
        ]
      },
      "expected": "0"
    },
    {
      "input": {
        "project": "docs",
        "tickets": [
          {
            "id": 20,
            "open": true
          },
          {
            "id": 21,
            "open": false
          }
        ]
      },
      "expected": "1"
    }
  ]
}
