{
  "title": "Row labels",
  "statement": "Give one array with the first item of every row.\n\nThe input is an array of rows. Each row is an array: a label, then a number. Keep the order of the rows.",
  "reference": "[.[] | .[0]]",
  "tests": [
    {
      "input": [
        [
          "cpu",
          71
        ],
        [
          "memory",
          48
        ],
        [
          "disk",
          90
        ]
      ],
      "expected": "[\n  \"cpu\",\n  \"memory\",\n  \"disk\"\n]"
    },
    {
      "input": [
        [
          "requests",
          1200
        ]
      ],
      "expected": "[\n  \"requests\"\n]"
    },
    {
      "input": [],
      "expected": "[]"
    },
    {
      "input": [
        [
          "up",
          1
        ],
        [
          "up",
          0
        ]
      ],
      "expected": "[\n  \"up\",\n  \"up\"\n]"
    }
  ]
}
