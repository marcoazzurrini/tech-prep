{
  "title": "Codes in each order",
  "statement": "Give the product codes of every order, as an array of arrays.\n\nThe input is an array of orders. Each order has an `items` array, and each item has a `sku`. The result has one inner array for each order. An inner array holds the `sku` of every item of that order. Keep the order of the orders and of the items.",
  "reference": "map(.items | map(.sku))",
  "tests": [
    {
      "input": [
        {
          "id": 1,
          "items": [
            {
              "sku": "PEN-1",
              "qty": 2
            },
            {
              "sku": "INK-9",
              "qty": 1
            }
          ]
        },
        {
          "id": 2,
          "items": [
            {
              "sku": "PAD-4",
              "qty": 5
            }
          ]
        }
      ],
      "expected": "[\n  [\n    \"PEN-1\",\n    \"INK-9\"\n  ],\n  [\n    \"PAD-4\"\n  ]\n]"
    },
    {
      "input": [],
      "expected": "[]"
    },
    {
      "input": [
        {
          "id": 7,
          "items": []
        },
        {
          "id": 8,
          "items": [
            {
              "sku": "MUG-2",
              "qty": 1
            }
          ]
        }
      ],
      "expected": "[\n  [],\n  [\n    \"MUG-2\"\n  ]\n]"
    },
    {
      "input": [
        {
          "id": 9,
          "items": [
            {
              "sku": "CAP-3",
              "qty": 1
            },
            {
              "sku": "CAP-3",
              "qty": 4
            }
          ]
        }
      ],
      "expected": "[\n  [\n    \"CAP-3\",\n    \"CAP-3\"\n  ]\n]"
    }
  ]
}
