{
  "title": "Retry setting",
  "statement": "Give the settings of a job, with a value for `retries` in every case.\n\nThe input is one job. Give one object with two keys: `name` and `retries`. When the job has no `retries`, or it is `null`, use `3`. A `retries` of `0` is a real value: keep it.",
  "reference": "{name, retries: (.retries // 3)}",
  "tests": [
    {
      "input": {
        "name": "backup",
        "schedule": "daily"
      },
      "expected": "{\n  \"name\": \"backup\",\n  \"retries\": 3\n}"
    },
    {
      "input": {
        "name": "deploy",
        "retries": 0
      },
      "expected": "{\n  \"name\": \"deploy\",\n  \"retries\": 0\n}"
    },
    {
      "input": {
        "name": "report",
        "retries": 5,
        "schedule": "weekly"
      },
      "expected": "{\n  \"name\": \"report\",\n  \"retries\": 5\n}"
    },
    {
      "input": {
        "name": "cleanup",
        "retries": null
      },
      "expected": "{\n  \"name\": \"cleanup\",\n  \"retries\": 3\n}"
    }
  ]
}
