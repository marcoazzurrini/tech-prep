{
  "title": "Last line of the log",
  "statement": "Print the last line of the log as plain text, with no quotes.\n\nThe lines are in `lines`. There can be any number of lines. The output is one line of text.",
  "mode": "command",
  "stub": "'.'",
  "reference": "-r '.lines[-1]'",
  "tests": [
    {
      "input": {
        "job": "deploy",
        "lines": [
          "Pulling image",
          "Starting 3 containers",
          "Deploy finished"
        ]
      },
      "expected": "Deploy finished"
    },
    {
      "input": {
        "job": "test",
        "lines": [
          "Running 212 tests",
          "2 tests failed"
        ]
      },
      "expected": "2 tests failed"
    },
    {
      "input": {
        "job": "lint",
        "lines": [
          "No problems found"
        ]
      },
      "expected": "No problems found"
    }
  ]
}
