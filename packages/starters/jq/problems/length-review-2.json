{
  "title": "Frequent customers",
  "statement": "Give the name of every customer who has at least 3 orders, as one array.\n\nThe input is an array of customers. Each customer has a `name` and an `orders` array with one id for each order. Keep the order of the customers.",
  "reference": "map(select(.orders | length >= 3) | .name)",
  "tests": [
    {
      "input": [
        {
          "name": "Ada",
          "orders": [
            1042,
            1077,
            1090
          ]
        },
        {
          "name": "Bo",
          "orders": []
        },
        {
          "name": "Cy",
          "orders": [
            1101,
            1102
          ]
        },
        {
          "name": "Dee",
          "orders": [
            1200,
            1201,
            1202,
            1203
          ]
        }
      ],
      "expected": "[\n  \"Ada\",\n  \"Dee\"\n]"
    },
    {
      "input": [],
      "expected": "[]"
    },
    {
      "input": [
        {
          "name": "Eli",
          "orders": [
            2001,
            2002
          ]
        },
        {
          "name": "Fay",
          "orders": [
            3001,
            3002,
            3003
          ]
        }
      ],
      "expected": "[\n  \"Fay\"\n]"
    },
    {
      "input": [
        {
          "name": "Gus",
          "orders": [
            5,
            5,
            5
          ]
        }
      ],
      "expected": "[\n  \"Gus\"\n]"
    }
  ]
}
