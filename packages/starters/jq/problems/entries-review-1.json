{
  "title": "Newest release",
  "statement": "Print the newest release of the package.\n\n`releases` gives the version for each date, with the oldest date first. Print one object with `date` and `version`.",
  "reference": ".releases | to_entries | .[-1] | {date: .key, version: .value}",
  "tests": [
    {
      "input": {
        "package": "left-pad",
        "releases": {
          "2024-03-01": "1.0.0",
          "2025-01-15": "1.1.0",
          "2026-02-09": "2.0.0"
        }
      },
      "expected": "{\n  \"date\": \"2026-02-09\",\n  \"version\": \"2.0.0\"\n}"
    },
    {
      "input": {
        "package": "tiny-log",
        "releases": {
          "2025-11-30": "0.1.0"
        }
      },
      "expected": "{\n  \"date\": \"2025-11-30\",\n  \"version\": \"0.1.0\"\n}"
    },
    {
      "input": {
        "package": "fast-csv",
        "releases": {
          "2023-06-12": "3.0.0",
          "2024-08-20": "3.1.0"
        }
      },
      "expected": "{\n  \"date\": \"2024-08-20\",\n  \"version\": \"3.1.0\"\n}"
    }
  ]
}
