{
  "title": "Issue link",
  "statement": "Give the web link of the issue.\n\nThe input has a `repo` and a `number`. The link has the form `https://example.com/REPO/issues/NUMBER`, for example `\"https://example.com/acme/api/issues/42\"`. The output is one string.",
  "reference": "\"https://example.com/\\(.repo)/issues/\\(.number)\"",
  "tests": [
    {
      "input": {
        "repo": "acme/api",
        "number": 42,
        "title": "Login fails"
      },
      "expected": "\"https://example.com/acme/api/issues/42\""
    },
    {
      "input": {
        "repo": "acme/ui",
        "number": 7,
        "title": "Button is cut off"
      },
      "expected": "\"https://example.com/acme/ui/issues/7\""
    },
    {
      "input": {
        "repo": "tools/cli",
        "number": 1300,
        "title": "Add a flag"
      },
      "expected": "\"https://example.com/tools/cli/issues/1300\""
    }
  ]
}
