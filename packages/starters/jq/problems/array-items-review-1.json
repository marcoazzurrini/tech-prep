{
  "title": "First track",
  "statement": "Print the first track of the playlist.",
  "reference": ".playlist[0]",
  "tests": [
    {
      "input": {
        "owner": "ada",
        "playlist": [
          "intro",
          "verse",
          "bridge",
          "outro"
        ]
      },
      "expected": "\"intro\""
    },
    {
      "input": {
        "owner": "bo",
        "playlist": [
          "warmup",
          "sprint"
        ]
      },
      "expected": "\"warmup\""
    },
    {
      "input": {
        "owner": "cy",
        "playlist": [
          "dawn"
        ]
      },
      "expected": "\"dawn\""
    }
  ]
}
