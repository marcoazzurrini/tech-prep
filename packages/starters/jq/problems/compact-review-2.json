{
  "title": "Output of the last run",
  "statement": "Print what each step of the last run produced, one line for each step.\n\nThe runs are under `runs`, and there can be any number of them. Take the `output` of every step of the last run. Some outputs are strings and some are objects. Print a string as plain text, with no quotes. Print an object on one line, with no spaces.",
  "mode": "command",
  "stub": "'.'",
  "reference": "-c -r '.runs[-1].steps[] | .output'",
  "tests": [
    {
      "input": {
        "runs": [
          {
            "id": 1,
            "steps": [
              {
                "name": "lint",
                "output": "failed"
              }
            ]
          },
          {
            "id": 2,
            "steps": [
              {
                "name": "lint",
                "output": "clean"
              },
              {
                "name": "test",
                "output": {
                  "passed": 40,
                  "failed": 2
                }
              }
            ]
          }
        ]
      },
      "expected": "clean\n{\"passed\":40,\"failed\":2}"
    },
    {
      "input": {
        "runs": [
          {
            "id": 9,
            "steps": [
              {
                "name": "build",
                "output": {
                  "files": 12,
                  "bytes": 48200
                }
              },
              {
                "name": "deploy",
                "output": "skipped"
              }
            ]
          }
        ]
      },
      "expected": "{\"files\":12,\"bytes\":48200}\nskipped"
    },
    {
      "input": {
        "runs": [
          {
            "id": 3,
            "steps": [
              {
                "name": "lint",
                "output": "clean"
              }
            ]
          },
          {
            "id": 4,
            "steps": [
              {
                "name": "test",
                "output": "timeout"
              }
            ]
          },
          {
            "id": 5,
            "steps": []
          }
        ]
      },
      "expected": ""
    }
  ]
}
