{
  "title": "First and last commit",
  "statement": "Print the first commit of the list, and then the last commit of the list.\n\nPrint each commit as a whole object. Each one is its own output. There can be any number of commits.",
  "reference": ".commits | .[0], .[-1]",
  "tests": [
    {
      "input": {
        "branch": "main",
        "commits": [
          {
            "sha": "a1f3",
            "msg": "Start project"
          },
          {
            "sha": "b7c2",
            "msg": "Add login"
          },
          {
            "sha": "c9d0",
            "msg": "Fix typo"
          }
        ]
      },
      "expected": "{\n  \"sha\": \"a1f3\",\n  \"msg\": \"Start project\"\n}\n{\n  \"sha\": \"c9d0\",\n  \"msg\": \"Fix typo\"\n}"
    },
    {
      "input": {
        "branch": "dev",
        "commits": [
          {
            "sha": "e44a",
            "msg": "Try new cache"
          },
          {
            "sha": "f0b1",
            "msg": "Revert cache"
          }
        ]
      },
      "expected": "{\n  \"sha\": \"e44a\",\n  \"msg\": \"Try new cache\"\n}\n{\n  \"sha\": \"f0b1\",\n  \"msg\": \"Revert cache\"\n}"
    },
    {
      "input": {
        "branch": "hotfix",
        "commits": [
          {
            "sha": "9d2e",
            "msg": "Patch the parser"
          }
        ]
      },
      "expected": "{\n  \"sha\": \"9d2e\",\n  \"msg\": \"Patch the parser\"\n}\n{\n  \"sha\": \"9d2e\",\n  \"msg\": \"Patch the parser\"\n}"
    }
  ]
}
