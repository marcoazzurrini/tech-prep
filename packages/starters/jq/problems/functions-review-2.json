{
  "title": "Disks of two servers",
  "statement": "Print an object with the keys `primary` and `replica`. Each one holds an array with one object for each disk of that server.\n\nEach object has two keys: `host` is the host of the server, and `disk` is the name of the disk. A server with no disks gives an empty array.",
  "reference": "def disks: .host as $host | .disks | map({host: $host, disk: .}); {primary: .primary | disks, replica: .replica | disks}",
  "tests": [
    {
      "input": {
        "cluster": "orders",
        "primary": {
          "host": "db-1",
          "disks": [
            "sda",
            "sdb"
          ]
        },
        "replica": {
          "host": "db-2",
          "disks": [
            "sda"
          ]
        }
      },
      "expected": "{\n  \"primary\": [\n    {\n      \"host\": \"db-1\",\n      \"disk\": \"sda\"\n    },\n    {\n      \"host\": \"db-1\",\n      \"disk\": \"sdb\"\n    }\n  ],\n  \"replica\": [\n    {\n      \"host\": \"db-2\",\n      \"disk\": \"sda\"\n    }\n  ]\n}"
    },
    {
      "input": {
        "cluster": "users",
        "primary": {
          "host": "pg-7",
          "disks": [
            "nvme0"
          ]
        },
        "replica": {
          "host": "pg-8",
          "disks": []
        }
      },
      "expected": "{\n  \"primary\": [\n    {\n      \"host\": \"pg-7\",\n      \"disk\": \"nvme0\"\n    }\n  ],\n  \"replica\": []\n}"
    },
    {
      "input": {
        "cluster": "logs",
        "primary": {
          "host": "es-1",
          "disks": [
            "sda",
            "sdb",
            "sdc"
          ]
        },
        "replica": {
          "host": "es-2",
          "disks": [
            "sda",
            "sdb"
          ]
        }
      },
      "expected": "{\n  \"primary\": [\n    {\n      \"host\": \"es-1\",\n      \"disk\": \"sda\"\n    },\n    {\n      \"host\": \"es-1\",\n      \"disk\": \"sdb\"\n    },\n    {\n      \"host\": \"es-1\",\n      \"disk\": \"sdc\"\n    }\n  ],\n  \"replica\": [\n    {\n      \"host\": \"es-2\",\n      \"disk\": \"sda\"\n    },\n    {\n      \"host\": \"es-2\",\n      \"disk\": \"sdb\"\n    }\n  ]\n}"
    }
  ]
}
