{
  "title": "Depth of a path",
  "statement": "Print how many parts the path has.\n\nThe parts of `path` are separated by `/`. The file name counts as a part. For `docs/guide.md`, print `2`.",
  "reference": ".path | split(\"/\") | length",
  "tests": [
    {
      "input": {
        "path": "src/app/routes/index.ts",
        "lines": 84
      },
      "expected": "4"
    },
    {
      "input": {
        "path": "README.md",
        "lines": 30
      },
      "expected": "1"
    },
    {
      "input": {
        "path": "packages/ui/button.tsx",
        "lines": 51
      },
      "expected": "3"
    }
  ]
}
