{
  "title": "Codes of the failures",
  "statement": "Print the error code of every failed job, each as its own output.\n\nThe code is in `error`, in the key `code`. In some jobs `error` is only a string, with no code. Skip those jobs.",
  "reference": ".[] | .error.code?",
  "tests": [
    {
      "input": [
        {
          "job": "build",
          "error": {
            "code": "E42",
            "text": "out of memory"
          }
        },
        {
          "job": "test",
          "error": "timeout"
        },
        {
          "job": "deploy",
          "error": {
            "code": "E7",
            "text": "no access"
          }
        }
      ],
      "expected": "\"E42\"\n\"E7\""
    },
    {
      "input": [
        {
          "job": "lint",
          "error": {
            "code": "E13",
            "text": "bad config"
          }
        }
      ],
      "expected": "\"E13\""
    },
    {
      "input": [
        {
          "job": "docs",
          "error": "cancelled"
        },
        {
          "job": "e2e",
          "error": {
            "code": "E99",
            "text": "browser crashed"
          }
        }
      ],
      "expected": "\"E99\""
    }
  ]
}
