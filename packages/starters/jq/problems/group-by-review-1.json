{
  "title": "Errors per service",
  "statement": "Count the errors of each service.\n\nThe input is an array of log entries. Each has a `service` and a `level`. Count only the entries with `level` equal to `\"error\"`. Give one object for each service that has errors, with the `service` and an `errors` count. Leave out services with no errors. Order by `service`, from a to z.",
  "reference": "map(select(.level == \"error\")) | group_by(.service) | map({service: .[0].service, errors: length})",
  "tests": [
    {
      "input": [
        {
          "service": "auth",
          "level": "error"
        },
        {
          "service": "api",
          "level": "info"
        },
        {
          "service": "auth",
          "level": "warn"
        },
        {
          "service": "api",
          "level": "error"
        },
        {
          "service": "auth",
          "level": "error"
        },
        {
          "service": "mail",
          "level": "info"
        }
      ],
      "expected": "[\n  {\n    \"service\": \"api\",\n    \"errors\": 1\n  },\n  {\n    \"service\": \"auth\",\n    \"errors\": 2\n  }\n]"
    },
    {
      "input": [
        {
          "service": "api",
          "level": "info"
        }
      ],
      "expected": "[]"
    },
    {
      "input": [
        {
          "service": "db",
          "level": "error"
        }
      ],
      "expected": "[\n  {\n    \"service\": \"db\",\n    \"errors\": 1\n  }\n]"
    },
    {
      "input": [
        {
          "service": "db",
          "level": "error"
        },
        {
          "service": "db",
          "level": "error"
        },
        {
          "service": "cache",
          "level": "error"
        }
      ],
      "expected": "[\n  {\n    \"service\": \"cache\",\n    \"errors\": 1\n  },\n  {\n    \"service\": \"db\",\n    \"errors\": 2\n  }\n]"
    }
  ]
}
