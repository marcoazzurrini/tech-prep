{
  "title": "Request summary",
  "statement": "Give the method, then the path, then the status of the request.\n\nThe input is one log entry with `method`, `path`, `status` and `ms`. Print three outputs, in this order.",
  "reference": ".method, .path, .status",
  "tests": [
    {
      "input": {
        "method": "GET",
        "path": "/users",
        "status": 200,
        "ms": 31
      },
      "expected": "\"GET\"\n\"/users\"\n200"
    },
    {
      "input": {
        "method": "POST",
        "path": "/orders",
        "status": 201,
        "ms": 87
      },
      "expected": "\"POST\"\n\"/orders\"\n201"
    },
    {
      "input": {
        "method": "GET",
        "path": "/missing",
        "status": 404,
        "ms": 4
      },
      "expected": "\"GET\"\n\"/missing\"\n404"
    }
  ]
}
