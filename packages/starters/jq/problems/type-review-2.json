{
  "title": "Adults in the sign-up list",
  "statement": "Keep the sign-ups of adults.\n\nThe input is an array of sign-ups with a `name` and an `age`. `age` should be a number, but some sign-ups hold text or `null` there. Keep a sign-up only when its `age` is a number and that number is 18 or more. Give an array of whole sign-ups back, in the same order.",
  "reference": "map(select((.age | type) == \"number\" and .age >= 18))",
  "tests": [
    {
      "input": [
        {
          "name": "Ada",
          "age": 34
        },
        {
          "name": "Bo",
          "age": "41"
        },
        {
          "name": "Cy",
          "age": 16
        },
        {
          "name": "Dee",
          "age": null
        },
        {
          "name": "Eli",
          "age": 18
        }
      ],
      "expected": "[\n  {\n    \"name\": \"Ada\",\n    \"age\": 34\n  },\n  {\n    \"name\": \"Eli\",\n    \"age\": 18\n  }\n]"
    },
    {
      "input": [
        {
          "name": "Fay",
          "age": "n/a"
        }
      ],
      "expected": "[]"
    },
    {
      "input": [
        {
          "name": "Gus",
          "age": 17
        },
        {
          "name": "Hal",
          "age": 65
        }
      ],
      "expected": "[\n  {\n    \"name\": \"Hal\",\n    \"age\": 65\n  }\n]"
    },
    {
      "input": [],
      "expected": "[]"
    }
  ]
}
