{
  "title": "Headers of the reply",
  "statement": "Print the headers of the reply as one object.\n\nThe headers are in `headers`, as an array of pairs. Each pair has a `key` and a `value`. In the object you print, each `key` is a key and its `value` is the value stored under it.",
  "reference": ".headers | from_entries",
  "tests": [
    {
      "input": {
        "status": 200,
        "headers": [
          {
            "key": "content-type",
            "value": "text/html"
          },
          {
            "key": "cache-control",
            "value": "no-cache"
          }
        ]
      },
      "expected": "{\n  \"content-type\": \"text/html\",\n  \"cache-control\": \"no-cache\"\n}"
    },
    {
      "input": {
        "status": 404,
        "headers": [
          {
            "key": "content-type",
            "value": "text/plain"
          }
        ]
      },
      "expected": "{\n  \"content-type\": \"text/plain\"\n}"
    },
    {
      "input": {
        "status": 301,
        "headers": [
          {
            "key": "location",
            "value": "/new"
          },
          {
            "key": "server",
            "value": "nginx"
          },
          {
            "key": "age",
            "value": "12"
          }
        ]
      },
      "expected": "{\n  \"location\": \"/new\",\n  \"server\": \"nginx\",\n  \"age\": \"12\"\n}"
    }
  ]
}
