{
  "title": "Latest log lines",
  "statement": "Give one array with the last line of every service.\n\nThe input is an array of services. Each service has a `lines` array of strings, with at least one line. Keep the order of the services.",
  "reference": "[.[] | .lines[-1]]",
  "tests": [
    {
      "input": [
        {
          "service": "api",
          "lines": [
            "boot",
            "listening on 8080"
          ]
        },
        {
          "service": "db",
          "lines": [
            "boot",
            "ready"
          ]
        },
        {
          "service": "cache",
          "lines": [
            "boot"
          ]
        }
      ],
      "expected": "[\n  \"listening on 8080\",\n  \"ready\",\n  \"boot\"\n]"
    },
    {
      "input": [
        {
          "service": "worker",
          "lines": [
            "boot",
            "job 1 done",
            "job 2 done"
          ]
        }
      ],
      "expected": "[\n  \"job 2 done\"\n]"
    },
    {
      "input": [],
      "expected": "[]"
    }
  ]
}
