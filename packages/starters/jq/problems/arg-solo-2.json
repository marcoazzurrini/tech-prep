{
  "title": "Slow requests",
  "statement": "Give the path of every request that took more than 500 ms.\n\nThe input is an array of requests with a `path` and a time `ms`, which is a number. Do not write `500` in the filter: pass the number `500` to jq as the variable `$limit`. Print each path as its own output, as JSON with quotes.",
  "mode": "command",
  "stub": "'.'",
  "reference": "--argjson limit 500 '.[] | select(.ms > $limit) | .path'",
  "tests": [
    {
      "input": [
        {
          "path": "/home",
          "ms": 120
        },
        {
          "path": "/search",
          "ms": 900
        },
        {
          "path": "/export",
          "ms": 501
        }
      ],
      "expected": "\"/search\"\n\"/export\""
    },
    {
      "input": [
        {
          "path": "/login",
          "ms": 500
        }
      ],
      "expected": ""
    },
    {
      "input": [
        {
          "path": "/report",
          "ms": 2300
        },
        {
          "path": "/ping",
          "ms": 3
        }
      ],
      "expected": "\"/report\""
    }
  ]
}
