{
  "title": "First header",
  "statement": "Give the header name that comes first in alphabetical order.\n\nThe headers are in the `headers` object. Each key is a header name, and all names are in lower case. There is always at least one header. Give the name as one string.",
  "reference": ".headers | keys | .[0]",
  "tests": [
    {
      "input": {
        "status": 200,
        "headers": {
          "server": "nginx",
          "content-type": "text/html",
          "age": "12"
        }
      },
      "expected": "\"age\""
    },
    {
      "input": {
        "status": 304,
        "headers": {
          "etag": "abc123"
        }
      },
      "expected": "\"etag\""
    },
    {
      "input": {
        "status": 200,
        "headers": {
          "vary": "accept",
          "date": "Mon",
          "host": "example.com"
        }
      },
      "expected": "\"date\""
    }
  ]
}
