{
  "title": "Invoices to chase",
  "statement": "Print the ids of the invoices to chase, as one array.\n\nAn invoice needs chasing when it is overdue and its `amount` is 1000 or more. Both must hold. `overdue` holds `true` or `false`. The array holds only the ids, in the order of the input.",
  "reference": "[.[] | select(.overdue and .amount >= 1000) | .id]",
  "tests": [
    {
      "input": [
        {
          "id": "inv-1",
          "amount": 2400,
          "overdue": true
        },
        {
          "id": "inv-2",
          "amount": 300,
          "overdue": true
        },
        {
          "id": "inv-3",
          "amount": 5000,
          "overdue": false
        },
        {
          "id": "inv-4",
          "amount": 1000,
          "overdue": true
        }
      ],
      "expected": "[\n  \"inv-1\",\n  \"inv-4\"\n]"
    },
    {
      "input": [
        {
          "id": "inv-9",
          "amount": 999,
          "overdue": true
        },
        {
          "id": "inv-10",
          "amount": 8000,
          "overdue": false
        }
      ],
      "expected": "[]"
    },
    {
      "input": [
        {
          "id": "inv-20",
          "amount": 1500,
          "overdue": true
        }
      ],
      "expected": "[\n  \"inv-20\"\n]"
    }
  ]
}
