{
  "title": "Emails of admins",
  "statement": "Give an array with the email of every admin.\n\nThe input is an array of users. An admin has `role` equal to `\"admin\"`.",
  "reference": "map(select(.role == \"admin\") | .email)",
  "tests": [
    {
      "input": [
        {
          "email": "ada@example.com",
          "role": "admin"
        },
        {
          "email": "bo@example.com",
          "role": "user"
        },
        {
          "email": "cy@example.com",
          "role": "admin"
        }
      ],
      "expected": "[\n  \"ada@example.com\",\n  \"cy@example.com\"\n]"
    },
    {
      "input": [
        {
          "email": "dee@example.com",
          "role": "user"
        }
      ],
      "expected": "[]"
    },
    {
      "input": [
        {
          "email": "eli@example.com",
          "role": "admin"
        }
      ],
      "expected": "[\n  \"eli@example.com\"\n]"
    }
  ]
}
