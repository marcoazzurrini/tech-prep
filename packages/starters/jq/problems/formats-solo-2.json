{
  "title": "Orders for a sheet",
  "statement": "Print one line for each order, with a tab between the values.\n\nThe orders are in the `orders` array. Each line has the order `id`, then the `name` of its `customer`, then the `total`. This task runs jq with `-r`. The values have one tab character between them and no quotes.",
  "reference": ".orders[] | [.id, .customer.name, .total] | @tsv",
  "flags": [
    "-r"
  ],
  "tests": [
    {
      "input": {
        "orders": [
          {
            "id": 501,
            "customer": {
              "name": "Ada"
            },
            "total": 30
          },
          {
            "id": 502,
            "customer": {
              "name": "Bo Diaz"
            },
            "total": 12.5
          }
        ]
      },
      "expected": "501\tAda\t30\n502\tBo Diaz\t12.5"
    },
    {
      "input": {
        "orders": []
      },
      "expected": ""
    },
    {
      "input": {
        "orders": [
          {
            "id": 610,
            "customer": {
              "name": "Cy"
            },
            "total": 8
          }
        ]
      },
      "expected": "610\tCy\t8"
    }
  ]
}
