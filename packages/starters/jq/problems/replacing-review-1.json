{
  "title": "Tidy emails",
  "statement": "Print the email of every user in small letters, as one array.\n\nThe users are in `users`. People typed their emails with capital letters in different places.",
  "reference": ".users | map(.email | ascii_downcase)",
  "tests": [
    {
      "input": {
        "users": [
          {
            "id": 1,
            "email": "Ada@Example.com"
          },
          {
            "id": 2,
            "email": "BO@EXAMPLE.COM"
          },
          {
            "id": 3,
            "email": "cy@example.com"
          }
        ]
      },
      "expected": "[\n  \"ada@example.com\",\n  \"bo@example.com\",\n  \"cy@example.com\"\n]"
    },
    {
      "input": {
        "users": [
          {
            "id": 4,
            "email": "Dee.Park@example.com"
          }
        ]
      },
      "expected": "[\n  \"dee.park@example.com\"\n]"
    },
    {
      "input": {
        "users": []
      },
      "expected": "[]"
    }
  ]
}
