{
  "title": "A shorter feed",
  "statement": "The feed is too long. Print the whole feed, but with only the first two posts in `posts`.\n\nThe output is the whole object. `user` and `page` stay as they are. `posts` is still an array.",
  "reference": ".posts |= .[:2]",
  "tests": [
    {
      "input": {
        "user": "ada",
        "page": 1,
        "posts": [
          "Hello",
          "New job",
          "Trip photos",
          "Lunch"
        ]
      },
      "expected": "{\n  \"user\": \"ada\",\n  \"page\": 1,\n  \"posts\": [\n    \"Hello\",\n    \"New job\"\n  ]\n}"
    },
    {
      "input": {
        "user": "bo",
        "page": 3,
        "posts": [
          "Only one"
        ]
      },
      "expected": "{\n  \"user\": \"bo\",\n  \"page\": 3,\n  \"posts\": [\n    \"Only one\"\n  ]\n}"
    },
    {
      "input": {
        "user": "cy",
        "page": 2,
        "posts": [
          "a",
          "b",
          "c"
        ]
      },
      "expected": "{\n  \"user\": \"cy\",\n  \"page\": 2,\n  \"posts\": [\n    \"a\",\n    \"b\"\n  ]\n}"
    },
    {
      "input": {
        "user": "dee",
        "page": 9,
        "posts": []
      },
      "expected": "{\n  \"user\": \"dee\",\n  \"page\": 9,\n  \"posts\": []\n}"
    }
  ]
}
