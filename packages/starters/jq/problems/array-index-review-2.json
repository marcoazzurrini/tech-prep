{
  "title": "Third track title",
  "statement": "Give the title of the third track of the playlist.\n\nThe tracks are in the `tracks` array, inside `playlist`. When there is no third track, the output is `null`.",
  "reference": ".playlist.tracks[2].title",
  "tests": [
    {
      "input": {
        "playlist": {
          "name": "Focus",
          "tracks": [
            {
              "title": "Rain"
            },
            {
              "title": "Slow Tide"
            },
            {
              "title": "Glass"
            },
            {
              "title": "Drift"
            }
          ]
        }
      },
      "expected": "\"Glass\""
    },
    {
      "input": {
        "playlist": {
          "name": "Run",
          "tracks": [
            {
              "title": "Go"
            },
            {
              "title": "Faster"
            }
          ]
        }
      },
      "expected": "null"
    },
    {
      "input": {
        "playlist": {
          "name": "Sleep",
          "tracks": [
            {
              "title": "Dusk"
            },
            {
              "title": "Moon"
            },
            {
              "title": "Still"
            }
          ]
        }
      },
      "expected": "\"Still\""
    }
  ]
}
