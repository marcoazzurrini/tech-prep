{
  "title": "Emails of the team",
  "statement": "Print the email of every member of the team as plain text, one per line, with no quotes.\n\nThe members are in `members`. Keep them in the same order.",
  "mode": "command",
  "stub": "'.'",
  "reference": "-r '.members | .[] | .email'",
  "tests": [
    {
      "input": {
        "team": "web",
        "members": [
          {
            "name": "Lena",
            "email": "lena@example.com"
          },
          {
            "name": "Omar",
            "email": "omar@example.com"
          },
          {
            "name": "Kofi",
            "email": "kofi@example.com"
          }
        ]
      },
      "expected": "lena@example.com\nomar@example.com\nkofi@example.com"
    },
    {
      "input": {
        "team": "ops",
        "members": [
          {
            "name": "Ines",
            "email": "ines@example.com"
          }
        ]
      },
      "expected": "ines@example.com"
    },
    {
      "input": {
        "team": "data",
        "members": [
          {
            "name": "Yuki",
            "email": "yuki@example.com"
          },
          {
            "name": "Sam",
            "email": "sam@example.com"
          }
        ]
      },
      "expected": "yuki@example.com\nsam@example.com"
    }
  ]
}
