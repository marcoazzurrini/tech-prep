{
  "title": "Orders for a line tool",
  "statement": "Print every order of the shop, so that another tool can read them line by line.\n\nThe orders are under `orders`. Each order is its own output: a whole object on one line, with no spaces.",
  "mode": "command",
  "stub": "'.'",
  "reference": "-c '.orders[]'",
  "tests": [
    {
      "input": {
        "shop": "north",
        "orders": [
          {
            "id": 501,
            "total": 40,
            "paid": true
          },
          {
            "id": 502,
            "total": 15,
            "paid": false
          }
        ]
      },
      "expected": "{\"id\":501,\"total\":40,\"paid\":true}\n{\"id\":502,\"total\":15,\"paid\":false}"
    },
    {
      "input": {
        "shop": "south",
        "orders": [
          {
            "id": 77,
            "total": 9,
            "paid": true
          },
          {
            "id": 78,
            "total": 120,
            "paid": true
          },
          {
            "id": 79,
            "total": 33,
            "paid": false
          }
        ]
      },
      "expected": "{\"id\":77,\"total\":9,\"paid\":true}\n{\"id\":78,\"total\":120,\"paid\":true}\n{\"id\":79,\"total\":33,\"paid\":false}"
    },
    {
      "input": {
        "shop": "east",
        "orders": []
      },
      "expected": ""
    }
  ]
}
