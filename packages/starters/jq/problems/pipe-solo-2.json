{
  "title": "Whole euros",
  "statement": "Give the total of the receipt in whole euros.\n\nThe total is the `total` field. Drop the cents, so `12.80` becomes `12`. The function `floor` rounds a number down.",
  "reference": ".total | floor",
  "tests": [
    {
      "input": {
        "shop": "Corner Cafe",
        "total": 12.8
      },
      "expected": "12"
    },
    {
      "input": {
        "shop": "Book Nook",
        "total": 40
      },
      "expected": "40"
    },
    {
      "input": {
        "shop": "Bike Fix",
        "total": 7.05
      },
      "expected": "7"
    },
    {
      "input": {
        "shop": "Green Grocer",
        "total": 0.99
      },
      "expected": "0"
    }
  ]
}
