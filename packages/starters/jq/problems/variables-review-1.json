{
  "title": "Poll results",
  "statement": "Give each option of the poll with its share of the votes, in percent.\n\nThe input has `votes`, the total number of votes, and an `options` array. Each option has a `label` and a `count`. Give an array of objects with `label` and `percent`. The percent is `count` times 100, divided by `votes`. Keep the order of the options.",
  "reference": ".votes as $all | .options | map({label, percent: (.count * 100 / $all)})",
  "tests": [
    {
      "input": {
        "votes": 50,
        "options": [
          {
            "label": "yes",
            "count": 30
          },
          {
            "label": "no",
            "count": 20
          }
        ]
      },
      "expected": "[\n  {\n    \"label\": \"yes\",\n    \"percent\": 60\n  },\n  {\n    \"label\": \"no\",\n    \"percent\": 40\n  }\n]"
    },
    {
      "input": {
        "votes": 10,
        "options": [
          {
            "label": "tea",
            "count": 10
          }
        ]
      },
      "expected": "[\n  {\n    \"label\": \"tea\",\n    \"percent\": 100\n  }\n]"
    },
    {
      "input": {
        "votes": 200,
        "options": [
          {
            "label": "red",
            "count": 50
          },
          {
            "label": "blue",
            "count": 100
          },
          {
            "label": "green",
            "count": 50
          }
        ]
      },
      "expected": "[\n  {\n    \"label\": \"red\",\n    \"percent\": 25\n  },\n  {\n    \"label\": \"blue\",\n    \"percent\": 50\n  },\n  {\n    \"label\": \"green\",\n    \"percent\": 25\n  }\n]"
    },
    {
      "input": {
        "votes": 4,
        "options": [
          {
            "label": "a",
            "count": 1
          },
          {
            "label": "b",
            "count": 3
          },
          {
            "label": "c",
            "count": 0
          }
        ]
      },
      "expected": "[\n  {\n    \"label\": \"a\",\n    \"percent\": 25\n  },\n  {\n    \"label\": \"b\",\n    \"percent\": 75\n  },\n  {\n    \"label\": \"c\",\n    \"percent\": 0\n  }\n]"
    }
  ]
}
