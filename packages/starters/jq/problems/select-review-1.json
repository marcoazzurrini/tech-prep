{
  "title": "Nodes in Europe",
  "statement": "Print the nodes of the cluster that run in the region `\"eu\"`, as one array.\n\nThe nodes are under `nodes`. Keep the whole node objects, in the order of the input.",
  "reference": ".nodes | map(select(.region == \"eu\"))",
  "tests": [
    {
      "input": {
        "cluster": "main",
        "nodes": [
          {
            "name": "n1",
            "region": "eu"
          },
          {
            "name": "n2",
            "region": "us"
          },
          {
            "name": "n3",
            "region": "eu"
          }
        ]
      },
      "expected": "[\n  {\n    \"name\": \"n1\",\n    \"region\": \"eu\"\n  },\n  {\n    \"name\": \"n3\",\n    \"region\": \"eu\"\n  }\n]"
    },
    {
      "input": {
        "cluster": "edge",
        "nodes": [
          {
            "name": "e1",
            "region": "ap"
          },
          {
            "name": "e2",
            "region": "us"
          }
        ]
      },
      "expected": "[]"
    },
    {
      "input": {
        "cluster": "lab",
        "nodes": [
          {
            "name": "l1",
            "region": "eu"
          }
        ]
      },
      "expected": "[\n  {\n    \"name\": \"l1\",\n    \"region\": \"eu\"\n  }\n]"
    }
  ]
}
