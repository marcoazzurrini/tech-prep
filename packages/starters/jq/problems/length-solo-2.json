{
  "title": "Errors in a log",
  "statement": "Give the number of log entries that are errors.\n\nThe entries are in the `entries` array. An entry is an error when its `level` is `\"error\"`. Give one number.",
  "reference": ".entries | map(select(.level == \"error\")) | length",
  "tests": [
    {
      "input": {
        "service": "api",
        "entries": [
          {
            "level": "info",
            "msg": "started"
          },
          {
            "level": "error",
            "msg": "db timeout"
          },
          {
            "level": "warn",
            "msg": "slow query"
          },
          {
            "level": "error",
            "msg": "db timeout"
          }
        ]
      },
      "expected": "2"
    },
    {
      "input": {
        "service": "mail",
        "entries": [
          {
            "level": "info",
            "msg": "sent"
          },
          {
            "level": "warn",
            "msg": "retry"
          }
        ]
      },
      "expected": "0"
    },
    {
      "input": {
        "service": "jobs",
        "entries": [
          {
            "level": "error",
            "msg": "disk full"
          }
        ]
      },
      "expected": "1"
    },
    {
      "input": {
        "service": "sync",
        "entries": [
          {
            "level": "error",
            "msg": "conflict"
          },
          {
            "level": "error",
            "msg": "conflict"
          },
          {
            "level": "error",
            "msg": "offline"
          }
        ]
      },
      "expected": "3"
    }
  ]
}
