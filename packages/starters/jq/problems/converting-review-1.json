{
  "title": "Ticket ids as text",
  "statement": "Print the id of every ticket as a string, in one array.\n\nThe tickets are in `tickets`. Some ids are numbers and some are strings already. Keep the order of the input.",
  "reference": "[.tickets[] | .id | tostring]",
  "tests": [
    {
      "input": {
        "tickets": [
          {
            "id": 101,
            "title": "Login fails"
          },
          {
            "id": "102",
            "title": "Typo on home page"
          },
          {
            "id": 103,
            "title": "Slow search"
          }
        ]
      },
      "expected": "[\n  \"101\",\n  \"102\",\n  \"103\"\n]"
    },
    {
      "input": {
        "tickets": [
          {
            "id": "7",
            "title": "Add dark mode"
          }
        ]
      },
      "expected": "[\n  \"7\"\n]"
    },
    {
      "input": {
        "tickets": [
          {
            "id": 250,
            "title": "Export to CSV"
          },
          {
            "id": 251,
            "title": "Fix footer"
          }
        ]
      },
      "expected": "[\n  \"250\",\n  \"251\"\n]"
    }
  ]
}
