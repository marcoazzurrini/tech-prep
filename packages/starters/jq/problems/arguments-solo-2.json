{
  "title": "Slow requests",
  "statement": "Print the path of every slow request.\n\nDo not write the limit inside the filter. Pass the number `500` into the command under the name `limit`. A request is slow when its `ms` is above the limit. Print the `path` of each slow request as its own output, in JSON with its quotes.",
  "mode": "command",
  "stub": "'.'",
  "reference": "--argjson limit 500 '.[] | select(.ms > $limit) | .path'",
  "tests": [
    {
      "input": [
        {
          "path": "/login",
          "ms": 120
        },
        {
          "path": "/search",
          "ms": 900
        },
        {
          "path": "/export",
          "ms": 2400
        },
        {
          "path": "/home",
          "ms": 500
        }
      ],
      "expected": "\"/search\"\n\"/export\""
    },
    {
      "input": [
        {
          "path": "/cart",
          "ms": 501
        },
        {
          "path": "/pay",
          "ms": 499
        }
      ],
      "expected": "\"/cart\""
    },
    {
      "input": [
        {
          "path": "/health",
          "ms": 3
        },
        {
          "path": "/ping",
          "ms": 1
        }
      ],
      "expected": ""
    }
  ]
}
