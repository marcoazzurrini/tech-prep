{
  "title": "Step count",
  "statement": "Replace the list of steps with the number of steps.\n\nThe input is one build. `steps` is an array of step names. Give the whole build back, with `steps` as a number and the other fields as they are.",
  "reference": ".steps |= length",
  "tests": [
    {
      "input": {
        "id": 311,
        "branch": "main",
        "steps": [
          "install",
          "lint",
          "test"
        ]
      },
      "expected": "{\n  \"id\": 311,\n  \"branch\": \"main\",\n  \"steps\": 3\n}"
    },
    {
      "input": {
        "id": 312,
        "branch": "fix/login",
        "steps": []
      },
      "expected": "{\n  \"id\": 312,\n  \"branch\": \"fix/login\",\n  \"steps\": 0\n}"
    },
    {
      "input": {
        "id": 313,
        "branch": "main",
        "steps": [
          "deploy"
        ]
      },
      "expected": "{\n  \"id\": 313,\n  \"branch\": \"main\",\n  \"steps\": 1\n}"
    }
  ]
}
