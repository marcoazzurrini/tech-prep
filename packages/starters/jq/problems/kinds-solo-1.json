{
  "title": "Shape of the data",
  "statement": "Print the kind of value stored under `data` in the response, as a string.\n\nThe response is under `response`. Its `data` can be of any kind. For an array, print `\"array\"`. For an object, print `\"object\"`, and so on.",
  "reference": ".response.data | type",
  "tests": [
    {
      "input": {
        "response": {
          "status": 200,
          "data": [
            {
              "id": 1
            },
            {
              "id": 2
            }
          ]
        }
      },
      "expected": "\"array\""
    },
    {
      "input": {
        "response": {
          "status": 200,
          "data": {
            "id": 1
          }
        }
      },
      "expected": "\"object\""
    },
    {
      "input": {
        "response": {
          "status": 204
        }
      },
      "expected": "\"null\""
    },
    {
      "input": {
        "response": {
          "status": 500,
          "data": "internal error"
        }
      },
      "expected": "\"string\""
    }
  ]
}
