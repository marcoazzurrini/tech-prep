{
  "title": "Orders by total",
  "statement": "Order the orders by their total, smallest first.\n\nThe input is an array of orders. Each has an `id` and a `total`. Give an array of whole orders back.",
  "reference": "sort_by(.total)",
  "tests": [
    {
      "input": [
        {
          "id": "A7",
          "total": 59.5
        },
        {
          "id": "B2",
          "total": 12
        },
        {
          "id": "C9",
          "total": 230
        }
      ],
      "expected": "[\n  {\n    \"id\": \"B2\",\n    \"total\": 12\n  },\n  {\n    \"id\": \"A7\",\n    \"total\": 59.5\n  },\n  {\n    \"id\": \"C9\",\n    \"total\": 230\n  }\n]"
    },
    {
      "input": [
        {
          "id": "D1",
          "total": 8
        }
      ],
      "expected": "[\n  {\n    \"id\": \"D1\",\n    \"total\": 8\n  }\n]"
    },
    {
      "input": [
        {
          "id": "E4",
          "total": 100
        },
        {
          "id": "F5",
          "total": 99
        },
        {
          "id": "G6",
          "total": 101
        },
        {
          "id": "H8",
          "total": 3
        }
      ],
      "expected": "[\n  {\n    \"id\": \"H8\",\n    \"total\": 3\n  },\n  {\n    \"id\": \"F5\",\n    \"total\": 99\n  },\n  {\n    \"id\": \"E4\",\n    \"total\": 100\n  },\n  {\n    \"id\": \"G6\",\n    \"total\": 101\n  }\n]"
    }
  ]
}
