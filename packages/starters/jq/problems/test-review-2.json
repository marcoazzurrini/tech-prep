{
  "title": "Fixes and features",
  "statement": "Keep the commits that are a fix or a feature.\n\nThe input is an array of commits. A commit is a fix when its `message` starts with `fix:`. It is a feature when its `message` starts with `feat:`. Give an array of whole commits back, in the same order.",
  "reference": "map(select(.message | test(\"^(fix|feat):\")))",
  "tests": [
    {
      "input": [
        {
          "sha": "a1f",
          "message": "fix: login loop"
        },
        {
          "sha": "b2c",
          "message": "docs: update readme"
        },
        {
          "sha": "c3d",
          "message": "feat: dark mode"
        }
      ],
      "expected": "[\n  {\n    \"sha\": \"a1f\",\n    \"message\": \"fix: login loop\"\n  },\n  {\n    \"sha\": \"c3d\",\n    \"message\": \"feat: dark mode\"\n  }\n]"
    },
    {
      "input": [
        {
          "sha": "d4e",
          "message": "fixes: typo"
        },
        {
          "sha": "e5f",
          "message": "docs: fix: link"
        },
        {
          "sha": "f6a",
          "message": "feat: export"
        }
      ],
      "expected": "[\n  {\n    \"sha\": \"f6a\",\n    \"message\": \"feat: export\"\n  }\n]"
    },
    {
      "input": [
        {
          "sha": "g7b",
          "message": "chore: bump"
        }
      ],
      "expected": "[]"
    }
  ]
}
