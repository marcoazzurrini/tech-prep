{
  "title": "Order totals",
  "statement": "Give the total of every order.\n\nThe orders are in the `orders` array. Each order has a `total`. Print each total as its own output, in the same order.",
  "reference": ".orders[] | .total",
  "tests": [
    {
      "input": {
        "customer": "pia",
        "orders": [
          {
            "id": 1,
            "total": 30
          },
          {
            "id": 2,
            "total": 12.5
          },
          {
            "id": 3,
            "total": 8
          }
        ]
      },
      "expected": "30\n12.5\n8"
    },
    {
      "input": {
        "customer": "raj",
        "orders": []
      },
      "expected": ""
    },
    {
      "input": {
        "customer": "sol",
        "orders": [
          {
            "id": 9,
            "total": 99
          }
        ]
      },
      "expected": "99"
    }
  ]
}
