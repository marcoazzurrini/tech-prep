{
  "title": "Accounts of the team",
  "statement": "Print the users who have a team address, as one array of whole users.\n\nThe users are in `users`. A team address is an `email` that ends with `@team.example.com`.",
  "reference": ".users | map(select(.email | endswith(\"@team.example.com\")))",
  "tests": [
    {
      "input": {
        "users": [
          {
            "name": "Ada",
            "email": "ada@team.example.com"
          },
          {
            "name": "Bo",
            "email": "bo@example.com"
          },
          {
            "name": "Cy",
            "email": "cy@team.example.com"
          }
        ]
      },
      "expected": "[\n  {\n    \"name\": \"Ada\",\n    \"email\": \"ada@team.example.com\"\n  },\n  {\n    \"name\": \"Cy\",\n    \"email\": \"cy@team.example.com\"\n  }\n]"
    },
    {
      "input": {
        "users": [
          {
            "name": "Dee",
            "email": "team.example.com@example.com"
          },
          {
            "name": "Eli",
            "email": "eli@team.example.com"
          }
        ]
      },
      "expected": "[\n  {\n    \"name\": \"Eli\",\n    \"email\": \"eli@team.example.com\"\n  }\n]"
    },
    {
      "input": {
        "users": [
          {
            "name": "Fay",
            "email": "fay@example.com"
          }
        ]
      },
      "expected": "[]"
    }
  ]
}
