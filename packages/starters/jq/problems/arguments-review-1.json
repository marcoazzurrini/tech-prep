{
  "title": "Packages by license",
  "statement": "Print the names of the packages that have one license.\n\nDo not write the license inside the filter. Pass the text `MIT` into the command under the name `license`, and compare each package's `license` with it. Print one array that holds the `name` of each matching package.",
  "mode": "command",
  "stub": "'.'",
  "reference": "--arg license MIT '[.[] | select(.license == $license) | .name]'",
  "tests": [
    {
      "input": [
        {
          "name": "left-pad",
          "license": "MIT"
        },
        {
          "name": "fastdb",
          "license": "GPL-3.0"
        },
        {
          "name": "tinylog",
          "license": "MIT"
        }
      ],
      "expected": "[\n  \"left-pad\",\n  \"tinylog\"\n]"
    },
    {
      "input": [
        {
          "name": "colors",
          "license": "MIT"
        },
        {
          "name": "netkit",
          "license": "Apache-2.0"
        }
      ],
      "expected": "[\n  \"colors\"\n]"
    },
    {
      "input": [
        {
          "name": "parsely",
          "license": "ISC"
        }
      ],
      "expected": "[]"
    }
  ]
}
