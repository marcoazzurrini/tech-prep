{
  "title": "Newest and oldest release",
  "statement": "Print an object with two keys: `latest` and `oldest`.\n\nThe releases are listed from newest to oldest. `latest` is the `tag` of the first release. `oldest` is the `tag` of the last release. There can be any number of releases.",
  "reference": "{latest: .releases[0].tag, oldest: .releases[-1].tag}",
  "tests": [
    {
      "input": {
        "project": "atlas",
        "releases": [
          {
            "tag": "v2.1.0",
            "draft": false
          },
          {
            "tag": "v2.0.0",
            "draft": false
          },
          {
            "tag": "v1.4.2",
            "draft": false
          }
        ]
      },
      "expected": "{\n  \"latest\": \"v2.1.0\",\n  \"oldest\": \"v1.4.2\"\n}"
    },
    {
      "input": {
        "project": "notes",
        "releases": [
          {
            "tag": "v0.1.0",
            "draft": true
          }
        ]
      },
      "expected": "{\n  \"latest\": \"v0.1.0\",\n  \"oldest\": \"v0.1.0\"\n}"
    },
    {
      "input": {
        "project": "router",
        "releases": [
          {
            "tag": "v9.0.0",
            "draft": false
          },
          {
            "tag": "v8.7.1",
            "draft": false
          }
        ]
      },
      "expected": "{\n  \"latest\": \"v9.0.0\",\n  \"oldest\": \"v8.7.1\"\n}"
    }
  ]
}
