{
  "title": "Messages of one level",
  "statement": "Give the message of every log entry that has the level `error`.\n\nThe input is an array of entries with a `level` and a `msg`. Do not write `error` in the filter: pass the string `error` to jq as the variable `$level`. Print each `msg` as its own output, as JSON with quotes.",
  "mode": "command",
  "stub": "'.'",
  "reference": "--arg level error '.[] | select(.level == $level) | .msg'",
  "tests": [
    {
      "input": [
        {
          "level": "info",
          "msg": "started"
        },
        {
          "level": "error",
          "msg": "disk full"
        },
        {
          "level": "error",
          "msg": "no route"
        }
      ],
      "expected": "\"disk full\"\n\"no route\""
    },
    {
      "input": [
        {
          "level": "warn",
          "msg": "slow reply"
        }
      ],
      "expected": ""
    },
    {
      "input": [
        {
          "level": "error",
          "msg": "timeout"
        },
        {
          "level": "info",
          "msg": "stopped"
        }
      ],
      "expected": "\"timeout\""
    }
  ]
}
