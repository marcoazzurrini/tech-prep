{
  "title": "People per office",
  "statement": "Print how many employees each office has.\n\nThe employees are in `employees`. Each has an `office`. Print one array with one object for each office, with the offices in alphabetical order. Each object has `office` and `count`.",
  "reference": ".employees | group_by(.office) | map({office: .[0].office, count: length})",
  "tests": [
    {
      "input": {
        "company": "Acme",
        "employees": [
          {
            "name": "Kim",
            "office": "Oslo"
          },
          {
            "name": "Lee",
            "office": "Berlin"
          },
          {
            "name": "Sam",
            "office": "Oslo"
          },
          {
            "name": "Uma",
            "office": "Oslo"
          }
        ]
      },
      "expected": "[\n  {\n    \"office\": \"Berlin\",\n    \"count\": 1\n  },\n  {\n    \"office\": \"Oslo\",\n    \"count\": 3\n  }\n]"
    },
    {
      "input": {
        "company": "Globex",
        "employees": [
          {
            "name": "Ana",
            "office": "Lima"
          },
          {
            "name": "Ben",
            "office": "Lima"
          }
        ]
      },
      "expected": "[\n  {\n    \"office\": \"Lima\",\n    \"count\": 2\n  }\n]"
    },
    {
      "input": {
        "company": "Initech",
        "employees": [
          {
            "name": "Joy",
            "office": "Rome"
          },
          {
            "name": "Max",
            "office": "Cairo"
          },
          {
            "name": "Pat",
            "office": "Tokyo"
          },
          {
            "name": "Eli",
            "office": "Cairo"
          },
          {
            "name": "Fay",
            "office": "Rome"
          }
        ]
      },
      "expected": "[\n  {\n    \"office\": \"Cairo\",\n    \"count\": 2\n  },\n  {\n    \"office\": \"Rome\",\n    \"count\": 2\n  },\n  {\n    \"office\": \"Tokyo\",\n    \"count\": 1\n  }\n]"
    }
  ]
}
