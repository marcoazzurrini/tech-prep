{
  "title": "Line totals",
  "statement": "Replace each line of the cart with its total.\n\nThe input is one cart. Its `lines` array holds objects with a `price` and a `qty`. The total of a line is `price` times `qty`. Give the whole cart back, with `lines` as an array of numbers and the other fields as they are.",
  "reference": ".lines |= map(.price * .qty)",
  "tests": [
    {
      "input": {
        "customer": "ada@example.com",
        "lines": [
          {
            "sku": "pen",
            "price": 2,
            "qty": 10
          },
          {
            "sku": "pad",
            "price": 5,
            "qty": 1
          }
        ]
      },
      "expected": "{\n  \"customer\": \"ada@example.com\",\n  \"lines\": [\n    20,\n    5\n  ]\n}"
    },
    {
      "input": {
        "customer": "bo@example.com",
        "lines": []
      },
      "expected": "{\n  \"customer\": \"bo@example.com\",\n  \"lines\": []\n}"
    },
    {
      "input": {
        "customer": "cy@example.com",
        "coupon": "SPRING",
        "lines": [
          {
            "sku": "ink",
            "price": 7,
            "qty": 0
          },
          {
            "sku": "cap",
            "price": 3,
            "qty": 3
          },
          {
            "sku": "bag",
            "price": 20,
            "qty": 2
          }
        ]
      },
      "expected": "{\n  \"customer\": \"cy@example.com\",\n  \"coupon\": \"SPRING\",\n  \"lines\": [\n    0,\n    9,\n    40\n  ]\n}"
    }
  ]
}
