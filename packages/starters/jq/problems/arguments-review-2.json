{
  "title": "Who to page",
  "statement": "Print the email of every person on one team who has a high enough level.\n\nDo not write the team or the level inside the filter. Pass the text `ops` into the command under the name `team`. Pass the number `3` under the name `level`. Keep each person whose `team` equals that team and whose `level` is that level or higher. Print each `email` as plain text, one per line, with no quotes.",
  "mode": "command",
  "stub": "'.'",
  "reference": "-r --arg team ops --argjson level 3 '.[] | select(.team == $team and .level >= $level) | .email'",
  "tests": [
    {
      "input": [
        {
          "email": "ada@example.com",
          "team": "ops",
          "level": 4
        },
        {
          "email": "bo@example.com",
          "team": "web",
          "level": 5
        },
        {
          "email": "cy@example.com",
          "team": "ops",
          "level": 2
        },
        {
          "email": "dee@example.com",
          "team": "ops",
          "level": 3
        }
      ],
      "expected": "ada@example.com\ndee@example.com"
    },
    {
      "input": [
        {
          "email": "eli@example.com",
          "team": "ops",
          "level": 3
        },
        {
          "email": "fay@example.com",
          "team": "data",
          "level": 3
        }
      ],
      "expected": "eli@example.com"
    },
    {
      "input": [
        {
          "email": "gus@example.com",
          "team": "web",
          "level": 1
        },
        {
          "email": "hal@example.com",
          "team": "ops",
          "level": 1
        }
      ],
      "expected": ""
    }
  ]
}
