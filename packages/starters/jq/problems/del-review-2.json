{
  "title": "Clean accounts",
  "statement": "Clean every account: take out the password and make the email lower case.\n\nThe input is an array of accounts. Each account has a `password` and an `email`. Give an array of accounts back, with every other field as it is.",
  "reference": "map(del(.password) | .email |= ascii_downcase)",
  "tests": [
    {
      "input": [
        {
          "id": 1,
          "email": "Ada@Example.com",
          "password": "x1"
        },
        {
          "id": 2,
          "email": "bo@example.com",
          "password": "y2",
          "admin": true
        }
      ],
      "expected": "[\n  {\n    \"id\": 1,\n    \"email\": \"ada@example.com\"\n  },\n  {\n    \"id\": 2,\n    \"email\": \"bo@example.com\",\n    \"admin\": true\n  }\n]"
    },
    {
      "input": [],
      "expected": "[]"
    },
    {
      "input": [
        {
          "id": 7,
          "email": "CY@EXAMPLE.COM",
          "password": ""
        }
      ],
      "expected": "[\n  {\n    \"id\": 7,\n    \"email\": \"cy@example.com\"\n  }\n]"
    }
  ]
}
