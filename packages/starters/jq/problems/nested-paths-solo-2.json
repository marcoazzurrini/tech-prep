{
  "title": "Tomorrow's temperature",
  "statement": "Print the temperature for tomorrow.",
  "reference": ".weather.tomorrow.temp",
  "tests": [
    {
      "input": {
        "weather": {
          "now": {
            "temp": 4,
            "wind": 12
          },
          "tomorrow": {
            "temp": 6,
            "wind": 9
          }
        }
      },
      "expected": "6"
    },
    {
      "input": {
        "weather": {
          "now": {
            "temp": 11,
            "wind": 3
          },
          "tomorrow": {
            "temp": 9,
            "wind": 20
          }
        }
      },
      "expected": "9"
    },
    {
      "input": {
        "weather": {
          "now": {
            "temp": -2,
            "wind": 7
          },
          "tomorrow": {
            "temp": -5,
            "wind": 7
          }
        }
      },
      "expected": "-5"
    }
  ]
}
