{
  "title": "All reviewers",
  "statement": "Give the name of every reviewer: the required ones first, then the optional ones.\n\nThe input has two arrays of names, `required` and `optional`. Print each name as its own output. Keep the order inside each array.",
  "reference": ".required[], .optional[]",
  "tests": [
    {
      "input": {
        "pr": 12,
        "required": [
          "ada",
          "bo"
        ],
        "optional": [
          "cy"
        ]
      },
      "expected": "\"ada\"\n\"bo\"\n\"cy\""
    },
    {
      "input": {
        "pr": 13,
        "required": [],
        "optional": [
          "dee",
          "eli"
        ]
      },
      "expected": "\"dee\"\n\"eli\""
    },
    {
      "input": {
        "pr": 14,
        "required": [
          "fay"
        ],
        "optional": []
      },
      "expected": "\"fay\""
    },
    {
      "input": {
        "pr": 15,
        "required": [],
        "optional": []
      },
      "expected": ""
    }
  ]
}
