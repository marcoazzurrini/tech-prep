{
  "title": "Package needs update",
  "statement": "Say whether the package needs an update.\n\nThe package needs an update when `installed` is different from `wanted` and `pinned` is `false`. Both versions are strings. Give `true` or `false`.",
  "reference": ".installed != .wanted and (.pinned | not)",
  "tests": [
    {
      "input": {
        "name": "left-pad",
        "installed": "1.2.0",
        "wanted": "1.3.0",
        "pinned": false
      },
      "expected": "true"
    },
    {
      "input": {
        "name": "chalk",
        "installed": "5.0.1",
        "wanted": "5.0.1",
        "pinned": false
      },
      "expected": "false"
    },
    {
      "input": {
        "name": "react",
        "installed": "17.0.2",
        "wanted": "18.2.0",
        "pinned": true
      },
      "expected": "false"
    },
    {
      "input": {
        "name": "zod",
        "installed": "3.22.0",
        "wanted": "3.22.0",
        "pinned": true
      },
      "expected": "false"
    }
  ]
}
