{
  "title": "Readings of a sensor",
  "statement": "Print the readings of the sensor as one array of numbers.\n\nThe readings are in `readings`. In the input each reading is a string.",
  "reference": "[.readings[] | tonumber]",
  "tests": [
    {
      "input": {
        "sensor": "temp-1",
        "readings": [
          "21.5",
          "22",
          "19.8"
        ]
      },
      "expected": "[\n  21.5,\n  22,\n  19.8\n]"
    },
    {
      "input": {
        "sensor": "temp-2",
        "readings": [
          "-3.2"
        ]
      },
      "expected": "[\n  -3.2\n]"
    },
    {
      "input": {
        "sensor": "temp-3",
        "readings": []
      },
      "expected": "[]"
    }
  ]
}
