{
  "title": "One line for a request",
  "statement": "Print one string that sums up the request: the method, a space, the path, a space, `->`, a space, and the status.\n\nFor the first input that is `\"GET /users/42 -> 200\"`.",
  "reference": "\"\\(.method) \\(.path) -> \\(.status)\"",
  "tests": [
    {
      "input": {
        "method": "GET",
        "path": "/users/42",
        "status": 200,
        "ms": 31
      },
      "expected": "\"GET /users/42 -> 200\""
    },
    {
      "input": {
        "method": "POST",
        "path": "/orders",
        "status": 201,
        "ms": 118
      },
      "expected": "\"POST /orders -> 201\""
    },
    {
      "input": {
        "method": "DELETE",
        "path": "/sessions/9",
        "status": 404,
        "ms": 7
      },
      "expected": "\"DELETE /sessions/9 -> 404\""
    }
  ]
}
