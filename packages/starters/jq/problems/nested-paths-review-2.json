{
  "title": "Content type",
  "statement": "Print the content type of the response.",
  "reference": ".response.headers[\"content-type\"]",
  "tests": [
    {
      "input": {
        "response": {
          "headers": {
            "content-type": "application/json",
            "server": "nginx"
          },
          "status": 200
        }
      },
      "expected": "\"application/json\""
    },
    {
      "input": {
        "response": {
          "headers": {
            "content-type": "text/html",
            "server": "nginx"
          },
          "status": 404
        }
      },
      "expected": "\"text/html\""
    },
    {
      "input": {
        "response": {
          "headers": {
            "content-type": "image/png",
            "server": "cdn"
          },
          "status": 200
        }
      },
      "expected": "\"image/png\""
    }
  ]
}
