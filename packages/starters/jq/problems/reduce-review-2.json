{
  "title": "Cost of a cart",
  "statement": "Give the total cost of the cart.\n\nThe `prices` object maps an item to the price of one piece. Each line of `cart` has an `item` and a `qty`. The cost of a line is the price of its item times its `qty`. Give the sum of all lines as one number. An empty cart costs 0.",
  "reference": ".prices as $p | reduce .cart[] as $line (0; . + $p[$line.item] * $line.qty)",
  "tests": [
    {
      "input": {
        "prices": {
          "pen": 2,
          "pad": 5,
          "ink": 9
        },
        "cart": [
          {
            "item": "pen",
            "qty": 3
          },
          {
            "item": "ink",
            "qty": 1
          },
          {
            "item": "pen",
            "qty": 1
          }
        ]
      },
      "expected": "17"
    },
    {
      "input": {
        "prices": {
          "mug": 7
        },
        "cart": []
      },
      "expected": "0"
    },
    {
      "input": {
        "prices": {
          "cap": 12,
          "bag": 30
        },
        "cart": [
          {
            "item": "bag",
            "qty": 2
          }
        ]
      },
      "expected": "60"
    },
    {
      "input": {
        "prices": {
          "tea": 4,
          "jam": 3
        },
        "cart": [
          {
            "item": "jam",
            "qty": 2
          },
          {
            "item": "tea",
            "qty": 5
          }
        ]
      },
      "expected": "26"
    }
  ]
}
