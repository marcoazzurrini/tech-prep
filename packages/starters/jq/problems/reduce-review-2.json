{
  "title": "Cost of the parcels",
  "statement": "Print what it costs to send all the parcels, as one number.\n\nEach parcel costs its `postage` plus the `handling` fee. The fee is the same for every parcel, and it is stored once, at the top. With no parcels the cost is 0.",
  "reference": ".handling as $fee | reduce .parcels[] as $p (0; . + $p.postage + $fee)",
  "tests": [
    {
      "input": {
        "handling": 3,
        "parcels": [
          {
            "to": "Oslo",
            "postage": 12
          },
          {
            "to": "Bergen",
            "postage": 9
          }
        ]
      },
      "expected": "27"
    },
    {
      "input": {
        "handling": 5,
        "parcels": []
      },
      "expected": "0"
    },
    {
      "input": {
        "handling": 2,
        "parcels": [
          {
            "to": "Tromsø",
            "postage": 30
          }
        ]
      },
      "expected": "32"
    },
    {
      "input": {
        "handling": 0,
        "parcels": [
          {
            "to": "Oslo",
            "postage": 4
          },
          {
            "to": "Oslo",
            "postage": 4
          },
          {
            "to": "Bodø",
            "postage": 11
          }
        ]
      },
      "expected": "19"
    }
  ]
}
