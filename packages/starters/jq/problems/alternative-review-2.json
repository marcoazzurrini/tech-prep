{
  "title": "Labels in a reply",
  "statement": "Give the label of every item in an API reply.\n\nA good reply has an `items` array. Print the `label` of each item as its own output. When an item has no `label`, or it is `null`, print `\"untitled\"`. A failed reply has no `items` field at all: for it, print nothing, with no error.",
  "reference": ".items[]? | .label // \"untitled\"",
  "tests": [
    {
      "input": {
        "status": 200,
        "items": [
          {
            "id": 1,
            "label": "Inbox"
          },
          {
            "id": 2
          },
          {
            "id": 3,
            "label": null
          },
          {
            "id": 4,
            "label": "Sent"
          }
        ]
      },
      "expected": "\"Inbox\"\n\"untitled\"\n\"untitled\"\n\"Sent\""
    },
    {
      "input": {
        "status": 500,
        "error": "server error"
      },
      "expected": ""
    },
    {
      "input": {
        "status": 200,
        "items": [
          {
            "id": 9
          }
        ]
      },
      "expected": "\"untitled\""
    },
    {
      "input": {
        "status": 200,
        "items": [
          {
            "id": 7,
            "label": "Drafts"
          }
        ]
      },
      "expected": "\"Drafts\""
    }
  ]
}
