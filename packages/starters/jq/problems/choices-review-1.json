{
  "title": "Cost of shipping",
  "statement": "Print what the customer pays for shipping, as a number.\n\nAn order with a `total` of 50 or more ships free: print `0`. For a smaller order, print the order's `shipping` fee.",
  "reference": "if .total >= 50 then 0 else .shipping end",
  "tests": [
    {
      "input": {
        "order": 71,
        "total": 32,
        "shipping": 4.5
      },
      "expected": "4.5"
    },
    {
      "input": {
        "order": 72,
        "total": 80,
        "shipping": 4.5
      },
      "expected": "0"
    },
    {
      "input": {
        "order": 73,
        "total": 50,
        "shipping": 9
      },
      "expected": "0"
    },
    {
      "input": {
        "order": 74,
        "total": 49.99,
        "shipping": 9
      },
      "expected": "9"
    }
  ]
}
