{
  "title": "Length of a name",
  "statement": "Print how many characters the user's name has.",
  "reference": ".name | length",
  "tests": [
    {
      "input": {
        "name": "Ada Lovelace",
        "id": 1
      },
      "expected": "12"
    },
    {
      "input": {
        "name": "Bo",
        "id": 2
      },
      "expected": "2"
    },
    {
      "input": {
        "name": "Cy Young",
        "id": 3
      },
      "expected": "8"
    }
  ]
}
