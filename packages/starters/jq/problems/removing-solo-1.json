{
  "title": "A request for the log",
  "statement": "The request will be written to a log. Print the whole request, without the `authorization` header.\n\nThe header is inside `headers`. Everything else stays as it is.",
  "reference": "del(.headers.authorization)",
  "tests": [
    {
      "input": {
        "method": "GET",
        "path": "/users",
        "headers": {
          "accept": "application/json",
          "authorization": "Bearer t-19a"
        }
      },
      "expected": "{\n  \"method\": \"GET\",\n  \"path\": \"/users\",\n  \"headers\": {\n    \"accept\": \"application/json\"\n  }\n}"
    },
    {
      "input": {
        "method": "POST",
        "path": "/orders",
        "headers": {
          "authorization": "Bearer t-77c"
        }
      },
      "expected": "{\n  \"method\": \"POST\",\n  \"path\": \"/orders\",\n  \"headers\": {}\n}"
    },
    {
      "input": {
        "method": "GET",
        "path": "/health",
        "headers": {
          "accept": "text/plain"
        }
      },
      "expected": "{\n  \"method\": \"GET\",\n  \"path\": \"/health\",\n  \"headers\": {\n    \"accept\": \"text/plain\"\n  }\n}"
    }
  ]
}
