{
  "title": "Failed builds",
  "statement": "Keep the builds that failed.\n\nThe input is an array of builds. A build failed when its `result` is `\"failed\"`. Give an array of whole builds back.",
  "reference": "map(select(.result == \"failed\"))",
  "tests": [
    {
      "input": [
        {
          "id": 101,
          "result": "passed"
        },
        {
          "id": 102,
          "result": "failed"
        },
        {
          "id": 103,
          "result": "failed"
        }
      ],
      "expected": "[\n  {\n    \"id\": 102,\n    \"result\": \"failed\"\n  },\n  {\n    \"id\": 103,\n    \"result\": \"failed\"\n  }\n]"
    },
    {
      "input": [
        {
          "id": 201,
          "result": "passed"
        }
      ],
      "expected": "[]"
    },
    {
      "input": [
        {
          "id": 301,
          "result": "failed"
        },
        {
          "id": 302,
          "result": "skipped"
        }
      ],
      "expected": "[\n  {\n    \"id\": 301,\n    \"result\": \"failed\"\n  }\n]"
    }
  ]
}
