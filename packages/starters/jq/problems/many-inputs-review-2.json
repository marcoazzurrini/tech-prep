{
  "title": "The last two results",
  "statement": "Print the last two test results of the file as one array.\n\nEach line of the input is one result, and there can be any number of lines. Print a single array that holds the last two results as whole objects. Print it on one line, with no spaces.",
  "mode": "command",
  "stub": "'.'",
  "reference": "-s -c '.[-2:]'",
  "tests": [
    {
      "input_text": "{\"test\": \"login\", \"pass\": true}\n{\"test\": \"search\", \"pass\": false}\n{\"test\": \"cart\", \"pass\": true}\n{\"test\": \"pay\", \"pass\": true}\n",
      "expected": "[{\"test\":\"cart\",\"pass\":true},{\"test\":\"pay\",\"pass\":true}]"
    },
    {
      "input_text": "{\"test\": \"signup\", \"pass\": false}\n{\"test\": \"logout\", \"pass\": true}\n",
      "expected": "[{\"test\":\"signup\",\"pass\":false},{\"test\":\"logout\",\"pass\":true}]"
    },
    {
      "input_text": "{\"test\": \"export\", \"pass\": true}\n",
      "expected": "[{\"test\":\"export\",\"pass\":true}]"
    }
  ]
}
