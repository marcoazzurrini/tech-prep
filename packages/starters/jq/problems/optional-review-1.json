{
  "title": "Customer cities",
  "statement": "Give the city of every customer whose address has one.\n\nThe input is an array of customers. For most customers, `address` is an object with a `city`. For some, `address` is plain text: skip those customers. Print each city as its own output.",
  "reference": ".[] | .address.city?",
  "tests": [
    {
      "input": [
        {
          "name": "Ben",
          "address": {
            "city": "Lyon"
          }
        },
        {
          "name": "Cara",
          "address": "unknown"
        },
        {
          "name": "Dov",
          "address": {
            "city": "Bern"
          }
        }
      ],
      "expected": "\"Lyon\"\n\"Bern\""
    },
    {
      "input": [
        {
          "name": "Edda",
          "address": "see notes"
        }
      ],
      "expected": ""
    },
    {
      "input": [
        {
          "name": "Finn",
          "address": {
            "city": "Graz"
          }
        }
      ],
      "expected": "\"Graz\""
    }
  ]
}
