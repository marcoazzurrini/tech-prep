{
  "title": "Error text",
  "statement": "Give the message of the error.\n\nThe input is an API reply. The error is the `error` object. Give its `message`, not the `message` at the top.",
  "reference": ".error.message",
  "tests": [
    {
      "input": {
        "status": 404,
        "message": "Request failed",
        "error": {
          "code": "no_user",
          "message": "No such user"
        }
      },
      "expected": "\"No such user\""
    },
    {
      "input": {
        "status": 403,
        "message": "Request failed",
        "error": {
          "code": "no_access",
          "message": "Not allowed"
        }
      },
      "expected": "\"Not allowed\""
    },
    {
      "input": {
        "status": 429,
        "message": "Request failed",
        "error": {
          "code": "slow_down",
          "message": "Too many requests"
        }
      },
      "expected": "\"Too many requests\""
    }
  ]
}
