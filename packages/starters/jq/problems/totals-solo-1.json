{
  "title": "Coldest reading",
  "statement": "Print the lowest temperature the sensor measured.\n\nThe temperatures are in `readings`. Print one number.",
  "reference": ".readings | min",
  "tests": [
    {
      "input": {
        "sensor": "s-4",
        "readings": [
          18.5,
          16.2,
          21,
          17.4
        ]
      },
      "expected": "16.2"
    },
    {
      "input": {
        "sensor": "s-5",
        "readings": [
          3,
          -2,
          0.5
        ]
      },
      "expected": "-2"
    },
    {
      "input": {
        "sensor": "s-6",
        "readings": [
          25.1
        ]
      },
      "expected": "25.1"
    }
  ]
}
