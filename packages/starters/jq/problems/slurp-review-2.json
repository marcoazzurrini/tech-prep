{
  "title": "Upload summary",
  "statement": "Print a one-line summary of the uploads.\n\nThe input holds many uploads, one JSON object per line. Each has a `file`. Build one object with two keys, in this order: `count`, the number of uploads, and `last`, the `file` of the last upload. Print it as one line of JSON, with no spaces. For example `{\"count\":2,\"last\":\"b.png\"}`.",
  "mode": "command",
  "stub": "'.'",
  "reference": "-c -s '{count: length, last: .[-1].file}'",
  "tests": [
    {
      "input_text": "{\"file\":\"a.png\",\"bytes\":2048}\n{\"file\":\"notes.txt\",\"bytes\":310}\n{\"file\":\"b.png\",\"bytes\":4096}\n",
      "expected": "{\"count\":3,\"last\":\"b.png\"}"
    },
    {
      "input_text": "{\"file\":\"cv.pdf\",\"bytes\":88000}\n",
      "expected": "{\"count\":1,\"last\":\"cv.pdf\"}"
    },
    {
      "input_text": "{\"file\":\"one.csv\",\"bytes\":120}\n{\"file\":\"two.csv\",\"bytes\":140}\n",
      "expected": "{\"count\":2,\"last\":\"two.csv\"}"
    },
    {
      "input_text": "{\"file\":\"x.zip\",\"bytes\":9}\n{\"file\":\"y.zip\",\"bytes\":8}\n{\"file\":\"z.zip\",\"bytes\":7}\n{\"file\":\"w.zip\",\"bytes\":6}\n",
      "expected": "{\"count\":4,\"last\":\"w.zip\"}"
    }
  ]
}
