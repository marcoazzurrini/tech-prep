{
  "title": "Size of each title",
  "statement": "Give the number of characters in the title of every article, as one array of numbers.\n\nThe input is an array of articles. Each article has a `title`. A space is one character too. Keep the order.",
  "reference": "map(.title | length)",
  "tests": [
    {
      "input": [
        {
          "id": 1,
          "title": "Why jq"
        },
        {
          "id": 2,
          "title": "Pipes"
        },
        {
          "id": 3,
          "title": "JSON in the shell"
        }
      ],
      "expected": "[\n  6,\n  5,\n  17\n]"
    },
    {
      "input": [],
      "expected": "[]"
    },
    {
      "input": [
        {
          "id": 4,
          "title": ""
        },
        {
          "id": 5,
          "title": "Go"
        }
      ],
      "expected": "[\n  0,\n  2\n]"
    },
    {
      "input": [
        {
          "id": 6,
          "title": "Logs"
        }
      ],
      "expected": "[\n  4\n]"
    }
  ]
}
