{
  "title": "Shape of the data",
  "check": {
    "type": "command",
    "program": "jq",
    "compare": "json",
    "file": "data.json",
    "reference": "jq '.response.data | type' data.json",
    "tests": [
      {
        "input": {
          "response": {
            "status": 200,
            "data": [
              {
                "id": 1
              },
              {
                "id": 2
              }
            ]
          }
        },
        "expected": "\"array\""
      },
      {
        "input": {
          "response": {
            "status": 200,
            "data": {
              "id": 1
            }
          }
        },
        "expected": "\"object\""
      },
      {
        "input": {
          "response": {
            "status": 204
          }
        },
        "expected": "\"null\""
      },
      {
        "input": {
          "response": {
            "status": 500,
            "data": "internal error"
          }
        },
        "expected": "\"string\""
      }
    ]
  }
}
