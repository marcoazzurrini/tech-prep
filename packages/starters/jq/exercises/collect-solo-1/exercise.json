{
  "title": "Names of the packages",
  "check": {
    "type": "command",
    "program": "jq",
    "compare": "json",
    "file": "data.json",
    "reference": "jq '[.dependencies[] | .name]' data.json",
    "tests": [
      {
        "input": {
          "name": "shop-web",
          "dependencies": [
            {
              "name": "react",
              "version": "18.2.0"
            },
            {
              "name": "zod",
              "version": "3.22.4"
            },
            {
              "name": "vite",
              "version": "5.0.8"
            }
          ]
        },
        "expected": "[\n  \"react\",\n  \"zod\",\n  \"vite\"\n]"
      },
      {
        "input": {
          "name": "cli-tool",
          "dependencies": [
            {
              "name": "chalk",
              "version": "5.3.0"
            }
          ]
        },
        "expected": "[\n  \"chalk\"\n]"
      },
      {
        "input": {
          "name": "empty-app",
          "dependencies": []
        },
        "expected": "[]"
      }
    ]
  }
}
