{
  "title": "Cost of shipping",
  "check": {
    "type": "command",
    "program": "jq",
    "compare": "json",
    "file": "data.json",
    "reference": "jq 'if .total >= 50 then 0 else .shipping end' data.json",
    "tests": [
      {
        "input": {
          "order": 71,
          "total": 32,
          "shipping": 4.5
        },
        "expected": "4.5"
      },
      {
        "input": {
          "order": 72,
          "total": 80,
          "shipping": 4.5
        },
        "expected": "0"
      },
      {
        "input": {
          "order": 73,
          "total": 50,
          "shipping": 9
        },
        "expected": "0"
      },
      {
        "input": {
          "order": 74,
          "total": 49.99,
          "shipping": 9
        },
        "expected": "9"
      }
    ]
  }
}
