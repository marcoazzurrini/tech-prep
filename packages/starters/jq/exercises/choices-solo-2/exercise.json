{
  "title": "Load of each server",
  "check": {
    "type": "command",
    "program": "jq",
    "compare": "json",
    "file": "data.json",
    "reference": "jq 'map(if . >= 90 then \"critical\" elif . >= 70 then \"warning\" else \"normal\" end)' data.json",
    "tests": [
      {
        "input": [
          95,
          72,
          30,
          90
        ],
        "expected": "[\n  \"critical\",\n  \"warning\",\n  \"normal\",\n  \"critical\"\n]"
      },
      {
        "input": [
          12,
          8
        ],
        "expected": "[\n  \"normal\",\n  \"normal\"\n]"
      },
      {
        "input": [
          70,
          69,
          100
        ],
        "expected": "[\n  \"warning\",\n  \"normal\",\n  \"critical\"\n]"
      },
      {
        "input": [
          89
        ],
        "expected": "[\n  \"warning\"\n]"
      }
    ]
  }
}
