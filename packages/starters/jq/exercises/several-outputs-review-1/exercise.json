{
  "title": "Result of a build",
  "check": {
    "type": "command",
    "program": "jq",
    "compare": "json",
    "file": "data.json",
    "reference": "jq '.status, .timing.duration_ms' data.json",
    "tests": [
      {
        "input": {
          "id": 88,
          "status": "passed",
          "timing": {
            "queued_ms": 310,
            "duration_ms": 48200
          }
        },
        "expected": "\"passed\"\n48200"
      },
      {
        "input": {
          "id": 89,
          "status": "failed",
          "timing": {
            "queued_ms": 95,
            "duration_ms": 6120
          }
        },
        "expected": "\"failed\"\n6120"
      },
      {
        "input": {
          "id": 90,
          "status": "cancelled",
          "timing": {
            "queued_ms": 1200,
            "duration_ms": 0
          }
        },
        "expected": "\"cancelled\"\n0"
      }
    ]
  }
}
