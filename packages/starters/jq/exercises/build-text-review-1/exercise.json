{
  "title": "One line for a request",
  "check": {
    "type": "command",
    "program": "jq",
    "compare": "json",
    "file": "data.json",
    "reference": "jq '\"\\(.method) \\(.path) -> \\(.status)\"' data.json",
    "tests": [
      {
        "input": {
          "method": "GET",
          "path": "/users/42",
          "status": 200,
          "ms": 31
        },
        "expected": "\"GET /users/42 -> 200\""
      },
      {
        "input": {
          "method": "POST",
          "path": "/orders",
          "status": 201,
          "ms": 118
        },
        "expected": "\"POST /orders -> 201\""
      },
      {
        "input": {
          "method": "DELETE",
          "path": "/sessions/9",
          "status": 404,
          "ms": 7
        },
        "expected": "\"DELETE /sessions/9 -> 404\""
      }
    ]
  }
}
