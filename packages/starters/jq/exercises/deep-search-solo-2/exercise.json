{
  "title": "Every link in the menu",
  "check": {
    "type": "command",
    "program": "jq",
    "compare": "json",
    "file": "data.json",
    "reference": "jq '.. | .url? | select(. != null)' data.json",
    "tests": [
      {
        "input": {
          "label": "Home",
          "url": "/",
          "children": [
            {
              "label": "Shop",
              "url": "/shop"
            },
            {
              "label": "More",
              "children": [
                {
                  "label": "About",
                  "url": "/about"
                }
              ]
            }
          ]
        },
        "expected": "\"/\"\n\"/shop\"\n\"/about\""
      },
      {
        "input": {
          "label": "Legal",
          "children": [
            {
              "label": "Terms",
              "url": "/terms"
            },
            {
              "label": "Soon"
            }
          ]
        },
        "expected": "\"/terms\""
      },
      {
        "input": {
          "label": "Docs",
          "url": "/docs",
          "children": [
            {
              "label": "API",
              "url": "/docs/api",
              "children": [
                {
                  "label": "Auth",
                  "url": "/docs/api/auth"
                }
              ]
            }
          ]
        },
        "expected": "\"/docs\"\n\"/docs/api\"\n\"/docs/api/auth\""
      }
    ]
  }
}
