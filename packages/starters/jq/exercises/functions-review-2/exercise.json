{
  "title": "Disks of two servers",
  "check": {
    "type": "command",
    "program": "jq",
    "compare": "json",
    "file": "data.json",
    "reference": "jq 'def disks: .host as $host | .disks | map({host: $host, disk: .}); {primary: .primary | disks, replica: .replica | disks}' data.json",
    "tests": [
      {
        "input": {
          "cluster": "orders",
          "primary": {
            "host": "db-1",
            "disks": [
              "sda",
              "sdb"
            ]
          },
          "replica": {
            "host": "db-2",
            "disks": [
              "sda"
            ]
          }
        },
        "expected": "{\n  \"primary\": [\n    {\n      \"host\": \"db-1\",\n      \"disk\": \"sda\"\n    },\n    {\n      \"host\": \"db-1\",\n      \"disk\": \"sdb\"\n    }\n  ],\n  \"replica\": [\n    {\n      \"host\": \"db-2\",\n      \"disk\": \"sda\"\n    }\n  ]\n}"
      },
      {
        "input": {
          "cluster": "users",
          "primary": {
            "host": "pg-7",
            "disks": [
              "nvme0"
            ]
          },
          "replica": {
            "host": "pg-8",
            "disks": []
          }
        },
        "expected": "{\n  \"primary\": [\n    {\n      \"host\": \"pg-7\",\n      \"disk\": \"nvme0\"\n    }\n  ],\n  \"replica\": []\n}"
      },
      {
        "input": {
          "cluster": "logs",
          "primary": {
            "host": "es-1",
            "disks": [
              "sda",
              "sdb",
              "sdc"
            ]
          },
          "replica": {
            "host": "es-2",
            "disks": [
              "sda",
              "sdb"
            ]
          }
        },
        "expected": "{\n  \"primary\": [\n    {\n      \"host\": \"es-1\",\n      \"disk\": \"sda\"\n    },\n    {\n      \"host\": \"es-1\",\n      \"disk\": \"sdb\"\n    },\n    {\n      \"host\": \"es-1\",\n      \"disk\": \"sdc\"\n    }\n  ],\n  \"replica\": [\n    {\n      \"host\": \"es-2\",\n      \"disk\": \"sda\"\n    },\n    {\n      \"host\": \"es-2\",\n      \"disk\": \"sdb\"\n    }\n  ]\n}"
      }
    ]
  }
}
