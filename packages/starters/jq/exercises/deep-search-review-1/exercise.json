{
  "title": "Tasks still open",
  "check": {
    "type": "command",
    "program": "jq",
    "compare": "json",
    "file": "data.json",
    "reference": "jq '.. | select(type == \"object\") | select(.done == false) | .title' data.json",
    "tests": [
      {
        "input": {
          "project": "launch",
          "tasks": [
            {
              "title": "Write docs",
              "done": true,
              "subtasks": [
                {
                  "title": "Fix typos",
                  "done": false,
                  "subtasks": []
                }
              ]
            },
            {
              "title": "Ship",
              "done": false,
              "subtasks": []
            }
          ]
        },
        "expected": "\"Fix typos\"\n\"Ship\""
      },
      {
        "input": {
          "project": "cleanup",
          "tasks": [
            {
              "title": "Delete logs",
              "done": true,
              "subtasks": [
                {
                  "title": "Empty the bin",
                  "done": false,
                  "subtasks": []
                }
              ]
            },
            {
              "title": "Close tickets",
              "done": true,
              "subtasks": []
            }
          ]
        },
        "expected": "\"Empty the bin\""
      },
      {
        "input": {
          "project": "audit",
          "tasks": [
            {
              "title": "Review",
              "done": false,
              "subtasks": [
                {
                  "title": "Read code",
                  "done": false,
                  "subtasks": [
                    {
                      "title": "Take notes",
                      "done": false,
                      "subtasks": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        "expected": "\"Review\"\n\"Read code\"\n\"Take notes\""
      }
    ]
  }
}
