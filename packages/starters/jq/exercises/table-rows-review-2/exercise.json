{
  "title": "Scores for a spreadsheet",
  "check": {
    "type": "command",
    "program": "jq",
    "compare": "text",
    "file": "data.json",
    "reference": "jq -r '.results | .[] | [.user.name, .user.email, .score] | @csv' data.json",
    "tests": [
      {
        "input": {
          "quiz": "sql-basics",
          "results": [
            {
              "user": {
                "name": "Lena",
                "email": "lena@example.com"
              },
              "score": 92
            },
            {
              "user": {
                "name": "Omar",
                "email": "omar@example.com"
              },
              "score": 78
            }
          ]
        },
        "expected": "\"Lena\",\"lena@example.com\",92\n\"Omar\",\"omar@example.com\",78"
      },
      {
        "input": {
          "quiz": "git-intro",
          "results": [
            {
              "user": {
                "name": "Ines",
                "email": "ines@example.com"
              },
              "score": 100
            }
          ]
        },
        "expected": "\"Ines\",\"ines@example.com\",100"
      },
      {
        "input": {
          "quiz": "shell",
          "results": [
            {
              "user": {
                "name": "Kofi",
                "email": "kofi@example.com"
              },
              "score": 64
            },
            {
              "user": {
                "name": "Yuki",
                "email": "yuki@example.com"
              },
              "score": 88
            },
            {
              "user": {
                "name": "Sam",
                "email": "sam@example.com"
              },
              "score": 71
            }
          ]
        },
        "expected": "\"Kofi\",\"kofi@example.com\",64\n\"Yuki\",\"yuki@example.com\",88\n\"Sam\",\"sam@example.com\",71"
      }
    ]
  }
}
