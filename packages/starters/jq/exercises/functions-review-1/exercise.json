{
  "title": "Teams of a match",
  "check": {
    "type": "command",
    "program": "jq",
    "compare": "json",
    "file": "data.json",
    "reference": "jq 'def team: {name, players: .players | length}; {home: .home | team, away: .away | team}' data.json",
    "tests": [
      {
        "input": {
          "match": 301,
          "home": {
            "name": "Otters",
            "city": "Oslo",
            "players": [
              "Ada",
              "Bo",
              "Cy"
            ]
          },
          "away": {
            "name": "Herons",
            "city": "Bergen",
            "players": [
              "Dee",
              "Eli"
            ]
          }
        },
        "expected": "{\n  \"home\": {\n    \"name\": \"Otters\",\n    \"players\": 3\n  },\n  \"away\": {\n    \"name\": \"Herons\",\n    \"players\": 2\n  }\n}"
      },
      {
        "input": {
          "match": 302,
          "home": {
            "name": "Lynx",
            "city": "Bodø",
            "players": [
              "Fay"
            ]
          },
          "away": {
            "name": "Otters",
            "city": "Oslo",
            "players": [
              "Ada",
              "Bo",
              "Cy",
              "Gus"
            ]
          }
        },
        "expected": "{\n  \"home\": {\n    \"name\": \"Lynx\",\n    \"players\": 1\n  },\n  \"away\": {\n    \"name\": \"Otters\",\n    \"players\": 4\n  }\n}"
      },
      {
        "input": {
          "match": 303,
          "home": {
            "name": "Herons",
            "city": "Bergen",
            "players": []
          },
          "away": {
            "name": "Lynx",
            "city": "Bodø",
            "players": [
              "Fay",
              "Hal"
            ]
          }
        },
        "expected": "{\n  \"home\": {\n    \"name\": \"Herons\",\n    \"players\": 0\n  },\n  \"away\": {\n    \"name\": \"Lynx\",\n    \"players\": 2\n  }\n}"
      }
    ]
  }
}
