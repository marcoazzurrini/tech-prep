{
  "title": "Node versions in use",
  "check": {
    "type": "command",
    "program": "jq",
    "compare": "json",
    "file": "data.json",
    "reference": "jq 'map(.node) | unique | reverse' data.json",
    "tests": [
      {
        "input": [
          {
            "host": "web-1",
            "node": 20
          },
          {
            "host": "web-2",
            "node": 22
          },
          {
            "host": "api-1",
            "node": 18
          },
          {
            "host": "api-2",
            "node": 22
          },
          {
            "host": "job-1",
            "node": 20
          }
        ],
        "expected": "[\n  22,\n  20,\n  18\n]"
      },
      {
        "input": [
          {
            "host": "a",
            "node": 24
          },
          {
            "host": "b",
            "node": 24
          }
        ],
        "expected": "[\n  24\n]"
      },
      {
        "input": [
          {
            "host": "x",
            "node": 16
          },
          {
            "host": "y",
            "node": 22
          },
          {
            "host": "z",
            "node": 16
          }
        ],
        "expected": "[\n  22,\n  16\n]"
      }
    ]
  }
}
