{
  "title": "Orders and buyers",
  "check": {
    "type": "command",
    "program": "jq",
    "compare": "json",
    "file": "data.json",
    "reference": "jq '.orders | .[] | .id, .customer.email' data.json",
    "tests": [
      {
        "input": {
          "page": 1,
          "orders": [
            {
              "id": "ord-1041",
              "total": 59.9,
              "customer": {
                "name": "Lena",
                "email": "lena@example.com"
              }
            },
            {
              "id": "ord-1042",
              "total": 12,
              "customer": {
                "name": "Omar",
                "email": "omar@example.com"
              }
            }
          ]
        },
        "expected": "\"ord-1041\"\n\"lena@example.com\"\n\"ord-1042\"\n\"omar@example.com\""
      },
      {
        "input": {
          "page": 2,
          "orders": [
            {
              "id": "ord-1050",
              "total": 240.5,
              "customer": {
                "name": "Ines",
                "email": "ines@example.com"
              }
            }
          ]
        },
        "expected": "\"ord-1050\"\n\"ines@example.com\""
      },
      {
        "input": {
          "page": 3,
          "orders": [
            {
              "id": "ord-1061",
              "total": 8,
              "customer": {
                "name": "Kofi",
                "email": "kofi@example.com"
              }
            },
            {
              "id": "ord-1062",
              "total": 31.25,
              "customer": {
                "name": "Yuki",
                "email": "yuki@example.com"
              }
            },
            {
              "id": "ord-1063",
              "total": 99,
              "customer": {
                "name": "Sam",
                "email": "sam@example.com"
              }
            }
          ]
        },
        "expected": "\"ord-1061\"\n\"kofi@example.com\"\n\"ord-1062\"\n\"yuki@example.com\"\n\"ord-1063\"\n\"sam@example.com\""
      }
    ]
  }
}
