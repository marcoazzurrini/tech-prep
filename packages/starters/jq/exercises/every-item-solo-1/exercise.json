{
  "title": "Titles of the issues",
  "check": {
    "type": "command",
    "program": "jq",
    "compare": "json",
    "file": "data.json",
    "reference": "jq '.[] | .title' data.json",
    "tests": [
      {
        "input": [
          {
            "id": 12,
            "title": "Login fails",
            "open": true
          },
          {
            "id": 15,
            "title": "Typo in footer",
            "open": false
          },
          {
            "id": 19,
            "title": "Slow search",
            "open": true
          }
        ],
        "expected": "\"Login fails\"\n\"Typo in footer\"\n\"Slow search\""
      },
      {
        "input": [
          {
            "id": 3,
            "title": "Add dark mode",
            "open": true
          }
        ],
        "expected": "\"Add dark mode\""
      },
      {
        "input": [
          {
            "id": 40,
            "title": "Crash on start",
            "open": false
          },
          {
            "id": 41,
            "title": "Wrong total",
            "open": true
          }
        ],
        "expected": "\"Crash on start\"\n\"Wrong total\""
      }
    ]
  }
}
