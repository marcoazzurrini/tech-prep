{
  "title": "Stock after the sales",
  "check": {
    "type": "command",
    "program": "jq",
    "compare": "json",
    "file": "data.json",
    "reference": "jq 'reduce .sales[] as $s (.stock; . - $s.qty)' data.json",
    "tests": [
      {
        "input": {
          "sku": "pen",
          "stock": 50,
          "sales": [
            {
              "day": "mon",
              "qty": 12
            },
            {
              "day": "tue",
              "qty": 8
            }
          ]
        },
        "expected": "30"
      },
      {
        "input": {
          "sku": "ink",
          "stock": 9,
          "sales": []
        },
        "expected": "9"
      },
      {
        "input": {
          "sku": "lamp",
          "stock": 20,
          "sales": [
            {
              "day": "mon",
              "qty": 5
            },
            {
              "day": "wed",
              "qty": 5
            },
            {
              "day": "fri",
              "qty": 10
            }
          ]
        },
        "expected": "0"
      }
    ]
  }
}
