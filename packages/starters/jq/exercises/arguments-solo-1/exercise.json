{
  "title": "Tickets of one person",
  "check": {
    "type": "command",
    "program": "jq",
    "compare": "text",
    "file": "data.json",
    "reference": "jq --arg owner bo '.[] | select(.owner == $owner)' data.json",
    "tests": [
      {
        "input": [
          {
            "id": "T-1",
            "owner": "bo"
          },
          {
            "id": "T-2",
            "owner": "ada"
          },
          {
            "id": "T-3",
            "owner": "bo"
          }
        ],
        "expected": "{\n  \"id\": \"T-1\",\n  \"owner\": \"bo\"\n}\n{\n  \"id\": \"T-3\",\n  \"owner\": \"bo\"\n}"
      },
      {
        "input": [
          {
            "id": "T-8",
            "owner": "cy"
          },
          {
            "id": "T-9",
            "owner": "bo"
          }
        ],
        "expected": "{\n  \"id\": \"T-9\",\n  \"owner\": \"bo\"\n}"
      },
      {
        "input": [
          {
            "id": "T-20",
            "owner": "ada"
          },
          {
            "id": "T-21",
            "owner": "cy"
          }
        ],
        "expected": ""
      }
    ]
  }
}
