{
  "title": "Plans under 20",
  "check": {
    "type": "command",
    "program": "jq",
    "compare": "json",
    "file": "data.json",
    "reference": "jq 'map(select(.price < 20))' data.json",
    "tests": [
      {
        "input": [
          {
            "plan": "free",
            "price": 0
          },
          {
            "plan": "pro",
            "price": 12
          },
          {
            "plan": "team",
            "price": 49
          }
        ],
        "expected": "[\n  {\n    \"plan\": \"free\",\n    \"price\": 0\n  },\n  {\n    \"plan\": \"pro\",\n    \"price\": 12\n  }\n]"
      },
      {
        "input": [
          {
            "plan": "basic",
            "price": 20
          },
          {
            "plan": "plus",
            "price": 35
          }
        ],
        "expected": "[]"
      },
      {
        "input": [
          {
            "plan": "solo",
            "price": 19
          },
          {
            "plan": "max",
            "price": 99
          }
        ],
        "expected": "[\n  {\n    \"plan\": \"solo\",\n    \"price\": 19\n  }\n]"
      }
    ]
  }
}
