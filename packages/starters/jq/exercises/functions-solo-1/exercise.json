{
  "title": "Changes in a release",
  "check": {
    "type": "command",
    "program": "jq",
    "compare": "json",
    "file": "data.json",
    "reference": "jq 'def slim: map({name, version}); {added: .added | slim, removed: .removed | slim}' data.json",
    "tests": [
      {
        "input": {
          "release": "3.0",
          "added": [
            {
              "name": "zod",
              "version": "3.22.0",
              "license": "MIT"
            },
            {
              "name": "hono",
              "version": "4.0.1",
              "license": "MIT"
            }
          ],
          "removed": [
            {
              "name": "joi",
              "version": "17.9.0",
              "license": "BSD"
            }
          ]
        },
        "expected": "{\n  \"added\": [\n    {\n      \"name\": \"zod\",\n      \"version\": \"3.22.0\"\n    },\n    {\n      \"name\": \"hono\",\n      \"version\": \"4.0.1\"\n    }\n  ],\n  \"removed\": [\n    {\n      \"name\": \"joi\",\n      \"version\": \"17.9.0\"\n    }\n  ]\n}"
      },
      {
        "input": {
          "release": "3.1",
          "added": [],
          "removed": [
            {
              "name": "left-pad",
              "version": "1.3.0",
              "license": "WTFPL"
            }
          ]
        },
        "expected": "{\n  \"added\": [],\n  \"removed\": [\n    {\n      \"name\": \"left-pad\",\n      \"version\": \"1.3.0\"\n    }\n  ]\n}"
      },
      {
        "input": {
          "release": "3.2",
          "added": [
            {
              "name": "vitest",
              "version": "1.2.0",
              "license": "MIT"
            }
          ],
          "removed": []
        },
        "expected": "{\n  \"added\": [\n    {\n      \"name\": \"vitest\",\n      \"version\": \"1.2.0\"\n    }\n  ],\n  \"removed\": []\n}"
      }
    ]
  }
}
