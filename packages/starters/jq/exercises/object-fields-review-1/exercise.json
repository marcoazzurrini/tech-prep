{
  "title": "Package version",
  "check": {
    "type": "command",
    "program": "jq",
    "compare": "json",
    "file": "data.json",
    "reference": "jq '.version' data.json",
    "tests": [
      {
        "input": {
          "name": "left-pad",
          "version": "1.3.0",
          "license": "MIT"
        },
        "expected": "\"1.3.0\""
      },
      {
        "input": {
          "name": "chalk",
          "version": "5.3.0",
          "license": "MIT"
        },
        "expected": "\"5.3.0\""
      },
      {
        "input": {
          "name": "zod",
          "version": "4.6.5",
          "license": "MIT"
        },
        "expected": "\"4.6.5\""
      }
    ]
  }
}
