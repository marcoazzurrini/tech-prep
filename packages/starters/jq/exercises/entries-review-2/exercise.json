{
  "title": "Aliases the other way",
  "check": {
    "type": "command",
    "program": "jq",
    "compare": "json",
    "file": "data.json",
    "reference": "jq 'to_entries | map({key: .value, value: .key}) | from_entries' data.json",
    "tests": [
      {
        "input": {
          "co": "checkout",
          "st": "status",
          "br": "branch"
        },
        "expected": "{\n  \"checkout\": \"co\",\n  \"status\": \"st\",\n  \"branch\": \"br\"\n}"
      },
      {
        "input": {
          "ll": "list"
        },
        "expected": "{\n  \"list\": \"ll\"\n}"
      },
      {
        "input": {
          "i": "install",
          "rm": "remove",
          "up": "update",
          "ls": "list"
        },
        "expected": "{\n  \"install\": \"i\",\n  \"remove\": \"rm\",\n  \"update\": \"up\",\n  \"list\": \"ls\"\n}"
      }
    ]
  }
}
