{
  "title": "Countries of the visitors",
  "check": {
    "type": "command",
    "program": "jq",
    "compare": "json",
    "file": "data.json",
    "reference": "jq '.visits | map(.country) | unique | length' data.json",
    "tests": [
      {
        "input": {
          "day": "2026-03-02",
          "visits": [
            {
              "ip": "203.0.113.5",
              "country": "NO"
            },
            {
              "ip": "203.0.113.9",
              "country": "IT"
            },
            {
              "ip": "198.51.100.2",
              "country": "NO"
            },
            {
              "ip": "198.51.100.7",
              "country": "JP"
            },
            {
              "ip": "192.0.2.44",
              "country": "IT"
            }
          ]
        },
        "expected": "3"
      },
      {
        "input": {
          "day": "2026-03-03",
          "visits": [
            {
              "ip": "203.0.113.5",
              "country": "NO"
            },
            {
              "ip": "203.0.113.6",
              "country": "NO"
            }
          ]
        },
        "expected": "1"
      },
      {
        "input": {
          "day": "2026-03-04",
          "visits": [
            {
              "ip": "192.0.2.1",
              "country": "BR"
            },
            {
              "ip": "192.0.2.2",
              "country": "CA"
            },
            {
              "ip": "192.0.2.3",
              "country": "DE"
            },
            {
              "ip": "192.0.2.4",
              "country": "FR"
            }
          ]
        },
        "expected": "4"
      }
    ]
  }
}
