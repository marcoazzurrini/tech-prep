{
  "title": "Jobs that gave up",
  "check": {
    "type": "command",
    "program": "jq",
    "compare": "json",
    "file": "data.json",
    "reference": "jq '.jobs | map(select(.status == \"failed\" and .attempts >= 3)) | length' data.json",
    "tests": [
      {
        "input": {
          "queue": "mail",
          "jobs": [
            {
              "id": "j1",
              "status": "failed",
              "attempts": 3
            },
            {
              "id": "j2",
              "status": "failed",
              "attempts": 1
            },
            {
              "id": "j3",
              "status": "done",
              "attempts": 4
            },
            {
              "id": "j4",
              "status": "failed",
              "attempts": 5
            }
          ]
        },
        "expected": "2"
      },
      {
        "input": {
          "queue": "images",
          "jobs": [
            {
              "id": "j9",
              "status": "done",
              "attempts": 1
            },
            {
              "id": "j10",
              "status": "failed",
              "attempts": 2
            }
          ]
        },
        "expected": "0"
      },
      {
        "input": {
          "queue": "reports",
          "jobs": [
            {
              "id": "j20",
              "status": "failed",
              "attempts": 3
            }
          ]
        },
        "expected": "1"
      }
    ]
  }
}
