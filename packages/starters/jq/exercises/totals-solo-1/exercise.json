{
  "title": "Coldest reading",
  "check": {
    "type": "command",
    "program": "jq",
    "compare": "json",
    "file": "data.json",
    "reference": "jq '.readings | min' data.json",
    "tests": [
      {
        "input": {
          "sensor": "s-4",
          "readings": [
            18.5,
            16.2,
            21,
            17.4
          ]
        },
        "expected": "16.2"
      },
      {
        "input": {
          "sensor": "s-5",
          "readings": [
            3,
            -2,
            0.5
          ]
        },
        "expected": "-2"
      },
      {
        "input": {
          "sensor": "s-6",
          "readings": [
            25.1
          ]
        },
        "expected": "25.1"
      }
    ]
  }
}
