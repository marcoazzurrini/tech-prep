{
  "title": "Results on the page",
  "check": {
    "type": "command",
    "program": "jq",
    "compare": "json",
    "file": "data.json",
    "reference": "jq '.results | length' data.json",
    "tests": [
      {
        "input": {
          "page": 2,
          "results": [
            {
              "id": 1
            },
            {
              "id": 2
            },
            {
              "id": 3
            }
          ]
        },
        "expected": "3"
      },
      {
        "input": {
          "page": 3,
          "results": [
            {
              "id": 4
            }
          ]
        },
        "expected": "1"
      },
      {
        "input": {
          "page": 4,
          "results": []
        },
        "expected": "0"
      }
    ]
  }
}
