{
  "title": "Repos of each language",
  "check": {
    "type": "command",
    "program": "jq",
    "compare": "json",
    "file": "data.json",
    "reference": "jq 'group_by(.lang) | map({lang: .[0].lang, repos: map(.name)})' data.json",
    "tests": [
      {
        "input": [
          {
            "name": "api",
            "lang": "go"
          },
          {
            "name": "web",
            "lang": "ts"
          },
          {
            "name": "cli",
            "lang": "go"
          },
          {
            "name": "docs",
            "lang": "ts"
          },
          {
            "name": "ml",
            "lang": "python"
          }
        ],
        "expected": "[\n  {\n    \"lang\": \"go\",\n    \"repos\": [\n      \"api\",\n      \"cli\"\n    ]\n  },\n  {\n    \"lang\": \"python\",\n    \"repos\": [\n      \"ml\"\n    ]\n  },\n  {\n    \"lang\": \"ts\",\n    \"repos\": [\n      \"web\",\n      \"docs\"\n    ]\n  }\n]"
      },
      {
        "input": [
          {
            "name": "blog",
            "lang": "ruby"
          },
          {
            "name": "shop",
            "lang": "ruby"
          }
        ],
        "expected": "[\n  {\n    \"lang\": \"ruby\",\n    \"repos\": [\n      \"blog\",\n      \"shop\"\n    ]\n  }\n]"
      },
      {
        "input": [
          {
            "name": "kernel",
            "lang": "c"
          },
          {
            "name": "site",
            "lang": "ts"
          },
          {
            "name": "tool",
            "lang": "rust"
          },
          {
            "name": "game",
            "lang": "c"
          }
        ],
        "expected": "[\n  {\n    \"lang\": \"c\",\n    \"repos\": [\n      \"kernel\",\n      \"game\"\n    ]\n  },\n  {\n    \"lang\": \"rust\",\n    \"repos\": [\n      \"tool\"\n    ]\n  },\n  {\n    \"lang\": \"ts\",\n    \"repos\": [\n      \"site\"\n    ]\n  }\n]"
      }
    ]
  }
}
