{
  "title": "A shorter feed",
  "check": {
    "type": "command",
    "program": "jq",
    "compare": "json",
    "file": "data.json",
    "reference": "jq '.posts |= .[:2]' data.json",
    "tests": [
      {
        "input": {
          "user": "ada",
          "page": 1,
          "posts": [
            "Hello",
            "New job",
            "Trip photos",
            "Lunch"
          ]
        },
        "expected": "{\n  \"user\": \"ada\",\n  \"page\": 1,\n  \"posts\": [\n    \"Hello\",\n    \"New job\"\n  ]\n}"
      },
      {
        "input": {
          "user": "bo",
          "page": 3,
          "posts": [
            "Only one"
          ]
        },
        "expected": "{\n  \"user\": \"bo\",\n  \"page\": 3,\n  \"posts\": [\n    \"Only one\"\n  ]\n}"
      },
      {
        "input": {
          "user": "cy",
          "page": 2,
          "posts": [
            "a",
            "b",
            "c"
          ]
        },
        "expected": "{\n  \"user\": \"cy\",\n  \"page\": 2,\n  \"posts\": [\n    \"a\",\n    \"b\"\n  ]\n}"
      },
      {
        "input": {
          "user": "dee",
          "page": 9,
          "posts": []
        },
        "expected": "{\n  \"user\": \"dee\",\n  \"page\": 9,\n  \"posts\": []\n}"
      }
    ]
  }
}
