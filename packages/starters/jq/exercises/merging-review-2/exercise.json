{
  "title": "A flat account",
  "check": {
    "type": "command",
    "program": "jq",
    "compare": "json",
    "file": "data.json",
    "reference": "jq '{id} + .profile' data.json",
    "tests": [
      {
        "input": {
          "id": 9041,
          "plan": "pro",
          "profile": {
            "name": "Ada Berg",
            "email": "ada@example.com"
          }
        },
        "expected": "{\n  \"id\": 9041,\n  \"name\": \"Ada Berg\",\n  \"email\": \"ada@example.com\"\n}"
      },
      {
        "input": {
          "id": 17,
          "plan": "free",
          "profile": {
            "name": "Bo Lind"
          }
        },
        "expected": "{\n  \"id\": 17,\n  \"name\": \"Bo Lind\"\n}"
      },
      {
        "input": {
          "id": 520,
          "plan": "team",
          "profile": {
            "name": "Cy Moe",
            "email": "cy@example.com",
            "city": "Oslo"
          }
        },
        "expected": "{\n  \"id\": 520,\n  \"name\": \"Cy Moe\",\n  \"email\": \"cy@example.com\",\n  \"city\": \"Oslo\"\n}"
      }
    ]
  }
}
