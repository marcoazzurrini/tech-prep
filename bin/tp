#!/usr/bin/env bash
# tp: launch the tech-prep tmux session, or run engine CLI commands.
#   tp            start or attach the session (Neovim left, Claude tutor right)
#   tp app        open the desktop app instead of tmux
#   tp test FILE  run the tests for a solution file
#   tp next       show what is due
#   tp progress   show progress per concept
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
HOME_DIR="${TECHPREP_HOME:-$HOME/.tech-prep}"
WORKSPACE="$HOME_DIR/workspace"
SESSION="${TECHPREP_SESSION:-tech-prep-dojo}"

start() {
  mkdir -p "$WORKSPACE/.claude"
  # Let the tutor use the engine tools without a permission prompt each time.
  if [[ ! -f "$WORKSPACE/.claude/settings.json" ]]; then
    cat > "$WORKSPACE/.claude/settings.json" <<'JSON'
{
  "permissions": {
    "allow": ["mcp__plugin_tech-prep_engine"]
  }
}
JSON
  fi

  cp "$ROOT/content/welcome.md" "$WORKSPACE/WELCOME.md"
  # Lets the TypeScript language server understand solution files.
  [[ -f "$WORKSPACE/tsconfig.json" ]] || cat > "$WORKSPACE/tsconfig.json" <<'JSON'
{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "lib": ["ESNext"]
  }
}
JSON

  if ! tmux has-session -t "$SESSION" 2>/dev/null; then
    # The engine opens lessons and problems in this Neovim through the socket.
    rm -f "$HOME_DIR/nvim.sock"
    tmux new-session -d -s "$SESSION" -n dojo -c "$WORKSPACE" \
      "nvim --listen '$HOME_DIR/nvim.sock' -c 'luafile $ROOT/nvim/tech-prep.lua' WELCOME.md"
    tutor_pane=$(tmux split-window -h -P -F '#{pane_id}' -t "$SESSION:dojo" -c "$WORKSPACE" \
      "claude --plugin-dir '$ROOT' '/tech-prep:practice'")
    # `tp test` sends a one-line result to this pane so the tutor sees every test run.
    tmux set-option -t "$SESSION" @tutor_pane "$tutor_pane"
    tmux select-pane -t "$SESSION:dojo.0"
  fi

  if [[ -n "${TMUX:-}" ]]; then
    tmux switch-client -t "$SESSION"
  else
    tmux attach -t "$SESSION"
  fi
}

case "${1:-start}" in
  start) start ;;
  app)
    cd "$ROOT/app"
    [[ -d node_modules ]] || npm install
    npx electron-vite build >/dev/null
    exec npx electron .
    ;;
  *) exec bun "$ROOT/server/src/cli.ts" "$@" ;;
esac
